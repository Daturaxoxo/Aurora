import { Palette } from "global.slint";
import { IconButton, NavButton, Card } from "components/widgets.slint";
import { Sidebar } from "components/sidebar.slint";
import { UninstallWelcomePage } from "components/pages/uninstall-welcome.slint";
import { ProgressPage } from "components/pages/progress.slint";
import { UninstallFinishPage } from "components/pages/uninstall-finish.slint";

component StepPage inherits Rectangle {
    in property <bool> active;

    width: 100%;
    height: 100%;
    visible: root.opacity > 0.01;

    states [
        active-state when root.active: {
            opacity: 1.0;
            y: 0px;
            in {
                animate opacity {
                    duration: 200ms;
                    easing: ease-in-out;
                    delay: 5ms;
                }
                animate y {
                    duration: 200ms;
                    easing: ease-in-out;
                    delay: 5ms;
                }
            }
        }
        inactive-state when !root.active: {
            opacity: 0.0;
            y: 6px;
            in {
                animate opacity {
                    duration: 100ms;
                    easing: ease-in-out;
                }
                animate y {
                    duration: 100ms;
                    easing: ease-in-out;
                }
            }
        }
    ]

    @children
}

export component UninstallerWindow inherits Window {
    title: "Aurora Uninstaller";
    no-frame: true;
    background: transparent;
    resize-border-width: 6px;
    min-width: 850px;
    min-height: 580px;
    preferred-width: 850px;
    preferred-height: 580px;
    default-font-family: root.ui-font-family;

    in property <string> ui-font-family: "Segoe UI";

    callback maximize-clicked();
    callback minimize-clicked();
    callback close-clicked();
    callback window-dragged(length, length);

    // 0 = Welcome, 1 = Uninstallation, 2 = Finish
    in-out property <int> current-step: 0;
    callback next-clicked();
    callback cancel-clicked();
    callback browse-clicked();

    // Welcome Properties
    in property <string> app-path: "";
    in property <bool> app-found: false;
    in property <bool> app-shared: false;
    in property <string> app-error: "";
    in property <string> mods-path: "";
    in property <bool> mods-available: false;
    in-out property <bool> option-delete-config: true;
    in-out property <bool> option-delete-mods: false;
    in-out property <bool> option-preserve-mods: true;

    // Uninstallation Properties
    in property <float> uninstall-progress: 0.0;
    in property <[string]> uninstall-log: [];
    in property <int> uninstall-log-count: 0;
    in property <bool> uninstall-done: false;
    in property <bool> uninstall-success: false;
    in property <string> uninstall-error: "";

    // Finish Properties
    in property <string> backup-path: "";

    property <bool> confirm-visible: false;
    property <bool> next-enabled: root.current-step == 0 ? root.app-found
        : root.current-step != 1 || root.uninstall-done;
    property <string> next-label: root.current-step == 0 ? "Uninstall"
        : root.current-step == 2 ? "Finish"
        : "Next";

    Rectangle {
        width: 100%;
        height: 100%;
        background: #121216;

        VerticalLayout {
            padding: 0px;

            // Top Bar
            Rectangle {
                height: Palette.topbar-height;
                width: 100%;
                background: #17171b;
                drop-shadow-color: Palette.shadow-color;
                drop-shadow-blur: 15px;
                drop-shadow-offset-y: 4px;

                TouchArea {
                    width: 100%;
                    height: 100%;
                    moved => {
                        if (self.pressed) {
                            root.window-dragged(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
                        }
                    }
                }

                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;

                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: "Aurora Uninstaller";
                            color: Palette.text-secondary;
                            font-size: 16px;
                            font-weight: 700;
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                    }

                    VerticalLayout {
                        alignment: center;
                        HorizontalLayout {
                            spacing: 8px;

                            IconButton {
                                source: @image-url("../../../production/icons/minimize.png");
                                icon-size: 22px;
                                clicked => { root.minimize-clicked(); }
                            }

                            IconButton {
                                source: root.maximized
                                    ? @image-url("../../../production/icons/maximized.png")
                                    : @image-url("../../../production/icons/maximize.png");
                                icon-size: 22px;
                                clicked => { root.maximize-clicked(); }
                            }

                            IconButton {
                                source: @image-url("../../../production/icons/close.png");
                                icon-size: 22px;
                                clicked => { root.close-clicked(); }
                            }
                        }
                    }
                }
            }

            // Body
            HorizontalLayout {
                vertical-stretch: 1;

                Sidebar {
                    steps: ["Welcome", "Uninstallation", "Finish"];
                    current-step: root.current-step;
                    job-step: 1;
                    job-done: root.uninstall-done;
                    job-success: root.uninstall-success;
                }

                VerticalLayout {
                    horizontal-stretch: 1;

                    // Page Content
                    Rectangle {
                        vertical-stretch: 1;
                        clip: true;

                        StepPage {
                            active: root.current-step == 0;
                            UninstallWelcomePage {
                                x: 28px;
                                y: 28px;
                                width: parent.width - 56px;
                                app-path: root.app-path;
                                app-found: root.app-found;
                                app-shared: root.app-shared;
                                app-error: root.app-error;
                                mods-path: root.mods-path;
                                mods-available: root.mods-available;
                                option-delete-config <=> root.option-delete-config;
                                option-delete-mods <=> root.option-delete-mods;
                                option-preserve-mods <=> root.option-preserve-mods;
                                browse-clicked => { root.browse-clicked(); }
                            }
                        }

                        StepPage {
                            active: root.current-step == 1;
                            ProgressPage {
                                x: 28px;
                                y: 28px;
                                width: parent.width - 56px;
                                height: parent.height - 56px;
                                title: "Uninstallation";
                                subtitle: "Aurora is now being removed. This might take a few moments.";
                                progress: root.uninstall-progress;
                                log-lines: root.uninstall-log;
                                log-count: root.uninstall-log-count;
                            }
                        }

                        StepPage {
                            active: root.current-step == 2;
                            UninstallFinishPage {
                                x: 28px;
                                y: 28px;
                                width: parent.width - 56px;
                                uninstall-success: root.uninstall-success;
                                uninstall-error: root.uninstall-error;
                                backup-path: root.backup-path;
                            }
                        }
                    }

                    // Bottom Navigation Bar
                    Rectangle {
                        height: 64px;

                        Rectangle {
                            x: 0px;
                            y: 0px;
                            width: 100%;
                            height: 1px;
                            background: Palette.glass-border;
                        }

                        HorizontalLayout {
                            padding-left: 24px;
                            padding-right: 24px;
                            alignment: end;
                            spacing: 12px;

                            VerticalLayout {
                                alignment: center;
                                NavButton {
                                    text: "Cancel";
                                    enabled: root.current-step == 0;
                                    clicked => { root.cancel-clicked(); }
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                NavButton {
                                    text: root.next-label;
                                    primary: true;
                                    enabled: root.next-enabled;
                                    clicked => {
                                        if (root.current-step == 0) {
                                            root.confirm-visible = true;
                                        } else {
                                            root.next-clicked();
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // Confirmation Dialog
        if root.confirm-visible: Rectangle {
            width: 100%;
            height: 100%;
            background: #00000099;

            TouchArea {
                width: 100%;
                height: 100%;
            }

            VerticalLayout {
                alignment: center;

                HorizontalLayout {
                    alignment: center;

                    Card {
                        width: 420px;

                        VerticalLayout {
                            padding: 24px;
                            spacing: 10px;

                            Text {
                                text: "Are you sure you want to delete Aurora?";
                                font-size: 16px;
                                font-weight: 700;
                                color: Palette.text-primary;
                                wrap: word-wrap;
                            }

                            Text {
                                text: "Aurora and the selected data will be removed. Other files in the folder are kept. This cannot be undone.";
                                font-size: 13px;
                                color: Palette.text-secondary;
                                wrap: word-wrap;
                            }

                            Rectangle { height: 8px; }

                            HorizontalLayout {
                                alignment: end;
                                spacing: 12px;

                                NavButton {
                                    text: "Cancel";
                                    clicked => { root.confirm-visible = false; }
                                }

                                NavButton {
                                    text: "Uninstall";
                                    primary: true;
                                    clicked => {
                                        root.confirm-visible = false;
                                        root.next-clicked();
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // Outer border
        Rectangle {
            width: 100%;
            height: 100%;
            border-width: 1px;
            border-color: Palette.glass-border;
        }
    }
}
