import { Palette } from "../global.slint";

component StepRow inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    in property <bool> completed;

    height: 40px;
    border-radius: 8px;
    background: root.completed ? #ffffff0c : (root.active ? #ffffff05 : transparent);
    border-width: 1px;
    border-color: root.active ? #ffffff22 : transparent;

    animate background { duration: 120ms; }
    animate border-color { duration: 120ms; }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 14px;
        alignment: space-between;

        VerticalLayout {
            alignment: center;
            Text {
                text: root.label;
                color: root.active ? Palette.text-primary : Palette.text-secondary;
                font-size: 14px;
                font-weight: root.active ? 600 : 400;

                animate color { duration: 120ms; }
            }
        }

        if root.completed: VerticalLayout {
            alignment: center;
            Path {
                width: 14px;
                height: 12px;
                viewbox-x: 0;
                viewbox-y: 0;
                viewbox-width: 14;
                viewbox-height: 12;
                commands: "M1 6 L5 10 L13 1";
                stroke: Palette.accent;
                stroke-width: 2px;
                fill: transparent;
            }
        }
    }
}

export component Sidebar inherits Rectangle {
    in property <[string]> steps;
    in property <int> current-step;
    // Index of the step that runs the long job (installing / uninstalling).
    // That step and the final one only tick once the job actually succeeded.
    in property <int> job-step;
    in property <bool> job-done;
    in property <bool> job-success;

    width: 220px;
    background: #00000022;

    VerticalLayout {
        padding: 16px;
        padding-top: 28px;
        spacing: 4px;
        alignment: start;

        HorizontalLayout {
            alignment: center;
            Image {
                source: @image-url("../../../../production/icons/logo.png");
                width: 56px;
                height: 56px;
                image-rendering: smooth;
                image-fit: contain;
            }
        }

        Rectangle { height: 24px; }

        for step-label[i] in root.steps: StepRow {
            label: step-label;
            active: root.current-step == i;
            completed: (i == root.job-step || i == root.steps.length - 1)
                ? root.current-step >= i && root.job-done && root.job-success
                : root.current-step > i;
        }
    }

    // Right separator line
    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        height: 100%;
        background: Palette.glass-border;
    }
}
