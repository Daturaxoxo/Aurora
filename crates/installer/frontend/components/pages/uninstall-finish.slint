import { Palette } from "../../global.slint";
import { Card } from "../widgets.slint";

export component UninstallFinishPage inherits VerticalLayout {
    in property <bool> uninstall-success;
    in property <string> uninstall-error;
    in property <string> backup-path;

    spacing: 8px;
    alignment: start;

    Text {
        text: "Finished";
        font-size: 24px;
        font-weight: 700;
        color: Palette.text-primary;
    }

    Text {
        text: root.uninstall-success
            ? "Aurora was removed from your system."
            : "Aurora could not be fully removed.";
        font-size: 13px;
        color: Palette.text-secondary;
        wrap: word-wrap;
    }

    if !root.uninstall-success && root.uninstall-error != "": Text {
        text: root.uninstall-error;
        font-size: 12px;
        color: #ff6b6b;
        wrap: word-wrap;
    }

    Rectangle { height: 8px; }

    if root.backup-path != "": Card {
        VerticalLayout {
            padding: 20px;
            spacing: 6px;

            Text {
                text: "Your mods were saved to:";
                font-size: 13px;
                color: Palette.text-secondary;
                wrap: word-wrap;
            }

            Text {
                text: root.backup-path;
                font-size: 13px;
                color: Palette.text-primary;
                wrap: word-wrap;
            }
        }
    }
}
