import { Palette } from "../../global.slint";
import { Card, NavButton } from "../widgets.slint";

export component LocationPage inherits VerticalLayout {
    in-out property <string> install-path;
    in property <string> space-required;
    in property <string> space-available;

    callback browse-clicked();
    callback reset-clicked();
    callback path-edited(string);

    spacing: 8px;
    alignment: start;

    Text {
        text: "Location";
        font-size: 24px;
        font-weight: 700;
        color: Palette.text-primary;
    }

    Text {
        text: "Choose where Aurora will be installed on your system.";
        font-size: 13px;
        color: Palette.text-secondary;
        wrap: word-wrap;
    }

    Rectangle { height: 8px; }

    Card {
        VerticalLayout {
            padding: 20px;
            spacing: 12px;

            Text {
                text: "Installation Folder";
                font-size: 14px;
                font-weight: 600;
                color: Palette.text-primary;
            }

            Text {
                text: "Aurora and its components will be installed into the folder below. Type a path directly or use Browse to pick a folder.";
                font-size: 12px;
                color: Palette.text-secondary;
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: 10px;

                Rectangle {
                    height: 36px;
                    horizontal-stretch: 1;
                    background: #0d0d11cc;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: path-input.has-focus ? #ffffff55 : Palette.glass-border;
                    clip: true;

                    animate border-color { duration: 120ms; }

                    path-input := TextInput {
                        x: 12px;
                        width: parent.width - 24px;
                        height: 100%;
                        vertical-alignment: center;
                        text <=> root.install-path;
                        color: Palette.text-primary;
                        font-size: 13px;
                        single-line: true;
                        wrap: no-wrap;
                        edited => { root.path-edited(self.text); }
                    }
                }

                NavButton {
                    text: "Browse...";
                    width: 96px;
                    clicked => { root.browse-clicked(); }
                }
            }

            HorizontalLayout {
                alignment: space-between;

                VerticalLayout {
                    alignment: center;
                    Text {
                        text: root.space-required + " required, " + root.space-available + " available";
                        font-size: 12px;
                        color: Palette.text-secondary;
                    }
                }

                NavButton {
                    text: "Reset to Default";
                    width: 130px;
                    clicked => { root.reset-clicked(); }
                }
            }
        }
    }
}
