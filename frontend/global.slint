// GLOBAL THEME PALETTE
export global Palette {
    in-out property <color> background-top: #111115dd;
    in-out property <color> background-bottom: #16161add;
    in-out property <color> border-top: #ffffff25;
    in-out property <color> border-bottom: #ffffff0c;
    in-out property <color> shadow-color: #000000aa;
    in-out property <color> text-primary: #ffffff;
    in-out property <color> text-secondary: #aaaaaa;
    in-out property <color> surface: #1e1e24;
    in-out property <color> accent: #6db3f2;
    in-out property <color> accent-strong: #3b82f6;
    in-out property <color> danger: #ee4937;
    in-out property <color> warning: #e8a020;
    in-out property <color> success: #22c55e;
    in-out property <color> favorite: #ffd75e;
    in-out property <color> scrim-top: #00000044;
    in-out property <color> scrim-bottom: #00000088;
    in-out property <color> backdrop: #0d0d11;
    in-out property <image> background-image: @image-url("../production/assets/backgrounds/background.jpg");
    in-out property <length> topbar-height: 50px;
    out property <brush> glass-background: @linear-gradient(180deg, root.background-top 0%, root.background-bottom 100%);
    out property <brush> glass-border: @linear-gradient(135deg, root.border-top 0%, root.border-bottom 100%);
    out property <brush> card-background: @linear-gradient(180deg, root.background-top.with-alpha(0.93) 0%, root.background-bottom.with-alpha(0.92) 100%);
    out property <brush> panel-background: @linear-gradient(180deg, root.background-top.with-alpha(0.97) 0%, root.background-bottom.with-alpha(0.96) 100%);
    out property <color> surface-raised: root.surface.brighter(1.5);
    out property <color> surface-sunken: root.surface.darker(0.5);
    out property <color> accent-bright: root.accent.mix(#ffffff, 0.66);
    out property <color> accent-pale: root.accent.mix(#ffffff, 0.35);
    out property <color> warning-bright: root.warning.mix(#ffffff, 0.72);
    out property <color> warning-pale: root.warning.mix(#ffffff, 0.45);
    out property <color> success-bright: root.success.mix(#ffffff, 0.72);
    out property <color> fg-02: root.text-primary.with-alpha(0.008);
    out property <color> fg-04: root.text-primary.with-alpha(0.016);
    out property <color> fg-05: root.text-primary.with-alpha(0.020);
    out property <color> fg-06: root.text-primary.with-alpha(0.024);
    out property <color> fg-08: root.text-primary.with-alpha(0.031);
    out property <color> fg-09: root.text-primary.with-alpha(0.035);
    out property <color> fg-0a: root.text-primary.with-alpha(0.039);
    out property <color> fg-0c: root.text-primary.with-alpha(0.047);
    out property <color> fg-0d: root.text-primary.with-alpha(0.051);
    out property <color> fg-0e: root.text-primary.with-alpha(0.055);
    out property <color> fg-10: root.text-primary.with-alpha(0.063);
    out property <color> fg-12: root.text-primary.with-alpha(0.071);
    out property <color> fg-14: root.text-primary.with-alpha(0.078);
    out property <color> fg-16: root.text-primary.with-alpha(0.086);
    out property <color> fg-18: root.text-primary.with-alpha(0.094);
    out property <color> fg-1a: root.text-primary.with-alpha(0.102);
    out property <color> fg-1b: root.text-primary.with-alpha(0.106);
    out property <color> fg-1c: root.text-primary.with-alpha(0.110);
    out property <color> fg-1e: root.text-primary.with-alpha(0.118);
    out property <color> fg-20: root.text-primary.with-alpha(0.125);
    out property <color> fg-22: root.text-primary.with-alpha(0.133);
    out property <color> fg-24: root.text-primary.with-alpha(0.141);
    out property <color> fg-25: root.text-primary.with-alpha(0.145);
    out property <color> fg-28: root.text-primary.with-alpha(0.157);
    out property <color> fg-2a: root.text-primary.with-alpha(0.165);
    out property <color> fg-30: root.text-primary.with-alpha(0.188);
    out property <color> fg-33: root.text-primary.with-alpha(0.200);
    out property <color> fg-38: root.text-primary.with-alpha(0.220);
    out property <color> fg-44: root.text-primary.with-alpha(0.267);
    out property <color> fg-55: root.text-primary.with-alpha(0.333);
    out property <color> fg-60: root.text-primary.with-alpha(0.376);
    out property <color> fg-66: root.text-primary.with-alpha(0.400);
    out property <color> fg-77: root.text-primary.with-alpha(0.467);
    out property <color> fg-7a: root.text-primary.with-alpha(0.478);
    out property <color> fg-88: root.text-primary.with-alpha(0.533);
    out property <color> fg-aa: root.text-primary.with-alpha(0.667);
    out property <color> fg-bb: root.text-primary.with-alpha(0.733);
    out property <color> fg-cc: root.text-primary.with-alpha(0.800);
    out property <color> fg-dd: root.text-primary.with-alpha(0.867);
    out property <color> fg-ee: root.text-primary.with-alpha(0.933);
    out property <color> shade-33: root.shadow-color.with-alpha(0.200);
    out property <color> shade-40: root.shadow-color.with-alpha(0.251);
    out property <color> shade-44: root.shadow-color.with-alpha(0.267);
    out property <color> shade-60: root.shadow-color.with-alpha(0.376);
    out property <color> shade-66: root.shadow-color.with-alpha(0.400);
    out property <color> shade-88: root.shadow-color.with-alpha(0.533);
    out property <color> shade-99: root.shadow-color.with-alpha(0.600);
    out property <color> shade-aa: root.shadow-color.with-alpha(0.667);
    out property <color> shade-d8: root.shadow-color.with-alpha(0.847);
    out property <color> shade-dd: root.shadow-color.with-alpha(0.867);
    out property <color> shade-e6: root.shadow-color.with-alpha(0.902);
    out property <color> shade-ff: root.shadow-color.with-alpha(1.0);
}
