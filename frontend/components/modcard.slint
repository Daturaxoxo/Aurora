import { Palette } from "../global.slint";
import { Tr, TrKey } from "../translations.slint";
import { ScrollingTextInput } from "textfield.slint";

export enum ModTag {
    none,
    local,
    update-available,
    up-to-date,
}

export struct ModItem {
    id: string,
    name: string,
    author: string,
    version: string,
    icon: image,
    notes: string,
    enabled: bool,
    selected: bool,
    has-json: bool,
    is-editing: bool,
    group-id: string,
    support-link: string,
    is-group-header: bool,
    collapsed: bool,
    restart-required: bool,
    tag: ModTag,
}

component RestartPill inherits Rectangle {
    in property <bool> compact: false;

    height: root.compact ? 20px : 24px;
    width: pill-text.preferred-width + (root.compact ? 16px : 22px);
    border-radius: 7px;
    border-width: 1px;
    border-color: #f0b46d;
    background: root.compact ? #1e1e24ee : #f0b46d1c;

    pill-text := Text {
        text: Tr.values[TrKey.modmanager-restart-required];
        color: #ffdcae;
        font-size: root.compact ? 10px : 11.5px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
}

component TagPill inherits Rectangle {
    in property <ModTag> tag: ModTag.none;
    in property <bool> compact: false;

    property <color> accent: root.tag == ModTag.update-available
        ? #e8a020
        : root.tag == ModTag.up-to-date ? #25d952 : #9a9aa4;

    height: root.compact ? 20px : 16px;
    width: tag-text.preferred-width + (root.compact ? 16px : 12px);
    border-radius: root.compact ? 7px : 4px;
    border-width: 1px;
    border-color: root.accent.transparentize(0.7);
    background: root.compact ? #1e1e24ee : root.accent.transparentize(0.88);

    tag-text := Text {
        text: root.tag == ModTag.local
            ? Tr.values[TrKey.modmanager-tag-local]
            : root.tag == ModTag.update-available
            ? Tr.values[TrKey.modmanager-tag-update-available]
            : Tr.values[TrKey.modmanager-tag-up-to-date];
        color: root.accent;
        font-size: root.compact ? 10px : 9.5px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
}

export component ToggleSwitch inherits Rectangle {
    in-out property <bool> checked;
    callback toggled();

    width: 44px;
    height: 24px;
    border-radius: 12px;
    background: root.checked ? #10b981 : #3f3f46;

    animate background { duration: 150ms; }

    Rectangle {
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: #ffffff;
        x: root.checked ? parent.width - self.width - 4px : 4px;

        animate x {
            duration: 150ms;
            easing: ease-out;
        }
    }

    TouchArea {
        clicked => {
            root.checked = !root.checked;
            root.toggled();
        }
    }
}

export component ModCard inherits Rectangle {
    in property <ModItem> item;
    in property <bool> grid-mode: false;
    in property <bool> drop-target: false;
    in property <bool> show-icon: true;

    callback toggle-select(string /* id */);
    callback rename(string /* id */, string /* new name */);
    callback set-notes(string /* id */, string /* notes */);
    callback request-delete(string /* id */, string /* name */);
    callback toggle-enabled(string /* id */);
    callback update(string /* id */);
    callback open-link(string /* id */);
    callback drag-started(string /* id */, string /* name */);
    callback drag-moved(length /* x */, length /* y */);
    callback drag-ended(length /* x */, length /* y */);

    out property <bool> dragging: false;

    property <bool> has-icon: root.item.icon.width > 0;
    property <bool> editing-title: false;
    property <bool> editing-notes: false;
    property <string> title-draft;
    property <string> notes-draft;

    function commit-title() {
        if (root.editing-title) {
            root.rename(root.item.id, root.title-draft);
            root.editing-title = false;
        }
    }

    function commit-notes() {
        if (root.editing-notes) {
            root.set-notes(root.item.id, root.notes-draft);
            root.editing-notes = false;
        }
    }

    height: 64px;
    border-radius: 10px;
    border-width: 1px;
    border-color: root.drop-target
        ? #6db3f2
        : root.item.selected
        ? #6db3f266
        : (hover-ta.has-hover ? #ffffff22 : #ffffff10);
    background: root.drop-target
        ? #6db3f214
        : root.item.selected
        ? #6db3f214
        : (hover-ta.has-hover ? #ffffff0a : #ffffff06);
    opacity: root.dragging ? 0.4 : 1.0;
    clip: true;
    animate background { duration: 120ms; }
    animate border-color { duration: 120ms; }
    animate opacity { duration: 120ms; }

    restart-measure := Text {
        visible: false;
        text: Tr.values[TrKey.modmanager-restart-required];
        font-size: 11.5px;
    }

    hover-ta := TouchArea {
        moved => {
            if (!root.dragging
                && self.pressed
                && (Math.abs((self.mouse-x - self.pressed-x) / 1px) > 6
                || Math.abs((self.mouse-y - self.pressed-y) / 1px) > 6)) {
                root.dragging = true;
                root.drag-started(root.item.id, root.item.name);
            }
            if (root.dragging) {
                root.drag-moved(
                    self.absolute-position.x + self.mouse-x,
                    self.absolute-position.y + self.mouse-y);
            }
        }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.up && root.dragging) {
                root.dragging = false;
                root.drag-ended(
                    self.absolute-position.x + self.mouse-x,
                    self.absolute-position.y + self.mouse-y);
            }
        }
    }

    if !root.grid-mode: HorizontalLayout {
        padding-left: 14px;
        padding-right: 16px;
        spacing: 12px;

        VerticalLayout {
            alignment: center;
            select-box := Rectangle {
                width: 18px;
                height: 18px;
                border-radius: 4px;
                border-width: 1px;
                border-color: root.item.selected
                    ? #6db3f2
                    : (select-ta.has-hover ? #ffffff66 : #ffffff33);
                background: root.item.selected ? #6db3f2 : transparent;
                animate background { duration: 120ms; }
                animate border-color { duration: 120ms; }

                if root.item.selected: Path {
                    x: 2.5px;
                    y: 3.5px;
                    width: 13px;
                    height: 11px;
                    viewbox-x: 0;
                    viewbox-y: 0;
                    viewbox-width: 12;
                    viewbox-height: 10;
                    commands: "M1 5 L4 8 L11 1";
                    stroke: #111111;
                    stroke-width: 1.8px;
                    fill: transparent;
                }

                select-ta := TouchArea {
                    clicked => { root.toggle-select(root.item.id); }
                }
            }
        }

        if root.show-icon: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 40px;
                height: 40px;
                border-radius: 8px;
                background: #00000044;
                clip: true;

                Image {
                    width: 100%;
                    height: 100%;
                    source: root.has-icon
                        ? root.item.icon
                        : @image-url("../../production/assets/characters/default.png");
                    image-fit: contain;
                    image-rendering: smooth;
                }
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 3px;
            horizontal-stretch: 0;
            max-width: max(80px, root.width - (root.show-icon ? 218px : 166px)
                - (root.item.restart-required ? restart-measure.preferred-width + 34px : 0px)
                - (root.item.tag == ModTag.update-available ? 34px : 0px));

            HorizontalLayout {
                height: 18px;
                spacing: 8px;
                alignment: start;

                if !root.editing-title: Text {
                    text: root.item.name;
                    color: Palette.text-primary;
                    font-size: 14px;
                    font-weight: 700;
                    min-width: 0px;
                    overflow: elide;
                    vertical-alignment: center;
                }

                if root.editing-title: Rectangle {
                    property <length> desired-width: min(420px, max(200px, title-measure.preferred-width + 16px));

                    preferred-width: self.desired-width;
                    max-width: self.desired-width;
                    min-width: 0px;
                    border-radius: 4px;
                    background: #ffffff10;
                    border-width: 1px;
                    border-color: #ffffff33;

                    title-measure := Text {
                        visible: false;
                        text: root.title-draft;
                        font-size: 13px;
                    }

                    ScrollingTextInput {
                        width: 100%;
                        height: 100%;
                        font-size: 13px;
                        init => {
                            self.text = root.item.name;
                            root.title-draft = root.item.name;
                            self.focus-input();
                        }
                        edited(text) => { root.title-draft = text; }
                        accepted(text) => { root.commit-title(); }
                        focus-changed(focused) => {
                            if (!focused) { root.commit-title(); }
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    rename-btn := Rectangle {
                        width: 18px;
                        height: 18px;
                        border-radius: 4px;
                        background: rename-ta.has-hover ? #ffffff16 : transparent;
                        animate background { duration: 100ms; }

                        Image {
                            source: @image-url("../../production/icons/edit.png");
                            width: 11px;
                            height: 11px;
                            image-rendering: smooth;
                            image-fit: contain;
                            colorize: rename-ta.has-hover ? #ffffffdd : #ffffff66;
                            animate colorize { duration: 100ms; }
                        }

                        rename-ta := TouchArea {
                            clicked => {
                                if (root.editing-title) {
                                    root.commit-title();
                                } else {
                                    root.editing-title = true;
                                }
                            }
                        }
                    }
                }

                if root.item.author != "": author-wrap := Rectangle {
                    preferred-width: author-text.preferred-width;
                    max-width: author-text.preferred-width;
                    min-width: 0px;
                    property <bool> is-link: root.item.support-link != "";

                    author-text := Text {
                        width: parent.width;
                        overflow: elide;
                        text: Tr.values[TrKey.global-label-by] + " " + root.item.author;
                        color: author-wrap.is-link
                            ? (link-ta.has-hover ? #9ecfff : #6db3f2)
                            : Palette.text-secondary;
                        font-size: 11px;
                        font-weight: 500;
                        vertical-alignment: center;
                        animate color { duration: 100ms; }
                    }

                    if author-wrap.is-link && link-ta.has-hover: Rectangle {
                        y: parent.height - 3px;
                        width: parent.width;
                        height: 1px;
                        background: #9ecfff;
                    }

                    link-ta := TouchArea {
                        enabled: author-wrap.is-link;
                        mouse-cursor: pointer;
                        clicked => { root.open-link(root.item.id); }
                    }
                }

                if root.item.version != "": Rectangle {
                    width: version-text.preferred-width + 12px;
                    height: 16px;
                    border-radius: 4px;
                    background: #ffffff10;
                    border-width: 1px;
                    border-color: #ffffff1c;

                    version-text := Text {
                        x: 6px;
                        y: (parent.height - self.preferred-height) / 2;
                        text: root.item.version;
                        color: Palette.text-secondary;
                        font-size: 9.5px;
                        font-weight: 600;
                    }
                }

                if root.item.tag != ModTag.none: TagPill {
                    tag: root.item.tag;
                }
            }

            HorizontalLayout {
                height: 16px;
                alignment: start;

                if !root.editing-notes: Rectangle {
                    preferred-width: notes-text.preferred-width;
                    max-width: notes-text.preferred-width;
                    min-width: 0px;

                    notes-text := Text {
                        width: parent.width;
                        overflow: elide;
                        text: root.item.notes == "" ? Tr.values[TrKey.modcard-notes-placeholder] : root.item.notes;
                        color: notes-ta.has-hover
                            ? #ffffffaa
                            : (root.item.notes == "" ? #ffffff44 : #ffffff77);
                        font-size: 11.5px;
                        font-italic: root.item.notes == "";
                        vertical-alignment: center;
                        animate color { duration: 100ms; }
                    }

                    notes-ta := TouchArea {
                        clicked => { root.editing-notes = true; }
                    }
                }

                if root.editing-notes: Rectangle {
                    property <length> desired-width: min(420px, max(260px, notes-measure.preferred-width + 16px));

                    preferred-width: self.desired-width;
                    max-width: self.desired-width;
                    min-width: 0px;
                    border-radius: 4px;
                    background: #ffffff10;
                    border-width: 1px;
                    border-color: #ffffff33;

                    notes-measure := Text {
                        visible: false;
                        text: root.notes-draft;
                        font-size: 11.5px;
                    }

                    ScrollingTextInput {
                        width: 100%;
                        height: 100%;
                        font-size: 11.5px;
                        init => {
                            self.text = root.item.notes;
                            root.notes-draft = root.item.notes;
                            self.focus-input();
                        }
                        edited(text) => { root.notes-draft = text; }
                        accepted(text) => { root.commit-notes(); }
                        focus-changed(focused) => {
                            if (!focused) { root.commit-notes(); }
                        }
                    }
                }
            }
        }

        Rectangle {
            horizontal-stretch: 1;
        }

        if root.item.restart-required: VerticalLayout {
            alignment: center;
            RestartPill { }
        }

        VerticalLayout {
            alignment: center;
            delete-btn := Rectangle {
                width: 28px;
                height: 28px;
                border-radius: 6px;
                background: delete-ta.has-hover ? #ee493722 : transparent;
                animate background { duration: 100ms; }

                Image {
                    source: @image-url("../../production/icons/delete.png");
                    width: 15px;
                    height: 15px;
                    image-rendering: smooth;
                    image-fit: contain;
                    colorize: delete-ta.has-hover ? #ee4937 : #ffffff66;
                    animate colorize { duration: 100ms; }
                }

                delete-ta := TouchArea {
                    clicked => { root.request-delete(root.item.id, root.item.name); }
                }
            }
        }

        if root.item.tag == ModTag.update-available: VerticalLayout {
            alignment: center;
            update-btn := Rectangle {
                width: 28px;
                height: 28px;
                border-radius: 6px;
                background: update-ta.has-hover ? #e8a02022 : transparent;
                animate background { duration: 100ms; }

                Image {
                    source: @image-url("../../production/icons/download.png");
                    width: 15px;
                    height: 15px;
                    image-rendering: smooth;
                    image-fit: contain;
                    colorize: update-ta.has-hover ? #f5bd52 : #e8a020;
                    animate colorize { duration: 100ms; }
                }

                update-ta := TouchArea {
                    clicked => { root.update(root.item.id); }
                }
            }
        }

        VerticalLayout {
            alignment: center;
            ToggleSwitch {
                checked: root.item.enabled;
                toggled => { root.toggle-enabled(root.item.id); }
            }
        }
    }

    if root.grid-mode: grid-root := VerticalLayout {
        padding: 8px;
        spacing: 6px;

        property <bool> tile-hovered: hover-ta.has-hover || grid-select-ta.has-hover
            || grid-delete-ta.has-hover || grid-link-ta.has-hover
            || grid-rename-ta.has-hover;

        icon-frame := Rectangle {
            vertical-stretch: 1;
            border-radius: 8px;
            background: #00000044;
            clip: true;

            Image {
                width: 100%;
                height: 100%;
                source: root.has-icon
                    ? root.item.icon
                    : @image-url("../../production/assets/characters/default.png");
                image-fit: contain;
                image-rendering: smooth;
            }

            grid-select-box := Rectangle {
                x: 6px;
                y: 6px;
                width: 20px;
                height: 20px;
                border-radius: 4px;
                border-width: 1px;
                border-color: root.item.selected
                    ? #6db3f2
                    : (grid-select-ta.has-hover ? #ffffff88 : #ffffff55);
                background: root.item.selected ? #6db3f2 : #00000066;
                animate background { duration: 120ms; }
                animate border-color { duration: 120ms; }

                if root.item.selected: Path {
                    x: 3.5px;
                    y: 4.5px;
                    width: 13px;
                    height: 11px;
                    viewbox-x: 0;
                    viewbox-y: 0;
                    viewbox-width: 12;
                    viewbox-height: 10;
                    commands: "M1 5 L4 8 L11 1";
                    stroke: #111111;
                    stroke-width: 1.8px;
                    fill: transparent;
                }

                grid-select-ta := TouchArea {
                    clicked => { root.toggle-select(root.item.id); }
                }
            }

            grid-delete-btn := Rectangle {
                x: parent.width - self.width - 6px;
                y: 6px;
                width: 24px;
                height: 24px;
                border-radius: 6px;
                opacity: grid-root.tile-hovered ? 1 : 0;
                background: grid-delete-ta.has-hover ? #ee493733 : #00000066;
                animate opacity { duration: 120ms; }
                animate background { duration: 100ms; }

                Image {
                    source: @image-url("../../production/icons/delete.png");
                    width: 13px;
                    height: 13px;
                    image-rendering: smooth;
                    image-fit: contain;
                    colorize: grid-delete-ta.has-hover ? #ee4937 : #ffffffaa;
                    animate colorize { duration: 100ms; }
                }

                grid-delete-ta := TouchArea {
                    clicked => { root.request-delete(root.item.id, root.item.name); }
                }
            }

            if root.item.restart-required: RestartPill {
                compact: true;
                x: max(6px, grid-delete-btn.x - self.width - 6px);
                y: 8px;
            }

            if root.item.tag != ModTag.none: TagPill {
                compact: true;
                tag: root.item.tag;
                x: 32px;
                y: 6px;
            }
        }

        HorizontalLayout {
            height: 17px;
            spacing: 4px;

            if !root.editing-title: Text {
                horizontal-stretch: 1;
                min-width: 0px;
                text: root.item.name;
                color: Palette.text-primary;
                font-size: 12.5px;
                font-weight: 700;
                overflow: elide;
                vertical-alignment: center;
            }

            if root.editing-title: Rectangle {
                horizontal-stretch: 1;
                min-width: 0px;
                border-radius: 4px;
                background: #ffffff10;
                border-width: 1px;
                border-color: #ffffff33;

                ScrollingTextInput {
                    width: 100%;
                    height: 100%;
                    font-size: 12px;
                    init => {
                        self.text = root.item.name;
                        root.title-draft = root.item.name;
                        self.focus-input();
                    }
                    edited(text) => { root.title-draft = text; }
                    accepted(text) => { root.commit-title(); }
                    focus-changed(focused) => {
                        if (!focused) { root.commit-title(); }
                    }
                }
            }

            grid-rename-btn := Rectangle {
                width: 17px;
                height: 17px;
                border-radius: 4px;
                opacity: (grid-root.tile-hovered || root.editing-title) ? 1 : 0;
                background: grid-rename-ta.has-hover ? #ffffff16 : transparent;
                animate opacity { duration: 120ms; }
                animate background { duration: 100ms; }

                Image {
                    source: @image-url("../../production/icons/edit.png");
                    width: 10px;
                    height: 10px;
                    image-rendering: smooth;
                    image-fit: contain;
                    colorize: grid-rename-ta.has-hover ? #ffffffdd : #ffffff66;
                    animate colorize { duration: 100ms; }
                }

                grid-rename-ta := TouchArea {
                    clicked => {
                        if (root.editing-title) {
                            root.commit-title();
                        } else {
                            root.editing-title = true;
                        }
                    }
                }
            }
        }

        HorizontalLayout {
            height: 24px;
            spacing: 6px;

            grid-author-wrap := Rectangle {
                horizontal-stretch: 1;
                clip: true;
                property <bool> is-link: root.item.support-link != "";

                grid-author-text := Text {
                    x: 0px;
                    width: parent.width;
                    height: parent.height;
                    text: root.item.author == "" ? "" : Tr.values[TrKey.global-label-by] + " " + root.item.author;
                    color: grid-author-wrap.is-link
                        ? (grid-link-ta.has-hover ? #9ecfff : #6db3f2)
                        : Palette.text-secondary;
                    font-size: 10.5px;
                    font-weight: 500;
                    overflow: elide;
                    vertical-alignment: center;
                    animate color { duration: 100ms; }
                }

                grid-link-ta := TouchArea {
                    enabled: grid-author-wrap.is-link && root.item.author != "";
                    mouse-cursor: pointer;
                    clicked => { root.open-link(root.item.id); }
                }
            }

            if root.item.tag == ModTag.update-available: VerticalLayout {
                alignment: center;
                grid-update-btn := Rectangle {
                    width: 24px;
                    height: 24px;
                    border-radius: 6px;
                    background: grid-update-ta.has-hover ? #e8a02022 : transparent;
                    animate background { duration: 100ms; }

                    Image {
                        source: @image-url("../../production/icons/download.png");
                        width: 14px;
                        height: 14px;
                        image-rendering: smooth;
                        image-fit: contain;
                        colorize: grid-update-ta.has-hover ? #f5bd52 : #e8a020;
                        animate colorize { duration: 100ms; }
                    }

                    grid-update-ta := TouchArea {
                        clicked => { root.update(root.item.id); }
                    }
                }
            }

            VerticalLayout {
                alignment: center;
                ToggleSwitch {
                    checked: root.item.enabled;
                    toggled => { root.toggle-enabled(root.item.id); }
                }
            }
        }
    }
}
