import { Icons } from "../../icons.slint";
import { Palette } from "../../global.slint";
import { ScrollView } from "std-widgets.slint";
import { Tr, TrKey } from "../../translations.slint";

export struct GameChoice {
    id: string,
    name: string,
    image: image,
    selected: bool,
    disabled: bool,
}

component GameTile inherits Rectangle {
    in property <GameChoice> game;
    in property <bool> busy: false;
    callback clicked(string);

    private property <bool> blocked: root.game.disabled || root.busy;

    border-radius: 12px;
    clip: true;
    background: Palette.fg-08;
    border-width: root.game.selected ? 2px : 1px;
    border-color: root.game.selected
        ? Palette.accent
        : (!root.blocked && ta.has-hover ? Palette.fg-28 : Palette.glass-border);
    animate border-color { duration: 120ms; }

    Image {
        width: 100%;
        height: 100%;
        source: root.game.image;
        image-fit: cover;
        opacity: root.game.disabled ? 0.35 : (ta.has-hover || root.game.selected ? 1.0 : 0.85);
        animate opacity { duration: 120ms; }
    }

    Rectangle {
        width: 100%;
        height: 100%;
        background: @linear-gradient(180deg, #00000000 45%, #000000cc 100%);
    }

    VerticalLayout {
        alignment: end;
        padding: 14px;
        spacing: 2px;

        Text {
            text: root.game.name;
            color: #ffffff;
            font-size: 15px;
            font-weight: 700;
            overflow: elide;
        }

        if root.game.selected || root.game.disabled: Text {
            text: root.game.disabled
                ? Tr.values[TrKey.games-coming-soon]
                : Tr.values[TrKey.games-current];
            color: root.game.disabled ? #ffffffaa : Palette.accent-pale;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 0.5px;
        }
    }

    ta := TouchArea {
        enabled: !root.blocked;
        mouse-cursor: root.blocked ? MouseCursor.default : MouseCursor.pointer;
        clicked => { root.clicked(root.game.id); }
    }
}

export component GamesPage inherits Rectangle {
    in property <[GameChoice]> games;
    in property <bool> busy: false;
    callback close-games();
    callback game-selected(string);

    background: Palette.panel-background;
    border-radius: 16px;
    border-width: 1px;
    border-color: Palette.glass-border;
    drop-shadow-color: Palette.shadow-color;
    drop-shadow-blur: 25px;
    drop-shadow-offset-y: 10px;

    TouchArea {}

    VerticalLayout {
        padding: 24px;
        spacing: 20px;

        // Header
        HorizontalLayout {
            alignment: space-between;

            VerticalLayout {
                alignment: center;
                Text {
                    text: Tr.values[TrKey.games-title];
                    color: Palette.text-primary;
                    font-size: 17px;
                    font-weight: 700;
                }
            }

            Rectangle {
                width: 30px;
                height: 30px;
                border-radius: 6px;
                background: close-ta.has-hover ? Palette.fg-16 : transparent;
                animate background { duration: 120ms; }

                Image {
                    source: Icons.close;
                    width: 18px;
                    height: 18px;
                    image-rendering: smooth;
                    image-fit: contain;
                    opacity: close-ta.has-hover ? 1.0 : 0.6;
                    animate opacity { duration: 120ms; }
                }

                close-ta := TouchArea {
                    clicked => { root.close-games(); }
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Palette.glass-border;
        }

        ScrollView {
            content-height: grid.min-height;
            grid := VerticalLayout {
                spacing: 12px;
                alignment: start;
                for row in ceil(root.games.length / 2): HorizontalLayout {
                    spacing: 12px;
                    height: (grid.width - self.spacing) / 2 * 9 / 16;

                    GameTile {
                        min-width: 0px;
                        preferred-width: 0px;
                        horizontal-stretch: 1;
                        game: root.games[row * 2];
                        busy: root.busy;
                        clicked(id) => { root.game-selected(id); }
                    }

                    if row * 2 + 1 < root.games.length: GameTile {
                        min-width: 0px;
                        preferred-width: 0px;
                        horizontal-stretch: 1;
                        game: root.games[row * 2 + 1];
                        busy: root.busy;
                        clicked(id) => { root.game-selected(id); }
                    }

                    if row * 2 + 1 >= root.games.length: Rectangle {
                        min-width: 0px;
                        preferred-width: 0px;
                        horizontal-stretch: 1;
                    }
                }
            }
        }
    }
}
