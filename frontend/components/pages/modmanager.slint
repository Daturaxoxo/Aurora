import { Palette } from "../../global.slint";
import { LineEdit, ScrollView } from "std-widgets.slint";
import { ModCard, ModItem, ToggleSwitch } from "../modcard.slint";
import { PopupDialog } from "../popup.slint";
import { ChipButton } from "../chipbutton.slint";
import { ScrollingTextInput } from "../textfield.slint";
import { Tr, TrKey } from "../../translations.slint";

export struct GroupOption {
    id: string,
    name: string,
}

// One row of the filter panel: a character, an author or a group
export struct FilterOption {
    id: string,
    name: string,
    icon: image,
    // How many installed mods this row would match
    count: int,
    selected: bool,
}

// Everything the filter panel holds that isn't a multi selection
export struct ModFilters {
    // 0 = all, 1 = enabled only, 2 = disabled only
    status: int,
    // "" = any group, "\u{1}ungrouped" = mods outside every group
    group-id: string,
}

export {
    ModItem,
}
component GroupHeader inherits Rectangle {
    in property <ModItem> item;
    in property <bool> drop-target: false;
    in property <string> auto-edit-id: "";

    callback collapse(string /* id */);
    callback rename(string /* id */, string /* new name */);
    callback request-delete(string /* id */);
    callback toggle-enabled(string /* id */);
    callback toggle-select(string /* id */);
    callback auto-edit-consumed();
    callback auto-edit-opened();

    // Editing opened by the rename button
    property <bool> editing-name: false;
    // Editing opened by this group having just been created
    property <bool> auto-editing: root.auto-edit-id != "" && root.auto-edit-id == root.item.id;
    property <bool> editing: root.editing-name || root.auto-editing;
    property <string> name-draft;
    property <bool> hovered: header-ta.has-hover || rename-ta.has-hover
        || delete-ta.has-hover || select-ta.has-hover;

    function commit-name() {
        if (root.editing) {
            root.rename(root.item.id, root.name-draft);
            root.editing-name = false;
            if (root.auto-editing) {
                root.auto-edit-consumed();
            }
        }
    }

    height: 40px;
    border-radius: 8px;
    border-width: 1px;
    border-color: root.drop-target
        ? #6db3f2
        : root.hovered ? #ffffff38 : #ffffff24;
    background: root.drop-target
        ? #6db3f21c
        : root.hovered
        ? @linear-gradient(180deg, #ffffff1e 0%, #ffffff10 100%)
        : @linear-gradient(180deg, #ffffff16 0%, #ffffff0a 100%);
    animate border-color { duration: 120ms; }

    header-ta := TouchArea {
        clicked => { root.collapse(root.item.id); }
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 16px;
        spacing: 10px;

        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 18px;
                height: 18px;
                border-radius: 4px;
                border-width: 1px;
                border-color: root.item.selected
                    ? #6db3f2
                    : (select-ta.has-hover ? #ffffff66 : #ffffff33);
                background: root.item.selected ? #6db3f2 : transparent;
                animate background { duration: 120ms; }
                animate border-color { duration: 120ms; }

                if root.item.selected: Path {
                    x: 2.5px;
                    y: 3.5px;
                    width: 13px;
                    height: 11px;
                    viewbox-x: 0;
                    viewbox-y: 0;
                    viewbox-width: 12;
                    viewbox-height: 10;
                    commands: "M1 5 L4 8 L11 1";
                    stroke: #111111;
                    stroke-width: 1.8px;
                    fill: transparent;
                }

                select-ta := TouchArea {
                    clicked => { root.toggle-select(root.item.id); }
                }
            }
        }

        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 14px;
                height: 14px;

                if root.item.collapsed: Path {
                    width: 100%;
                    height: 100%;
                    viewbox-x: 0;
                    viewbox-y: 0;
                    viewbox-width: 14;
                    viewbox-height: 14;
                    commands: "M4 2 L10 7 L4 12";
                    stroke: #ffffff88;
                    stroke-width: 1.8px;
                    fill: transparent;
                }

                if !root.item.collapsed: Path {
                    width: 100%;
                    height: 100%;
                    viewbox-x: 0;
                    viewbox-y: 0;
                    viewbox-width: 14;
                    viewbox-height: 14;
                    commands: "M2 4 L7 10 L12 4";
                    stroke: #ffffff88;
                    stroke-width: 1.8px;
                    fill: transparent;
                }
            }
        }

        if !root.editing: Text {
            text: root.item.name;
            color: Palette.text-primary;
            font-size: 13px;
            font-weight: 700;
            min-width: 0px;
            overflow: elide;
            vertical-alignment: center;
        }

        if root.editing: VerticalLayout {
            alignment: center;

            Rectangle {
                property <length> desired-width: min(420px, max(200px, name-measure.preferred-width + 16px));

                preferred-width: self.desired-width;
                max-width: self.desired-width;
                min-width: 0px;
                height: 24px;
                border-radius: 4px;
                background: #ffffff10;
                border-width: 1px;
                border-color: #ffffff33;

                name-measure := Text {
                    visible: false;
                    text: root.name-draft;
                    font-size: 12.5px;
                }

                ScrollingTextInput {
                    width: 100%;
                    height: 100%;
                    font-size: 12.5px;
                    init => {
                        self.text = root.item.name;
                        root.name-draft = root.item.name;
                        self.focus-input();
                        if (root.auto-editing) {
                            self.select-all();
                            root.auto-edit-opened();
                        }
                    }
                    edited(text) => { root.name-draft = text; }
                    accepted(text) => { root.commit-name(); }
                    focus-changed(focused) => {
                        if (!focused) { root.commit-name(); }
                    }
                }
            }
        }

        // Rename button
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 18px;
                height: 18px;
                border-radius: 4px;
                background: rename-ta.has-hover ? #ffffff16 : transparent;
                animate background { duration: 100ms; }

                Image {
                    source: @image-url("../../../production/icons/edit.png");
                    width: 11px;
                    height: 11px;
                    image-rendering: smooth;
                    image-fit: contain;
                    colorize: rename-ta.has-hover ? #ffffffdd : #ffffff66;
                    animate colorize { duration: 100ms; }
                }

                rename-ta := TouchArea {
                    clicked => {
                        if (root.editing) {
                            root.commit-name();
                        } else {
                            root.editing-name = true;
                        }
                    }
                }
            }
        }

        Rectangle {
            horizontal-stretch: 1;
        }

        // Delete group
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 26px;
                height: 26px;
                border-radius: 6px;
                background: delete-ta.has-hover ? #ee493722 : transparent;
                animate background { duration: 100ms; }

                Image {
                    source: @image-url("../../../production/icons/delete.png");
                    width: 14px;
                    height: 14px;
                    image-rendering: smooth;
                    image-fit: contain;
                    colorize: delete-ta.has-hover ? #ee4937 : #ffffff66;
                    animate colorize { duration: 100ms; }
                }

                delete-ta := TouchArea {
                    clicked => { root.request-delete(root.item.id); }
                }
            }
        }

        // Enable/disable every mod in the group
        VerticalLayout {
            alignment: center;
            ToggleSwitch {
                checked: root.item.enabled;
                toggled => { root.toggle-enabled(root.item.id); }
            }
        }
    }
}

// A checkbox (or radio) row inside the filter panel
component FilterRow inherits Rectangle {
    in property <FilterOption> option;
    in property <bool> checked: false;
    in property <bool> radio: false;
    in property <bool> show-icon: false;

    callback toggled();

    height: 30px;
    border-radius: 6px;
    background: row-ta.has-hover ? #ffffff10 : transparent;
    animate background { duration: 100ms; }

    row-ta := TouchArea {
        clicked => { root.toggled(); }
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 10px;
        spacing: 8px;

        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 16px;
                height: 16px;
                border-radius: root.radio ? 8px : 4px;
                border-width: 1px;
                border-color: root.checked
                    ? #6db3f2
                    : (row-ta.has-hover ? #ffffff66 : #ffffff33);
                background: root.checked ? #6db3f2 : transparent;
                animate background { duration: 120ms; }
                animate border-color { duration: 120ms; }

                if root.checked && !root.radio: Path {
                    x: 1.5px;
                    y: 3px;
                    width: 13px;
                    height: 11px;
                    viewbox-x: 0;
                    viewbox-y: 0;
                    viewbox-width: 12;
                    viewbox-height: 10;
                    commands: "M1 5 L4 8 L11 1";
                    stroke: #111111;
                    stroke-width: 1.8px;
                    fill: transparent;
                }

                if root.checked && root.radio: Rectangle {
                    x: 5px;
                    y: 5px;
                    width: 6px;
                    height: 6px;
                    border-radius: 3px;
                    background: #111111;
                }
            }
        }

        if root.show-icon: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 18px;
                height: 18px;
                border-radius: 9px;
                background: #00000044;
                clip: true;

                Image {
                    source: root.option.icon;
                    width: 100%;
                    height: 100%;
                    image-fit: contain;
                    image-rendering: smooth;
                }
            }
        }

        Text {
            horizontal-stretch: 1;
            text: root.option.name;
            color: root.checked ? #cfe6ff : Palette.text-primary;
            font-size: 12.5px;
            font-weight: 500;
            overflow: elide;
            vertical-alignment: center;
        }

        Text {
            text: root.option.count;
            color: #ffffff55;
            font-size: 11.5px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}

component StatusChip inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;

    callback clicked();

    height: 28px;
    horizontal-stretch: 1;
    border-radius: 7px;
    border-width: 1px;
    border-color: root.active ? #6db3f2 : (chip-ta.has-hover ? #ffffff28 : #ffffff16);
    background: root.active
        ? #6db3f21c
        : (chip-ta.has-hover ? #ffffff12 : #ffffff08);
    animate background { duration: 100ms; }
    animate border-color { duration: 100ms; }

    Text {
        text: root.label;
        color: root.active ? #cfe6ff : #ffffffcc;
        font-size: 12px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    chip-ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

component GroupDropdown inherits Rectangle {
    in property <[FilterOption]> options: [];
    in property <string> selected-id: "";
    in property <string> label;

    callback picked(string /* id */);

    property <bool> narrowed: root.selected-id != "";
    property <length> row-height: 30px;
    property <length> row-spacing: 2px;
    property <length> list-height: min(root.options.length, 7)
        * (self.row-height + self.row-spacing) - self.row-spacing;

    height: 30px;
    border-radius: 7px;
    border-width: 1px;
    border-color: root.narrowed
        ? #6db3f2
        : (trigger-ta.has-hover ? #ffffff28 : #ffffff16);
    background: root.narrowed
        ? #6db3f21c
        : (trigger-ta.has-hover ? #ffffff12 : #ffffff08);
    animate background { duration: 100ms; }
    animate border-color { duration: 100ms; }

    trigger-ta := TouchArea {
        clicked => { popup.show(); }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;

        Text {
            horizontal-stretch: 1;
            text: root.label;
            color: root.narrowed ? #cfe6ff : #ffffffcc;
            font-size: 12.5px;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
        }

        VerticalLayout {
            alignment: center;
            Path {
                width: 10px;
                height: 6px;
                viewbox-x: 0;
                viewbox-y: 0;
                viewbox-width: 10;
                viewbox-height: 6;
                commands: "M1 1 L5 5 L9 1";
                stroke: root.narrowed ? #6db3f2 : #ffffff88;
                stroke-width: 1.5px;
                fill: transparent;
            }
        }
    }

    popup := PopupWindow {
        x: 0px;
        y: parent.height + 4px;
        width: parent.width;
        height: root.list-height + 12px;

        Rectangle {
            background: #1e1e24;
            border-radius: 8px;
            border-width: 1px;
            border-color: #3f3f46;

            ScrollView {
                x: 6px;
                y: 6px;
                width: parent.width - 12px;
                height: root.list-height;
                viewport-width: self.width;
                viewport-height: list-col.preferred-height;

                list-col := VerticalLayout {
                    spacing: root.row-spacing;
                    alignment: start;

                    for option in root.options: FilterRow {
                        option: option;
                        radio: true;
                        checked: root.selected-id == option.id;
                        toggled => {
                            root.picked(option.id);
                            popup.close();
                        }
                    }
                }
            }
        }
    }
}

component FilterSection inherits VerticalLayout {
    in property <string> title;

    spacing: 4px;

    Text {
        text: root.title;
        color: #ffffff66;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.6px;
    }

    @children
}

export component ModManagerPage inherits Rectangle {
    in-out property <[ModItem]> mods: [];
    // Same data as `mods`, but split into sections for the grid view
    in property <[[ModItem]]> mods-grid: [];
    in-out property <string> search-text: "";
    in-out property <bool> view-grid: false;
    callback view-changed(bool);

    // [FILTERS]
    in-out property <ModFilters> filters: { status: 0, group-id: "" };
    in-out property <[FilterOption]> filter-characters: [];
    in-out property <[FilterOption]> filter-authors: [];
    in property <[FilterOption]> filter-groups: [];
    in property <string> filter-group-label: "";
    in property <int> active-filter-count: 0;
    property <bool> filter-open: false;
    in property <bool> all-selected: false;
    in property <int> selected-count: 0;
    in property <int> selected-group-count: 0;
    in property <bool> file-hover: false;
    in property <[GroupOption]> groups: [];

    // [CALLBACKS]
    callback close-mod-manager();
    callback install-from-archive();
    callback install-from-folder();
    callback install-from-gamebanana();
    callback open-gamebanana();
    callback toggle-mod(string);
    callback delete-mod(string);
    callback rename-mod(string, string);
    callback select-mod(string);
    callback select-all();
    callback open-mod-link(string);
    callback set-mod-notes(string, string);
    callback toggle-selected();
    callback delete-selected();
    callback delete-selected-groups();
    callback create-group();
    callback rename-group(string, string);
    callback delete-group(string);
    callback toggle-group(string);
    callback collapse-group(string);
    callback select-group(string);
    callback toggle-all();
    callback refresh();
    callback open-mods-folder();
    callback search-changed(string);
    callback filters-changed(ModFilters);
    callback clear-filters();
    callback move-mod-to-group(string, string);
    callback move-selected-to-group(string /* group id, "" = mods root */);
    callback create-group-with-selected(string /* new group name */);

    in-out property <bool> naming-group: false;

    in-out property <string> pending-delete-id: "";
    in-out property <string> pending-delete-group-id: "";
    in-out property <bool> pending-delete-selected: false;
    in-out property <bool> pending-delete-selected-groups: false;

    in-out property <string> drag-id: "";
    in-out property <string> drag-name: "";
    in-out property <length> drag-pos-x;
    in-out property <length> drag-pos-y;
    in property <string> drag-target-group: "";
    in-out property <string> editing-group-id: "";
    // Group waiting to be scrolled into view, cleared once that has happened
    property <string> reveal-group-id: "";
    callback mod-drag-moved(string, length);
    callback mod-drag-dropped(string, length);
    callback drop-mod-on-zone(string /* id */, string /* zone */);

    in-out property <string> drag-source-zone: "";
    in-out property <string> grid-drag-zone: "";
    in-out property <bool> grid-drag-zone-valid: false;

    changed search-text => { root.search-changed(root.search-text); }

    function commit-new-group(name: string) {
        if (name != "") {
            root.create-group-with-selected(name);
        }
        root.naming-group = false;
    }

    init => {
        root.search-changed(root.search-text);
    }

    background: @linear-gradient(180deg, #111115ef 0%, #16161aeb 100%);
    border-radius: 16px;
    border-width: 1px;
    border-color: Palette.glass-border;
    drop-shadow-color: Palette.shadow-color;
    drop-shadow-blur: 25px;
    drop-shadow-offset-y: 10px;

    commit-focus := FocusScope {
        width: 0px;
        height: 0px;
    }

    VerticalLayout {
        spacing: 0px;

        header-root := Rectangle {
            height: 60px;
            width: 100%;

            HorizontalLayout {
                x: 20px;
                y: 0px;
                width: parent.width - 40px;
                height: parent.height;
                spacing: 8px;

                VerticalLayout {
                    alignment: center;
                    width: self.preferred-width;
                    Text {
                        text: Tr.values[TrKey.main-button-row-mod-manager];
                        color: Palette.text-primary;
                        font-size: 17px;
                        font-weight: 700;
                    }
                }

                Rectangle {
                    width: 6px;
                }

                VerticalLayout {
                    alignment: center;
                    width: self.preferred-width;
                    add-mods-pill := Rectangle {
                        height: 28px;
                        width: add-mods-row.preferred-width + 24px;
                        border-radius: 7px;
                        border-width: 1px;
                        border-color: add-mods-ta.has-hover ? #ffffff28 : #ffffff16;
                        background: add-mods-ta.has-hover ? #ffffff12 : #ffffff08;
                        animate background { duration: 100ms; }
                        animate border-color { duration: 100ms; }

                        add-mods-ta := TouchArea {
                            clicked => {
                                commit-focus.focus();
                                add-menu.show();
                            }
                        }

                        add-menu := PopupWindow {
                            x: 0px;
                            y: parent.height + 6px;
                            width: 240px;

                            Rectangle {
                                background: #1e1e24;
                                border-radius: 8px;
                                border-width: 1px;
                                border-color: #3f3f46;

                                VerticalLayout {
                                    padding: 6px;
                                    spacing: 2px;

                                    Rectangle {
                                        height: 36px;
                                        border-radius: 6px;
                                        background: archive-ta.has-hover ? #ffffff10 : transparent;

                                        archive-ta := TouchArea {
                                            clicked => { root.install-from-archive(); }
                                        }

                                        HorizontalLayout {
                                            padding-left: 10px;
                                            padding-right: 10px;
                                            spacing: 10px;
                                            alignment: start;

                                            VerticalLayout {
                                                alignment: center;
                                                Image {
                                                    source: @image-url("../../../production/icons/download.png");
                                                    width: 14px;
                                                    height: 14px;
                                                    image-rendering: smooth;
                                                    image-fit: contain;
                                                    colorize: #ffffffaa;
                                                }
                                            }

                                            Text {
                                                text: Tr.values[TrKey.modmanager-install-archive];
                                                color: #ffffffdd;
                                                font-size: 12.5px;
                                                font-weight: 500;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    Rectangle {
                                        height: 36px;
                                        border-radius: 6px;
                                        background: folder-ta.has-hover ? #ffffff10 : transparent;

                                        folder-ta := TouchArea {
                                            clicked => { root.install-from-folder(); }
                                        }

                                        HorizontalLayout {
                                            padding-left: 10px;
                                            padding-right: 10px;
                                            spacing: 10px;
                                            alignment: start;

                                            VerticalLayout {
                                                alignment: center;
                                                Image {
                                                    source: @image-url("../../../production/icons/folder.png");
                                                    width: 14px;
                                                    height: 14px;
                                                    image-rendering: smooth;
                                                    image-fit: contain;
                                                    colorize: #ffffffaa;
                                                }
                                            }

                                            Text {
                                                text: Tr.values[TrKey.modmanager-install-folder];
                                                color: #ffffffdd;
                                                font-size: 12.5px;
                                                font-weight: 500;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    Rectangle {
                                        height: 36px;
                                        border-radius: 6px;
                                        background: gb-ta.has-hover ? #ffffff10 : transparent;

                                        gb-ta := TouchArea {
                                            clicked => { root.install-from-gamebanana(); }
                                        }

                                        HorizontalLayout {
                                            padding-left: 10px;
                                            padding-right: 10px;
                                            spacing: 10px;
                                            alignment: start;

                                            VerticalLayout {
                                                alignment: center;
                                                Image {
                                                    source: @image-url("../../../production/icons/gamebanana.png");
                                                    width: 14px;
                                                    height: 14px;
                                                    image-rendering: smooth;
                                                    image-fit: contain;
                                                    colorize: #ffffffaa;
                                                }
                                            }

                                            Text {
                                                text: Tr.values[TrKey.gb-title];
                                                color: #ffffffdd;
                                                font-size: 12.5px;
                                                font-weight: 500;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        add-mods-row := HorizontalLayout {
                            x: 12px;
                            y: 0px;
                            height: parent.height;
                            width: self.preferred-width;
                            spacing: 7px;
                            alignment: center;

                            VerticalLayout {
                                alignment: center;
                                Path {
                                    width: 14px;
                                    height: 14px;
                                    viewbox-x: 0;
                                    viewbox-y: 0;
                                    viewbox-width: 14;
                                    viewbox-height: 14;
                                    commands: "M7 1 L7 13 M1 7 L13 7";
                                    stroke: #ffffffbb;
                                    stroke-width: 1.8px;
                                    fill: transparent;
                                }
                            }

                            Text {
                                text: Tr.values[TrKey.modmanager-add-mods];
                                color: #ffffffcc;
                                font-size: 12px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    width: self.preferred-width;
                    group-pill := Rectangle {
                        height: 28px;
                        width: group-row.preferred-width + 24px;
                        border-radius: 7px;
                        border-width: 1px;
                        border-color: group-ta.has-hover ? #ffffff28 : #ffffff16;
                        background: group-ta.has-hover ? #ffffff12 : #ffffff08;
                        animate background { duration: 100ms; }
                        animate border-color { duration: 100ms; }

                        group-ta := TouchArea {
                            clicked => {
                                commit-focus.focus();
                                root.create-group();
                            }
                        }

                        group-row := HorizontalLayout {
                            x: 12px;
                            y: 0px;
                            height: parent.height;
                            width: self.preferred-width;
                            spacing: 7px;
                            alignment: center;

                            VerticalLayout {
                                alignment: center;
                                Path {
                                    width: 14px;
                                    height: 14px;
                                    viewbox-x: 0;
                                    viewbox-y: 0;
                                    viewbox-width: 14;
                                    viewbox-height: 14;
                                    commands: "M1 4 Q1 3 2 3 L5 3 L6.5 4.5 L12 4.5 Q13 4.5 13 5.5 L13 11 Q13 12 12 12 L2 12 Q1 12 1 11 Z M10 7 L10 10 M8.5 8.5 L11.5 8.5";
                                    stroke: #ffffffbb;
                                    stroke-width: 1.4px;
                                    fill: transparent;
                                }
                            }

                            Text {
                                text: Tr.values[TrKey.modmanager-create-group];
                                color: #ffffffcc;
                                font-size: 12px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                VerticalLayout {
                    horizontal-stretch: 1;
                }

                VerticalLayout {
                    alignment: center;
                    width: self.preferred-width;
                    open-folder-rect := Rectangle {
                        width: 28px;
                        height: 28px;
                        border-radius: 6px;
                        background: open-folder-ta.has-hover ? #ffffff14 : transparent;
                        animate background { duration: 100ms; }

                        Image {
                            source: @image-url("../../../production/icons/folder.png");
                            width: 14px;
                            height: 14px;
                            image-rendering: smooth;
                            image-fit: contain;
                            colorize: open-folder-ta.has-hover ? #ffffffdd : #ffffff66;
                            animate colorize { duration: 100ms; }
                        }

                        open-folder-ta := TouchArea {
                            clicked => { root.open-mods-folder(); }
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    width: self.preferred-width;
                    view-pill := Rectangle {
                        height: 28px;
                        width: 64px;
                        border-radius: 7px;
                        border-width: 1px;
                        border-color: #ffffff16;
                        background: #ffffff06;
                        clip: true;

                        HorizontalLayout {
                            spacing: 0px;

                            list-side := Rectangle {
                                width: 31px;
                                height: 28px;
                                background: !root.view-grid
                                    ? #ffffff18
                                    : (list-ta.has-hover ? #ffffff0a : transparent);
                                animate background { duration: 100ms; }

                                list-ta := TouchArea {
                                    clicked => {
                                        root.view-grid = false;
                                        root.view-changed(false);
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 3px;
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    for _ in [0, 1, 2]: Rectangle {
                                        height: 2px;
                                        border-radius: 1px;
                                        background: !root.view-grid ? #ffffffee : #ffffff44;
                                        animate background { duration: 100ms; }
                                    }
                                }
                            }

                            Rectangle {
                                width: 1px;
                                height: 28px;
                                background: #ffffff16;
                            }

                            grid-side := Rectangle {
                                width: 31px;
                                height: 28px;
                                background: root.view-grid
                                    ? #ffffff18
                                    : (grid-ta.has-hover ? #ffffff0a : transparent);
                                animate background { duration: 100ms; }

                                grid-ta := TouchArea {
                                    clicked => {
                                        root.view-grid = true;
                                        root.view-changed(true);
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 4px;
                                    padding-left: 9px;
                                    padding-right: 9px;
                                    for _ in [0, 1]: HorizontalLayout {
                                        spacing: 4px;
                                        alignment: center;
                                        for _ in [0, 1]: Rectangle {
                                            width: 4px;
                                            height: 4px;
                                            border-radius: 1px;
                                            background: root.view-grid ? #ffffffee : #ffffff44;
                                            animate background { duration: 100ms; }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    width: self.preferred-width;
                    refresh-rect := Rectangle {
                        width: 28px;
                        height: 28px;
                        border-radius: 6px;
                        background: refresh-ta.has-hover ? #ffffff14 : transparent;
                        animate background { duration: 100ms; }

                        Image {
                            source: @image-url("../../../production/icons/refresh.png");
                            width: 14px;
                            height: 14px;
                            image-rendering: smooth;
                            image-fit: contain;
                            colorize: refresh-ta.has-hover ? #ffffffdd : #ffffff66;
                            animate colorize { duration: 100ms; }
                        }

                        refresh-ta := TouchArea {
                            clicked => {
                                commit-focus.focus();
                                root.refresh();
                            }
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    width: self.preferred-width;
                    close-rect := Rectangle {
                        width: 28px;
                        height: 28px;
                        border-radius: 6px;
                        background: close-ta.has-hover ? #ffffff14 : transparent;
                        animate background { duration: 100ms; }

                        Path {
                            x: 7px;
                            y: 7px;
                            width: 14px;
                            height: 14px;
                            viewbox-x: 0;
                            viewbox-y: 0;
                            viewbox-width: 14;
                            viewbox-height: 14;
                            commands: "M1 1 L13 13 M13 1 L1 13";
                            stroke: close-ta.has-hover ? #ffffffdd : #ffffff66;
                            stroke-width: 1.8px;
                            fill: transparent;
                            animate stroke { duration: 100ms; }
                        }

                        close-ta := TouchArea {
                            clicked => { root.close-mod-manager(); }
                        }
                    }
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Palette.glass-border;
        }

        Rectangle {
            height: 48px;
            width: 100%;
            background: #ffffff02;

            HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                spacing: 12px;

                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 18px;
                        height: 18px;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: root.all-selected
                            ? #6db3f2
                            : (select-all-ta.has-hover ? #ffffff77 : #ffffff44);
                        background: root.all-selected ? #6db3f2 : transparent;
                        animate background { duration: 120ms; }
                        animate border-color { duration: 120ms; }

                        if root.all-selected: Path {
                            x: 2.5px;
                            y: 3.5px;
                            width: 13px;
                            height: 11px;
                            viewbox-x: 0;
                            viewbox-y: 0;
                            viewbox-width: 12;
                            viewbox-height: 10;
                            commands: "M1 5 L4 8 L11 1";
                            stroke: #111111;
                            stroke-width: 1.8px;
                            fill: transparent;
                        }

                        select-all-ta := TouchArea {
                            clicked => {
                                commit-focus.focus();
                                root.select-all();
                            }
                        }
                    }
                }

                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    search-container := Rectangle {
                        height: 32px;
                        background: #ffffff08;
                        border-radius: 7px;
                        border-width: 1px;
                        border-color: #ffffff16;

                        Image {
                            source: @image-url("../../../production/icons/search.png");
                            x: 10px;
                            y: (parent.height - self.height) / 2;
                            width: 14px;
                            height: 14px;
                            image-rendering: smooth;
                            image-fit: contain;
                            colorize: #ffffff66;
                        }

                        TextInput {
                            x: 32px;
                            width: parent.width - 44px;
                            text <=> root.search-text;
                            font-size: 13px;
                            color: Palette.text-primary;
                            vertical-alignment: center;
                        }

                        if (root.search-text == ""): Text {
                            x: 32px;
                            text: Tr.values[TrKey.global-search-mods-placeholder];
                            color: #ffffff44;
                            font-size: 13px;
                            vertical-alignment: center;
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 1px;
                        height: 20px;
                        background: Palette.glass-border;
                    }
                }

                VerticalLayout {
                    alignment: center;
                    width: self.preferred-width;
                    filter-pill := Rectangle {
                        property <bool> active: root.active-filter-count > 0;

                        height: 28px;
                        width: filter-row.preferred-width + 24px;
                        border-radius: 7px;
                        border-width: 1px;
                        border-color: self.active
                            ? #6db3f2
                            : (filter-ta.has-hover ? #ffffff28 : #ffffff16);
                        background: self.active
                            ? #6db3f21c
                            : (filter-ta.has-hover ? #ffffff12 : #ffffff08);
                        animate background { duration: 100ms; }
                        animate border-color { duration: 100ms; }

                        filter-ta := TouchArea {
                            clicked => {
                                commit-focus.focus();
                                root.filter-open = true;
                            }
                        }

                        filter-row := HorizontalLayout {
                            x: 12px;
                            y: 0px;
                            height: parent.height;
                            width: self.preferred-width;
                            spacing: 7px;
                            alignment: center;

                            VerticalLayout {
                                alignment: center;
                                Path {
                                    width: 13px;
                                    height: 13px;
                                    viewbox-x: 0;
                                    viewbox-y: 0;
                                    viewbox-width: 14;
                                    viewbox-height: 14;
                                    commands: "M1.5 2.5 L12.5 2.5 L8.5 7.5 L8.5 12 L5.5 10.5 L5.5 7.5 Z";
                                    stroke: filter-pill.active ? #6db3f2 : #ffffffbb;
                                    stroke-width: 1.4px;
                                    fill: transparent;
                                }
                            }

                            Text {
                                text: filter-pill.active
                                    ? Tr.values[TrKey.modmanager-filter-button]
                                    + " (" + root.active-filter-count + ")"
                                    : Tr.values[TrKey.modmanager-filter-button];
                                color: filter-pill.active ? #cfe6ff : #ffffffcc;
                                font-size: 12px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    toggle-all-btn := Rectangle {
                        width: 88px;
                        height: 28px;
                        border-radius: 7px;
                        border-width: 1px;
                        border-color: toggle-ta.has-hover ? #ffffff28 : #ffffff16;
                        background: toggle-ta.has-hover ? #ffffff12 : #ffffff08;
                        animate background { duration: 100ms; }
                        animate border-color { duration: 100ms; }

                        Text {
                            text: Tr.values[TrKey.modmanager-toggle-all];
                            color: #ffffffcc;
                            font-size: 12px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        toggle-ta := TouchArea {
                            clicked => {
                                commit-focus.focus();
                                root.toggle-all();
                            }
                        }
                    }
                }

                if root.selected-count > 0: VerticalLayout {
                    alignment: center;
                    move-sel-btn := Rectangle {
                        // "No Group" + every group + "New Group..."
                        property <int> entry-count: root.groups.length + 2;
                        property <length> row-height: 32px;
                        property <length> row-spacing: 2px;
                        property <length> list-height: min(self.entry-count, 8)
                            * (self.row-height + self.row-spacing) - self.row-spacing;

                        width: move-sel-text.preferred-width + 24px;
                        height: 28px;
                        border-radius: 7px;
                        border-width: 1px;
                        border-color: move-sel-ta.has-hover ? #ffffff28 : #ffffff16;
                        background: move-sel-ta.has-hover ? #ffffff12 : #ffffff08;
                        animate background { duration: 100ms; }

                        move-sel-text := Text {
                            text: Tr.values[TrKey.modmanager-move-to-group] + " (" + root.selected-count + ")";
                            color: #ffffffcc;
                            font-size: 12px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        move-sel-ta := TouchArea {
                            clicked => {
                                commit-focus.focus();
                                move-menu.show();
                            }
                        }

                        move-menu := PopupWindow {
                            x: 0px;
                            y: parent.height + 6px;
                            width: 220px;
                            height: move-sel-btn.list-height + 12px;

                            Rectangle {
                                background: #1e1e24;
                                border-radius: 8px;
                                border-width: 1px;
                                border-color: #3f3f46;

                                ScrollView {
                                    x: 6px;
                                    y: 6px;
                                    width: parent.width - 12px;
                                    height: move-sel-btn.list-height;
                                    viewport-height: move-menu-list.preferred-height;

                                    move-menu-list := VerticalLayout {
                                        spacing: move-sel-btn.row-spacing;
                                        alignment: start;

                                        // Back out of any group, into the mods root
                                        Rectangle {
                                            height: move-sel-btn.row-height;
                                            border-radius: 6px;
                                            background: root-entry-ta.has-hover ? #ffffff10 : transparent;

                                            root-entry-ta := TouchArea {
                                                clicked => {
                                                    root.move-selected-to-group("");
                                                    move-menu.close();
                                                }
                                            }

                                            Text {
                                                x: 10px;
                                                width: parent.width - 20px;
                                                text: Tr.values[TrKey.modmanager-move-no-group];
                                                color: #ffffffaa;
                                                font-size: 12.5px;
                                                font-weight: 500;
                                                overflow: elide;
                                                vertical-alignment: center;
                                            }
                                        }

                                        for group in root.groups: Rectangle {
                                            height: move-sel-btn.row-height;
                                            border-radius: 6px;
                                            background: group-entry-ta.has-hover ? #ffffff10 : transparent;

                                            group-entry-ta := TouchArea {
                                                clicked => {
                                                    root.move-selected-to-group(group.id);
                                                    move-menu.close();
                                                }
                                            }

                                            Text {
                                                x: 10px;
                                                width: parent.width - 20px;
                                                text: group.name;
                                                color: #ffffffdd;
                                                font-size: 12.5px;
                                                font-weight: 500;
                                                overflow: elide;
                                                vertical-alignment: center;
                                            }
                                        }

                                        Rectangle {
                                            height: move-sel-btn.row-height;
                                            border-radius: 6px;
                                            background: new-group-entry-ta.has-hover ? #ffffff10 : transparent;

                                            new-group-entry-ta := TouchArea {
                                                clicked => {
                                                    root.naming-group = true;
                                                    move-menu.close();
                                                }
                                            }

                                            HorizontalLayout {
                                                padding-left: 10px;
                                                padding-right: 10px;
                                                spacing: 8px;
                                                alignment: start;

                                                VerticalLayout {
                                                    alignment: center;
                                                    Path {
                                                        width: 12px;
                                                        height: 12px;
                                                        viewbox-x: 0;
                                                        viewbox-y: 0;
                                                        viewbox-width: 14;
                                                        viewbox-height: 14;
                                                        commands: "M7 1 L7 13 M1 7 L13 7";
                                                        stroke: #ffffffaa;
                                                        stroke-width: 1.8px;
                                                        fill: transparent;
                                                    }
                                                }

                                                Text {
                                                    text: Tr.values[TrKey.modmanager-move-new-group];
                                                    color: #ffffffdd;
                                                    font-size: 12.5px;
                                                    font-weight: 500;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                if root.selected-count > 0: VerticalLayout {
                    alignment: center;
                    toggle-sel-btn := Rectangle {
                        width: toggle-sel-text.preferred-width + 24px;
                        height: 28px;
                        border-radius: 7px;
                        border-width: 1px;
                        border-color: toggle-sel-ta.has-hover ? #ffffff28 : #ffffff16;
                        background: toggle-sel-ta.has-hover ? #ffffff12 : #ffffff08;
                        animate background { duration: 100ms; }

                        toggle-sel-text := Text {
                            text: Tr.values[TrKey.global-button-toggle] + " (" + root.selected-count + ")";
                            color: #ffffffcc;
                            font-size: 12px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        toggle-sel-ta := TouchArea {
                            clicked => {
                                commit-focus.focus();
                                root.toggle-selected();
                            }
                        }
                    }
                }

                if root.selected-count > 0: VerticalLayout {
                    alignment: center;
                    delete-sel-btn := Rectangle {
                        width: delete-sel-text.preferred-width + 24px;
                        height: 28px;
                        border-radius: 7px;
                        border-width: 1px;
                        border-color: #ee493766;
                        background: delete-sel-ta.has-hover ? #ee4937 : #ee4937cc;
                        animate background { duration: 100ms; }

                        delete-sel-text := Text {
                            text: Tr.values[TrKey.global-button-delete] + " (" + root.selected-count + ")";
                            color: Palette.text-primary;
                            font-size: 12px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        delete-sel-ta := TouchArea {
                            clicked => {
                                commit-focus.focus();
                                root.pending-delete-selected = true;
                            }
                        }
                    }
                }

                if root.selected-group-count > 0: VerticalLayout {
                    alignment: center;
                    delete-groups-btn := Rectangle {
                        width: delete-groups-text.preferred-width + 24px;
                        height: 28px;
                        border-radius: 7px;
                        border-width: 1px;
                        border-color: #ee493766;
                        background: delete-groups-ta.has-hover ? #ee4937 : #ee4937cc;
                        animate background { duration: 100ms; }

                        delete-groups-text := Text {
                            text: Tr.values[TrKey.modmanager-delete-groups-button]
                                + " (" + root.selected-group-count + ")";
                            color: Palette.text-primary;
                            font-size: 12px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        delete-groups-ta := TouchArea {
                            clicked => {
                                commit-focus.focus();
                                root.pending-delete-selected-groups = true;
                            }
                        }
                    }
                }
            }
        }

        content-area := Rectangle {
            vertical-stretch: 1;
            background: transparent;

            property <bool> pending-root-drop: root.drag-id != ""
                && root.drag-source-zone != ""
                && root.drag-pos-x >= self.absolute-position.x
                && root.drag-pos-x <= self.absolute-position.x + self.width
                && root.drag-pos-y >= self.absolute-position.y
                && root.drag-pos-y <= self.absolute-position.y + self.height
                && (root.view-grid
                ? (!root.grid-drag-zone-valid
                || root.grid-drag-zone == ""
                || root.grid-drag-zone == root.drag-source-zone)
                : root.drag-target-group == "");

            if (!root.view-grid): list-scroll := ScrollView {
                width: 100%;
                height: 100%;
                viewport-height: mod-list.preferred-height;

                function drag-content-y(wx: length, wy: length) -> length {
                    if (wx < self.absolute-position.x
                        || wx > self.absolute-position.x + self.width
                        || wy < self.absolute-position.y
                        || wy > self.absolute-position.y + self.height) {
                        return -1px;
                    }
                    return wy - self.absolute-position.y - self.viewport-y;
                }

                property <length> drag-local-y: root.drag-pos-y - self.absolute-position.y;
                property <bool> drag-inside-x: root.drag-pos-x >= self.absolute-position.x
                    && root.drag-pos-x <= self.absolute-position.x + self.width;
                property <bool> drag-near-top: root.drag-id != ""
                    && self.drag-inside-x
                    && self.drag-local-y >= 0px && self.drag-local-y < 48px;
                property <bool> drag-near-bottom: root.drag-id != ""
                    && self.drag-inside-x
                    && self.drag-local-y > self.height - 48px && self.drag-local-y <= self.height;
                property <length> scroll-min: min(0px, self.height - self.viewport-height);

                // Scrolls a row into view, taking its y in content space
                function reveal(content-y: length, h: length) {
                    if (content-y + self.viewport-y < 12px) {
                        self.viewport-y = min(0px, 12px - content-y);
                    } else if (content-y + h + self.viewport-y > self.height - 12px) {
                        self.viewport-y = min(0px, max(self.scroll-min,
                            self.height - 12px - content-y - h));
                    }
                }

                Timer {
                    interval: 16ms;
                    running: list-scroll.drag-near-top || list-scroll.drag-near-bottom;
                    triggered => {
                        if (list-scroll.drag-near-top) {
                            list-scroll.viewport-y = min(0px, list-scroll.viewport-y + 8px);
                        }
                        if (list-scroll.drag-near-bottom) {
                            list-scroll.viewport-y = max(list-scroll.scroll-min, list-scroll.viewport-y - 8px);
                        }
                        root.mod-drag-moved(root.drag-id,
                            list-scroll.drag-content-y(root.drag-pos-x, root.drag-pos-y));
                    }
                }

                mod-list := VerticalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    padding-top: 12px;
                    padding-bottom: 12px;
                    spacing: 8px;
                    alignment: start;

                    for mod in root.mods: mod-row := Rectangle {
                        height: mod.is-group-header ? 52px : 64px;

                        property <bool> nested: !mod.is-group-header && mod.group-id != "";

                        if mod.is-group-header: GroupHeader {
                            width: 100%;
                            y: 12px;
                            height: parent.height - 12px;
                            item: mod;
                            drop-target: root.drag-id != ""
                                && root.drag-target-group != ""
                                && mod.id == root.drag-target-group;
                            auto-edit-id: root.editing-group-id;
                            auto-edit-consumed => { root.editing-group-id = ""; }
                            auto-edit-opened => { root.reveal-group-id = mod.id; }
                            collapse(id) => { root.collapse-group(id); }
                            rename(id, name) => { root.rename-group(id, name); }
                            request-delete(id) => { root.pending-delete-group-id = id; }
                            toggle-enabled(id) => { root.toggle-group(id); }
                            toggle-select(id) => { root.select-group(id); }
                        }

                        if mod.is-group-header: Rectangle {
                            width: 0px;
                            height: 0px;
                            Timer {
                                interval: 16ms;
                                running: root.reveal-group-id != ""
                                    && root.reveal-group-id == mod.id;
                                triggered => {
                                    list-scroll.reveal(mod-row.y, mod-row.height);
                                    root.reveal-group-id = "";
                                }
                            }
                        }

                        if mod-row.nested: Rectangle {
                            x: 13px;
                            y: -8px;
                            width: 2px;
                            height: parent.height + 8px;
                            background: #ffffff18;
                        }

                        if !mod.is-group-header: ModCard {
                            x: mod-row.nested ? 28px : 0px;
                            width: parent.width - self.x;
                            height: 100%;
                            item: mod;
                            toggle-select(id) => { root.select-mod(id); }
                            rename(id, name) => { root.rename-mod(id, name); }
                            set-notes(id, notes) => { root.set-mod-notes(id, notes); }
                            toggle-enabled(id) => { root.toggle-mod(id); }
                            request-delete(id, name) => { root.pending-delete-id = id; }
                            open-link(id) => { root.open-mod-link(id); }
                            drop-target: root.drag-id != ""
                                && root.drag-target-group != ""
                                && root.drag-id != mod.id
                                && mod.group-id == root.drag-target-group;
                            drag-started(id, name) => {
                                root.drag-id = id;
                                root.drag-source-zone = mod.group-id;
                                root.drag-name = (mod.selected && root.selected-count > 1)
                                    ? root.selected-count + " " + Tr.values[TrKey.modmanager-drag-mods-suffix]
                                    : name;
                            }
                            drag-moved(wx, wy) => {
                                root.drag-pos-x = wx;
                                root.drag-pos-y = wy;
                                root.mod-drag-moved(mod.id, list-scroll.drag-content-y(wx, wy));
                            }
                            drag-ended(wx, wy) => {
                                root.mod-drag-dropped(mod.id, list-scroll.drag-content-y(wx, wy));
                                root.drag-id = "";
                                root.drag-name = "";
                            }
                        }
                    }

                    if root.mods.length == 0: Text {
                        text: root.search-text != "" ? Tr.values[TrKey.modmanager-empty-search]
                            : root.active-filter-count > 0 ? Tr.values[TrKey.modmanager-empty-filter]
                            : Tr.values[TrKey.modmanager-empty];
                        color: #ffffff44;
                        font-size: 13px;
                        horizontal-alignment: center;
                    }
                }
            }

            if (root.view-grid): grid-scroll := ScrollView {
                width: 100%;
                height: 100%;
                viewport-height: grid-content.preferred-height;

                property <length> drag-local-y: root.drag-pos-y - self.absolute-position.y;
                property <bool> drag-inside-x: root.drag-pos-x >= self.absolute-position.x
                    && root.drag-pos-x <= self.absolute-position.x + self.width;
                property <bool> drag-near-top: root.drag-id != ""
                    && self.drag-inside-x
                    && self.drag-local-y >= 0px && self.drag-local-y < 48px;
                property <bool> drag-near-bottom: root.drag-id != ""
                    && self.drag-inside-x
                    && self.drag-local-y > self.height - 48px && self.drag-local-y <= self.height;
                property <length> scroll-min: min(0px, self.height - self.viewport-height);
                property <bool> drag-inside: root.drag-id != ""
                    && self.drag-inside-x
                    && self.drag-local-y >= 0px && self.drag-local-y <= self.height;

                function reveal(content-y: length, h: length) {
                    if (content-y + self.viewport-y < 12px) {
                        self.viewport-y = min(0px, 12px - content-y);
                    } else if (content-y + h + self.viewport-y > self.height - 12px) {
                        self.viewport-y = min(0px, max(self.scroll-min,
                            self.height - 12px - content-y - h));
                    }
                }

                Timer {
                    interval: 16ms;
                    running: grid-scroll.drag-near-top || grid-scroll.drag-near-bottom;
                    triggered => {
                        if (grid-scroll.drag-near-top) {
                            grid-scroll.viewport-y = min(0px, grid-scroll.viewport-y + 8px);
                        }
                        if (grid-scroll.drag-near-bottom) {
                            grid-scroll.viewport-y = max(grid-scroll.scroll-min, grid-scroll.viewport-y - 8px);
                        }
                    }
                }

                grid-content := VerticalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    padding-top: 12px;
                    padding-bottom: 12px;
                    spacing: 20px;
                    alignment: start;

                    for section in root.mods-grid: section-root := VerticalLayout {
                        spacing: 8px;

                        property <bool> has-header: section.length > 0 && section[0].is-group-header;
                        property <int> tile-count: section.length - (self.has-header ? 1 : 0);

                        property <string> zone: self.has-header ? section[0].id : "";
                        property <bool> drag-over: root.drag-id != ""
                            && root.drag-pos-x >= self.absolute-position.x
                            && root.drag-pos-x <= self.absolute-position.x + self.width
                            && root.drag-pos-y >= self.absolute-position.y
                            && root.drag-pos-y <= self.absolute-position.y + self.height;
                        property <bool> drag-highlight: self.drag-over
                            && self.zone != root.drag-source-zone;

                        changed drag-over => {
                            if (self.drag-over) {
                                root.grid-drag-zone = self.zone;
                                root.grid-drag-zone-valid = true;
                            } else if (root.grid-drag-zone == self.zone) {
                                root.grid-drag-zone-valid = false;
                            }
                        }

                        if section-root.has-header: GroupHeader {
                            item: section[0];
                            drop-target: section-root.drag-highlight;
                            auto-edit-id: root.editing-group-id;
                            auto-edit-consumed => { root.editing-group-id = ""; }
                            auto-edit-opened => { root.reveal-group-id = section-root.zone; }
                            collapse(id) => { root.collapse-group(id); }
                            rename(id, name) => { root.rename-group(id, name); }
                            request-delete(id) => { root.pending-delete-group-id = id; }
                            toggle-enabled(id) => { root.toggle-group(id); }
                            toggle-select(id) => { root.select-group(id); }
                        }

                        if section-root.has-header: Rectangle {
                            width: 0px;
                            height: 0px;
                            Timer {
                                interval: 16ms;
                                running: root.reveal-group-id != ""
                                    && root.reveal-group-id == section-root.zone;
                                triggered => {
                                    grid-scroll.reveal(section-root.y, 40px);
                                    root.reveal-group-id = "";
                                }
                            }
                        }

                        if section-root.tile-count > 0: tile-area := Rectangle {
                            property <length> tile-spacing: 10px;
                            property <int> cols: max(1, Math.floor(
                                (self.width + self.tile-spacing) / (150px + self.tile-spacing)));
                            property <length> tile-w: (self.width - (self.cols - 1) * self.tile-spacing) / self.cols;
                            property <length> tile-h: 150px;

                            height: Math.ceil(section-root.tile-count / self.cols)
                                * (self.tile-h + self.tile-spacing) - self.tile-spacing;

                            for mod[i] in section: Rectangle {
                                property <int> tile-index: i - (section-root.has-header ? 1 : 0);
                                visible: !mod.is-group-header;
                                x: mod.is-group-header ? 0px : Math.mod(self.tile-index, tile-area.cols)
                                    * (tile-area.tile-w + tile-area.tile-spacing);
                                y: mod.is-group-header ? 0px : Math.floor(self.tile-index / tile-area.cols)
                                    * (tile-area.tile-h + tile-area.tile-spacing);
                                width: mod.is-group-header ? 0px : tile-area.tile-w;
                                height: mod.is-group-header ? 0px : tile-area.tile-h;

                                if !mod.is-group-header: ModCard {
                                    width: 100%;
                                    height: 100%;
                                    grid-mode: true;
                                    item: mod;
                                    drop-target: section-root.drag-highlight
                                        && mod.id != root.drag-id;
                                    toggle-select(id) => { root.select-mod(id); }
                                    rename(id, name) => { root.rename-mod(id, name); }
                                    toggle-enabled(id) => { root.toggle-mod(id); }
                                    request-delete(id, name) => { root.pending-delete-id = id; }
                                    open-link(id) => { root.open-mod-link(id); }
                                    drag-started(id, name) => {
                                        root.drag-id = id;
                                        root.drag-source-zone = mod.group-id;
                                        root.drag-name = (mod.selected && root.selected-count > 1)
                                            ? root.selected-count + " " + Tr.values[TrKey.modmanager-drag-mods-suffix]
                                            : name;
                                    }
                                    drag-moved(wx, wy) => {
                                        root.drag-pos-x = wx;
                                        root.drag-pos-y = wy;
                                    }
                                    drag-ended(wx, wy) => {
                                        if (root.grid-drag-zone-valid) {
                                            root.drop-mod-on-zone(mod.id, root.grid-drag-zone);
                                        } else if (grid-scroll.drag-inside) {
                                            root.drop-mod-on-zone(mod.id, "");
                                        }
                                        root.drag-id = "";
                                        root.drag-name = "";
                                        root.grid-drag-zone-valid = false;
                                    }
                                }
                            }
                        }
                    }

                    if root.mods-grid.length == 0: Text {
                        text: root.search-text != "" ? Tr.values[TrKey.modmanager-empty-search]
                            : root.active-filter-count > 0 ? Tr.values[TrKey.modmanager-empty-filter]
                            : Tr.values[TrKey.modmanager-empty];
                        color: #ffffff44;
                        font-size: 13px;
                        horizontal-alignment: center;
                    }
                }
            }

            if content-area.pending-root-drop: Rectangle {
                x: 12px;
                y: 4px;
                width: parent.width - 24px;
                height: parent.height - 8px;
                border-radius: 12px;
                border-width: 2px;
                border-color: #6db3f288;
                background: #6db3f208;

                Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: parent.height - 44px;
                    width: root-drop-label.preferred-width + 28px;
                    height: 32px;
                    border-radius: 8px;
                    background: #1e1e24ee;
                    border-width: 1px;
                    border-color: #6db3f288;
                    drop-shadow-color: #00000088;
                    drop-shadow-blur: 14px;

                    root-drop-label := Text {
                        text: Tr.values[TrKey.modmanager-drop-out-of-group];
                        color: Palette.text-primary;
                        font-size: 12px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    if root.file-hover: Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 16px;
        border-width: 2px;
        border-color: #6db3f2;
        background: #6db3f214;

        VerticalLayout {
            alignment: center;
            spacing: 8px;

            Text {
                text: Tr.values[TrKey.modmanager-drop-install-title];
                color: Palette.text-primary;
                font-size: 17px;
                font-weight: 700;
                horizontal-alignment: center;
            }

            Text {
                text: Tr.values[TrKey.modmanager-drop-install-subtitle];
                color: Palette.text-secondary;
                font-size: 12px;
                horizontal-alignment: center;
            }
        }
    }

    if root.drag-id != "": Rectangle {
        x: root.drag-pos-x - root.absolute-position.x + 14px;
        y: root.drag-pos-y - root.absolute-position.y + 10px;
        width: ghost-text.preferred-width + 28px;
        height: 34px;
        border-radius: 8px;
        background: #1e1e24ee;
        border-width: 1px;
        border-color: #6db3f288;
        drop-shadow-color: #00000088;
        drop-shadow-blur: 14px;

        ghost-text := Text {
            text: root.drag-name;
            color: Palette.text-primary;
            font-size: 12px;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    if root.filter-open: Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 16px;
        background: #000000aa;

        TouchArea {
            clicked => { root.filter-open = false; }
        }

        Rectangle {
            width: min(560px, parent.width - 40px);
            // Tall enough for the sections, never taller than the page
            height: min(filter-layout.preferred-height, parent.height - 60px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: #1e1e24;
            border-radius: 12px;
            border-width: 1px;
            border-color: Palette.glass-border;
            drop-shadow-color: #00000099;
            drop-shadow-blur: 30px;

            // Swallows clicks so they don't reach the backdrop
            TouchArea { }

            filter-layout := VerticalLayout {
                padding: 18px;
                spacing: 12px;

                HorizontalLayout {
                    height: 24px;
                    spacing: 8px;

                    Text {
                        horizontal-stretch: 1;
                        text: Tr.values[TrKey.modmanager-filter-title];
                        color: Palette.text-primary;
                        font-size: 15px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        width: 24px;
                        height: 24px;
                        border-radius: 6px;
                        background: filter-close-ta.has-hover ? #ffffff14 : transparent;
                        animate background { duration: 100ms; }

                        Path {
                            x: 6px;
                            y: 6px;
                            width: 12px;
                            height: 12px;
                            viewbox-x: 0;
                            viewbox-y: 0;
                            viewbox-width: 14;
                            viewbox-height: 14;
                            commands: "M1 1 L13 13 M13 1 L1 13";
                            stroke: filter-close-ta.has-hover ? #ffffffdd : #ffffff66;
                            stroke-width: 1.8px;
                            fill: transparent;
                            animate stroke { duration: 100ms; }
                        }

                        filter-close-ta := TouchArea {
                            clicked => { root.filter-open = false; }
                        }
                    }
                }

                ScrollView {
                    vertical-stretch: 1;
                    // Lets the panel size itself to the sections, and scroll
                    // once they no longer fit
                    preferred-height: filter-body.preferred-height;
                    viewport-width: self.width;
                    viewport-height: filter-body.preferred-height;

                    filter-body := HorizontalLayout {
                        spacing: 20px;
                        padding-right: 14px;

                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 16px;
                            alignment: start;

                            FilterSection {
                                title: Tr.values[TrKey.modmanager-filter-status];

                                HorizontalLayout {
                                    spacing: 6px;
                                    padding-top: 7px;

                                    StatusChip {
                                        label: Tr.values[TrKey.global-filter-all];
                                        active: root.filters.status == 0;
                                        clicked => {
                                            root.filters.status = 0;
                                            root.filters-changed(root.filters);
                                        }
                                    }

                                    StatusChip {
                                        label: Tr.values[TrKey.modmanager-filter-enabled];
                                        active: root.filters.status == 1;
                                        clicked => {
                                            root.filters.status = 1;
                                            root.filters-changed(root.filters);
                                        }
                                    }

                                    StatusChip {
                                        label: Tr.values[TrKey.modmanager-filter-disabled];
                                        active: root.filters.status == 2;
                                        clicked => {
                                            root.filters.status = 2;
                                            root.filters-changed(root.filters);
                                        }
                                    }
                                }
                            }

                            if root.filter-groups.length > 1: FilterSection {
                                title: Tr.values[TrKey.modmanager-filter-group];

                                VerticalLayout {
                                    padding-top: 7px;

                                    GroupDropdown {
                                        options: root.filter-groups;
                                        selected-id: root.filters.group-id;
                                        label: root.filter-group-label;
                                        picked(id) => {
                                            root.filters.group-id = id;
                                            root.filters-changed(root.filters);
                                        }
                                    }
                                }
                            }
                        }

                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 16px;
                            alignment: start;

                            if root.filter-characters.length > 0: FilterSection {
                                title: Tr.values[TrKey.modmanager-filter-characters];

                                for option[i] in root.filter-characters: FilterRow {
                                    option: option;
                                    checked: option.selected;
                                    show-icon: true;
                                    toggled => {
                                        root.filter-characters[i].selected = !option.selected;
                                        root.filters-changed(root.filters);
                                    }
                                }
                            }

                            if root.filter-authors.length > 0: FilterSection {
                                title: Tr.values[TrKey.modmanager-filter-authors];

                                for option[i] in root.filter-authors: FilterRow {
                                    option: option;
                                    checked: option.selected;
                                    toggled => {
                                        root.filter-authors[i].selected = !option.selected;
                                        root.filters-changed(root.filters);
                                    }
                                }
                            }
                        }
                    }
                }

                HorizontalLayout {
                    alignment: end;

                    ChipButton {
                        text: Tr.values[TrKey.modmanager-filter-clear];
                        clicked => {
                            root.filters = { status: 0, group-id: "" };
                            root.clear-filters();
                        }
                    }
                }
            }
        }
    }

    if root.naming-group: Rectangle {
        width: 100%;
        height: 100%;
        background: #000000aa;

        TouchArea {
            clicked => { root.naming-group = false; }
        }

        Rectangle {
            width: 360px;
            height: new-group-layout.preferred-height;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: #1e1e24;
            border-radius: 12px;
            border-width: 1px;
            border-color: Palette.glass-border;
            drop-shadow-color: #00000099;
            drop-shadow-blur: 30px;

            TouchArea { }

            new-group-layout := VerticalLayout {
                padding: 20px;
                spacing: 14px;

                Text {
                    text: Tr.values[TrKey.modmanager-new-group-title];
                    color: Palette.text-primary;
                    font-size: 15px;
                    font-weight: 700;
                }

                new-group-input := LineEdit {
                    height: 34px;
                    font-size: 13px;
                    placeholder-text: Tr.values[TrKey.modmanager-new-group-placeholder];
                    init => { self.focus(); }
                    accepted => { root.commit-new-group(self.text); }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;

                    ChipButton {
                        text: Tr.values[TrKey.global-popup-cancel-button];
                        clicked => { root.naming-group = false; }
                    }

                    ChipButton {
                        text: Tr.values[TrKey.global-button-create];
                        active: true;
                        clicked => { root.commit-new-group(new-group-input.text); }
                    }
                }
            }
        }
    }

    delete-dialog := PopupDialog {
        active: root.pending-delete-id != ""
            || root.pending-delete-group-id != ""
            || root.pending-delete-selected
            || root.pending-delete-selected-groups;
        title: root.pending-delete-group-id != "" ? Tr.values[TrKey.modmanager-delete-group-title]
            : root.pending-delete-selected-groups
            ? Tr.values[TrKey.modmanager-delete-selected-groups-title]
            : root.pending-delete-selected ? Tr.values[TrKey.modmanager-delete-selected-title]
            : Tr.values[TrKey.modmanager-delete-mod-title];
        message: root.pending-delete-group-id != ""
            ? Tr.values[TrKey.modmanager-delete-group-message]
            : root.pending-delete-selected-groups
            ? Tr.values[TrKey.modmanager-delete-selected-groups-message-prefix]
            + root.selected-group-count
            + Tr.values[TrKey.modmanager-delete-selected-groups-message-suffix]
            : root.pending-delete-selected
            ? Tr.values[TrKey.modmanager-delete-selected-message-prefix]
            + root.selected-count
            + Tr.values[TrKey.modmanager-delete-selected-message-suffix]
            : Tr.values[TrKey.modmanager-delete-mod-message];
        confirm => {
            if (root.pending-delete-selected-groups) {
                root.delete-selected-groups();
            } else if (root.pending-delete-selected) {
                root.delete-selected();
            } else if (root.pending-delete-group-id != "") {
                root.delete-group(root.pending-delete-group-id);
            } else if (root.pending-delete-id != "") {
                root.delete-mod(root.pending-delete-id);
            }
            root.pending-delete-id = "";
            root.pending-delete-group-id = "";
            root.pending-delete-selected = false;
            root.pending-delete-selected-groups = false;
        }
        cancel => {
            root.pending-delete-id = "";
            root.pending-delete-group-id = "";
            root.pending-delete-selected = false;
            root.pending-delete-selected-groups = false;
        }
    }
}
