import { Icons } from "../../icons.slint";
import { Palette } from "../../global.slint";
import { ScrollView } from "std-widgets.slint";
import { Languages } from "../../languages.slint";
import { Tr, TrKey } from "../../translations.slint";
import { ScrollingTextInput } from "../textfield.slint";
import { Slider } from "../slider.slint";
import { ChipButton } from "../chipbutton.slint";

export struct ThemeChoice {
    id: string,
    name: string,
    author: string,
    preview: image,
    backdrop: color,
    background-top: color,
    background-bottom: color,
    border-top: color,
    scrim-top: color,
    scrim-bottom: color,
    text-primary: color,
    text-secondary: color,
    accent: color,
    builtin: bool,
    selected: bool,
}

export struct SearchEntry {
    title: string,
    subtitle: string,
    tab: int,
    enabled: bool,
}

export struct IconPackChoice {
    id: string,
    name: string,
    selected: bool,
    tint: color,
    contrast: color,
    sample-1: image,
    sample-2: image,
    sample-3: image,
    sample-4: image,
}

component ToggleSwitch inherits Rectangle {
    in-out property <bool> checked;
    callback toggled();

    width: 40px;
    height: 22px;
    border-radius: 11px;
    background: root.checked ? Palette.success : (ta.has-hover ? Palette.fg-33 : Palette.fg-28);

    animate background { duration: 150ms; }

    Rectangle {
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: Palette.text-primary;
        drop-shadow-color: Palette.shade-40;
        drop-shadow-blur: 3px;
        drop-shadow-offset-y: 1px;
        x: root.checked ? parent.width - self.width - 3px : 3px;

        animate x {
            duration: 150ms;
            easing: ease-out;
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled();
        }
    }
}

export component Dropdown inherits Rectangle {
    in property <[string]> options: [];
    in-out property <int> selected-index: 0;
    out property <bool> opened: popup.is-open;
    in property <int> removable-from: -1;
    callback selection-changed(int);
    callback remove-requested(int);

    width: 150px;
    height: 32px;
    background: dropdown-ta.has-hover ? Palette.fg-10 : Palette.fg-08;
    border-radius: 8px;
    border-width: 1px;
    border-color: root.opened ? Palette.fg-30 : Palette.fg-18;
    animate background { duration: 100ms; }
    animate border-color { duration: 100ms; }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 10px;
        spacing: 8px;

        Text {
            horizontal-stretch: 1;
            text: root.options[root.selected-index];
            color: Palette.text-primary;
            font-size: 13px;
            vertical-alignment: center;
            overflow: elide;
        }

        VerticalLayout {
            alignment: center;
            Image {
                source: Icons.down;
                width: 14px;
                height: 14px;
                image-rendering: smooth;
                image-fit: contain;
                opacity: 0.7;
                transform-rotation: root.opened ? 180deg : 0deg;
                animate transform-rotation { duration: 150ms; easing: ease-out; }
            }
        }
    }

    dropdown-ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { popup.show(); }
    }

    popup := PopupWindow {
        x: 0px;
        y: parent.height + 4px;
        width: parent.width;

        Rectangle {
            background: Palette.surface;
            border-radius: 8px;
            border-width: 1px;
            border-color: Palette.fg-28;
            drop-shadow-color: Palette.shade-66;
            drop-shadow-blur: 16px;
            drop-shadow-offset-y: 6px;

            VerticalLayout {
                padding: 4px;
                spacing: 2px;
                for option[index] in root.options: Rectangle {
                    height: 30px;
                    border-radius: 6px;
                    background: item-ta.has-hover ? Palette.fg-10 : (index == root.selected-index ? Palette.fg-08 : transparent);

                    Text {
                        text: option;
                        x: 10px;
                        color: index == root.selected-index ? Palette.text-primary : Palette.fg-cc;
                        font-size: 13px;
                        font-weight: index == root.selected-index ? 600 : 400;
                        vertical-alignment: center;
                    }

                    item-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.selected-index = index;
                            root.selection-changed(index);
                        }
                    }

                    if root.removable-from >= 0 && index >= root.removable-from: Rectangle {
                        x: parent.width - self.width - 5px;
                        width: 20px;
                        height: 20px;
                        border-radius: 4px;
                        background: remove-ta.has-hover ? Palette.fg-18 : transparent;

                        Text {
                            text: "×";
                            color: remove-ta.has-hover ? Palette.text-primary : Palette.text-secondary;
                            font-size: 14px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        remove-ta := TouchArea {
                            clicked => { root.remove-requested(index); }
                        }
                    }
                }
            }
        }
    }
}

component TabButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> active;
    callback clicked();

    height: 42px;
    border-radius: 9px;
    background: root.active ? Palette.fg-10 : (ta.has-hover ? Palette.fg-06 : transparent);

    animate background { duration: 120ms; }

    Rectangle {
        x: 0px;
        y: (parent.height - self.height) / 2;
        width: 3px;
        height: root.active ? 18px : 0px;
        border-radius: 1.5px;
        background: Palette.accent;

        animate height { duration: 150ms; easing: ease-out; }
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 12px;
        spacing: 12px;

        VerticalLayout {
            alignment: center;
            Image {
                source: root.icon;
                width: 18px;
                height: 18px;
                image-rendering: smooth;
                image-fit: contain;
                opacity: root.active ? 1.0 : (ta.has-hover ? 0.85 : 0.55);
                animate opacity { duration: 120ms; }
            }
        }

        Text {
            horizontal-stretch: 1;
            text: root.text;
            color: (root.active || ta.has-hover) ? Palette.text-primary : Palette.text-secondary;
            font-size: 15px;
            font-weight: root.active ? 600 : 500;
            vertical-alignment: center;
            overflow: elide;

            animate color { duration: 120ms; }
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component FooterIconButton inherits Rectangle {
    in property <image> icon;
    callback clicked();

    horizontal-stretch: 1;
    height: 28px;
    border-radius: 7px;
    background: ta.pressed ? Palette.fg-18 : (ta.has-hover ? Palette.fg-12 : Palette.fg-06);

    animate background { duration: 100ms; }

    Image {
        source: root.icon;
        width: 15px;
        height: 15px;
        image-rendering: smooth;
        image-fit: contain;
        opacity: ta.has-hover ? 1.0 : 0.65;
        animate opacity { duration: 100ms; }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component SectionLabel inherits Text {
    color: Palette.text-secondary;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.6px;
}

component SectionBox inherits Rectangle {
    background: Palette.card-background;
    border-radius: 12px;
    border-width: 1px;
    border-color: Palette.glass-border;

    VerticalLayout {
        padding: 4px;
        spacing: 0px;
        @children
    }
}

component Section inherits VerticalLayout {
    in property <string> label;
    spacing: 8px;

    HorizontalLayout {
        padding-left: 4px;
        SectionLabel { text: root.label; }
    }

    SectionBox {
        @children
    }
}

component RowDivider inherits Rectangle {
    height: 1px;

    Rectangle {
        x: 14px;
        width: parent.width - 28px;
        height: 1px;
        background: Palette.fg-0e;
    }
}

component SettingRow inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <bool> clickable: false;
    in property <image> trailing-icon: Icons.down;
    in property <angle> trailing-rotation: -90deg;
    callback clicked();

    min-height: 60px;
    border-radius: 8px;
    background: (root.clickable && row-ta.has-hover) ? Palette.fg-0a : transparent;

    animate background { duration: 100ms; }

    row-ta := TouchArea {
        enabled: root.clickable;
        mouse-cursor: root.clickable ? MouseCursor.pointer : MouseCursor.default;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 20px;

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 3px;
            alignment: center;

            Text {
                text: root.title;
                color: Palette.text-primary;
                font-size: 14px;
                font-weight: 600;
            }

            if root.subtitle != "": Text {
                text: root.subtitle;
                color: Palette.fg-aa;
                font-size: 12px;
                wrap: word-wrap;
            }
        }

        HorizontalLayout {
            horizontal-stretch: 0;
            spacing: 12px;
            alignment: end;

            VerticalLayout {
                alignment: center;
                @children
            }

            if root.clickable: VerticalLayout {
                alignment: center;
                Image {
                    source: root.trailing-icon;
                    transform-rotation: root.trailing-rotation;
                    width: 14px;
                    height: 14px;
                    image-rendering: smooth;
                    image-fit: contain;
                    opacity: row-ta.has-hover ? 1.0 : 0.45;
                    animate opacity { duration: 100ms; }
                }
            }
        }
    }
}

component LinkButton inherits Rectangle {
    in property <string> text;
    callback clicked();

    height: 24px;
    border-radius: 6px;
    background: link-ta.has-hover ? Palette.fg-0c : transparent;

    animate background { duration: 100ms; }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;

        Text {
            text: root.text;
            color: link-ta.has-hover ? Palette.text-primary : Palette.text-secondary;
            font-size: 13px;
            vertical-alignment: center;

            animate color { duration: 100ms; }
        }
    }

    link-ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component CommitTextInput inherits Rectangle {
    in property <string> placeholder;
    in property <string> saved-text;
    in property <length> input-width: 290px;
    in property <int> release-token;
    in-out property <string> value;
    callback committed(string);

    private property <bool> show-saved: false;
    changed release-token => { input.clear-focus-input(); }

    function commit() {
        debounce-timer.stop();
        if (input.text != root.value) {
            root.value = input.text;
            root.committed(input.text);
            root.show-saved = true;
            saved-timer.stop();
            saved-timer.start();
        }
    }

    debounce-timer := Timer {
        interval: 850ms;
        running: false;
        triggered => { commit(); }
    }

    saved-timer := Timer {
        interval: 1500ms;
        running: false;
        triggered => {
            self.stop();
            root.show-saved = false;
        }
    }

    HorizontalLayout {
        spacing: 6px;
        alignment: end;

        VerticalLayout {
            alignment: center;
            Text {
                text: root.saved-text;
                color: Palette.success;
                font-size: 12px;
                opacity: root.show-saved ? 1.0 : 0.0;
                animate opacity { duration: 200ms; }
            }
        }

        @children

        Rectangle {
            width: root.input-width;
            height: 32px;
            border-radius: 8px;
            background: Palette.fg-08;
            border-width: 1px;
            border-color: input.input-focused ? Palette.accent : Palette.fg-18;

            animate border-color { duration: 100ms; }

            input := ScrollingTextInput {
                width: 100%;
                height: 100%;
                text-padding: 10px;
                font-size: 13px;
                text: root.value;
                placeholder: root.placeholder;

                edited(text) => {
                    debounce-timer.stop();
                    debounce-timer.start();
                }
                accepted(text) => { commit(); }
                focus-changed(focused) => {
                    if (!focused) { commit(); }
                }
            }
        }
    }
}

component CardButton inherits Rectangle {
    in property <string> text;
    callback clicked();
    min-width: 76px;
    height: 32px;
    background: card-btn-ta.pressed ? Palette.fg-18 : (card-btn-ta.has-hover ? Palette.fg-14 : Palette.fg-08);
    border-radius: 8px;
    border-width: 1px;
    border-color: card-btn-ta.has-hover ? Palette.fg-24 : Palette.fg-18;

    animate background { duration: 100ms; }
    animate border-color { duration: 100ms; }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        alignment: center;

        Text {
            text: root.text;
            color: Palette.text-primary;
            font-size: 13px;
            font-weight: 500;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    card-btn-ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component ThemeThumb inherits Rectangle {
    in property <ThemeChoice> choice;

    width: 64px;
    height: 36px;
    border-radius: 6px;
    clip: true;
    background: root.choice.backdrop;
    border-width: 1px;
    border-color: Palette.fg-18;

    Image {
        width: 100%;
        height: 100%;
        source: root.choice.preview;
        image-fit: cover;
        image-rendering: smooth;
    }

    Rectangle {
        background: @linear-gradient(180deg, root.choice.scrim-top 0%, root.choice.scrim-bottom 100%);
    }

    HorizontalLayout {
        padding: 5px;
        spacing: 3px;
        alignment: start;

        VerticalLayout {
            alignment: end;
            HorizontalLayout {
                spacing: 3px;
                for swatch in [root.choice.accent, root.choice.text-primary, root.choice.text-secondary]: Rectangle {
                    width: 7px;
                    height: 7px;
                    border-radius: 3.5px;
                    background: swatch;
                    border-width: 1px;
                    border-color: Palette.shade-44;
                }
            }
        }
    }
}

component IconPackStrip inherits Rectangle {
    in property <IconPackChoice> choice;

    height: 30px;
    border-radius: 6px;
    background: root.choice.contrast.mix(root.choice.tint, 0.92);
    border-width: 1px;
    border-color: Palette.fg-18;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;

        for sample in [root.choice.sample-1, root.choice.sample-2, root.choice.sample-3, root.choice.sample-4]: VerticalLayout {
            alignment: center;
            Image {
                source: sample;
                width: 14px;
                height: 14px;
                image-fit: contain;
                image-rendering: smooth;
            }
        }
    }
}

component ThemeCard inherits Rectangle {
    in property <ThemeChoice> choice;
    callback clicked();
    callback delete-requested();
    private property <bool> hovered: card-ta.has-hover || delete-ta.has-hover;

    height: 148px;
    border-radius: 10px;
    clip: true;
    background: root.choice.backdrop;
    border-width: root.choice.selected ? 2px : 1px;
    border-color: root.choice.selected
        ? root.choice.accent
        : (root.hovered ? Palette.fg-38 : Palette.fg-16);
    animate border-color { duration: 120ms; }
    Image {
        width: 100%;
        height: 100%;
        source: root.choice.preview;
        image-fit: cover;
        image-rendering: smooth;
    }

    Rectangle {
        width: 100%;
        height: 100%;
        background: @linear-gradient(180deg, root.choice.scrim-top 0%, root.choice.scrim-bottom 100%);
    }

    Rectangle {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 22px;
        background: @linear-gradient(180deg, root.choice.background-top 0%, root.choice.background-bottom 100%);

        Rectangle {
            x: 8px;
            y: 8px;
            width: 34px;
            height: 6px;
            border-radius: 3px;
            background: root.choice.text-primary.with-alpha(0.55);
        }
    }

    VerticalLayout {
        padding: 10px;
        padding-top: 30px;
        spacing: 6px;
        alignment: end;

        HorizontalLayout {
            spacing: 5px;
            alignment: start;
            for swatch in [
                root.choice.accent,
                root.choice.text-primary,
                root.choice.text-secondary,
            ]: Rectangle {
                width: 12px;
                height: 12px;
                border-radius: 6px;
                background: swatch;
                border-width: 1px;
                border-color: Palette.shade-44;
            }
        }
        Rectangle {
            height: label-box.preferred-height;
            border-radius: 6px;
            background: @linear-gradient(180deg, root.choice.background-top 0%, root.choice.background-bottom 100%);
            border-width: 1px;
            border-color: root.choice.border-top;

            label-box := VerticalLayout {
                padding: 7px;
                spacing: 1px;

                Text {
                    text: root.choice.name;
                    color: root.choice.text-primary;
                    font-size: 12px;
                    font-weight: 600;
                    overflow: elide;
                }

                if root.choice.author != "": Text {
                    text: Tr.values[TrKey.global-label-by] + " " + root.choice.author;
                    color: root.choice.text-secondary;
                    font-size: 10px;
                    overflow: elide;
                }
            }
        }
    }

    card-ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    Rectangle {
        x: parent.width - self.width - 6px;
        y: 6px;
        width: 20px;
        height: 20px;
        border-radius: 5px;
        background: delete-ta.has-hover ? Palette.danger : Palette.shade-99;
        opacity: (root.hovered && !root.choice.builtin) ? 1.0 : 0.0;

        animate background { duration: 100ms; }
        animate opacity { duration: 100ms; }

        Text {
            text: "×";
            color: Palette.text-primary;
            font-size: 13px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        delete-ta := TouchArea {
            enabled: !root.choice.builtin;
            mouse-cursor: pointer;
            clicked => { root.delete-requested(); }
        }
    }
}

component IconPackCard inherits Rectangle {
    in property <IconPackChoice> choice;
    callback clicked();
    height: 112px;
    border-radius: 10px;
    clip: true;
    background: Palette.surface;
    border-width: root.choice.selected ? 2px : 1px;
    border-color: root.choice.selected
        ? Palette.accent
        : (pack-ta.has-hover ? Palette.fg-38 : Palette.fg-16);
    animate border-color { duration: 120ms; }

    VerticalLayout {
        padding: 10px;
        spacing: 8px;

        // The samples sit on the colour that reads against them, so a pack of
        // pale icons previews on dark and a pack of dark icons on pale.
        Rectangle {
            height: 48px;
            border-radius: 6px;
            background: root.choice.contrast.mix(root.choice.tint, 0.92);

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                alignment: space-around;

                for sample in [
                    root.choice.sample-1,
                    root.choice.sample-2,
                    root.choice.sample-3,
                    root.choice.sample-4,
                ]: VerticalLayout {
                    alignment: center;
                    Image {
                        source: sample;
                        width: 24px;
                        height: 24px;
                        image-fit: contain;
                        image-rendering: smooth;
                    }
                }
            }
        }

        Rectangle {
            height: pack-label.preferred-height;
            border-radius: 6px;
            background: Palette.fg-0c;

            pack-label := VerticalLayout {
                padding: 6px;

                Text {
                    text: root.choice.name;
                    color: Palette.text-primary;
                    font-size: 12px;
                    font-weight: 600;
                    overflow: elide;
                }
            }
        }
    }

    pack-ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component TabPage inherits Rectangle {
    in property <bool> active;

    width: 100%;
    height: 100%;
    visible: root.opacity > 0.01;

    states [
        active-state when root.active: {
            opacity: 1.0;
            y: 0px;
            in {
                animate opacity {
                    duration: 200ms;
                    easing: ease-in-out;
                    delay: 5ms;
                }
                animate y {
                    duration: 200ms;
                    easing: ease-in-out;
                    delay: 5ms;
                }
            }
        }
        inactive-state when !root.active: {
            opacity: 0.0;
            y: 6px;
            in {
                animate opacity {
                    duration: 100ms;
                    easing: ease-in-out;
                }
                animate y {
                    duration: 100ms;
                    easing: ease-in-out;
                }
            }
        }
    ]

    @children
}

component PageScroll inherits ScrollView {
    in property <length> content-min-height;
    content-height: root.content-min-height + 24px;
}

// MAIN
export component SettingsPage inherits Rectangle {
    callback close-settings();
    in-out property <int> active-tab: 0;

    // GENERAL
    in-out property <int> language-index: 0;
    in-out property <bool> interface-minimization: false;
    in-out property <bool> discord-rpc: true;
    in-out property <bool> remember-window-size: true;

    // THEMES
    in property <[ThemeChoice]> theme-choices: [];
    in property <string> theme-name: "";
    in property <string> theme-author: "";
    callback theme-selected(string /* id */);
    callback theme-import();
    callback theme-delete(string /* id */);
    callback theme-open-folder();

    private property <bool> theme-picker-open: false;
    private property <string> theme-pending-delete: "";

    // ICON PACKS
    in property <[IconPackChoice]> icon-pack-choices: [];
    in property <string> icon-pack-name: "";
    callback icon-pack-selected(string /* id */);

    private property <bool> icon-pack-picker-open: false;

    // LAUNCHER
    callback browse-game-directory();
    in-out property <string> game-directory: "";
    in-out property <int> engine-method-index: 0;      // 0=Default 1=Alternate
    in-out property <int> start-method-index: 1;       // 0=Direct (/autoplay) 1=Manual
    in-out property <int> engine-scale: 100;           // ApplicationScale, in percent
    in property <bool> show-engine-scale: false;
    in-out property <bool> ignore-checksum: false;
    in-out property <string> launch-args: "";
    // what the current game supports, controls it cannot use are hidden
    in property <bool> engine-settings: true;
    in property <bool> start-method-choice: true;
    in property <[string]> engine-method-options: [];
    in property <[string]> start-method-options: [];

    // LINUX
    in property <bool> is-linux: false;
    in-out property <string> proton-launch-args: "";
    in-out property <bool> desktop-entry: false;
    in property <[string]> proton-versions: [];
    in-out property <int> proton-version-index: 0;     // 0=Automatic
    in property <bool> proton-version-not-recommended: false;
    in property <int> proton-builtin-count: 1;         // Automatic + installed builds
    callback browse-proton-directory();
    callback remove-proton-version(int);

    // DEVELOPER
    in-out property <bool> developer-mode: false;
    in-out property <bool> extensive-logging: false;
    callback export-telemetry();

    // ABOUT
    in property <string> app-version: "";
    in property <string> build-timestamp: "";
    callback open-link(string);
    callback copy-build-info();

    // PRIVACY
    in-out property <bool> telemetry-opt-out: false;

    // [CALLBACKS]
    callback interface-minimization-changed(bool);
    callback discord-rpc-changed(bool);
    callback remember-window-size-changed(bool);
    callback reset-window-size();
    callback add-steam-shortcut();
    callback engine-method-index-changed(int);
    callback start-method-index-changed(int);
    callback engine-scale-changed(int);
    callback ignore-checksum-changed(bool);
    callback launch-args-changed(string);
    callback developer-mode-changed(bool);
    callback extensive-logging-changed(bool);
    callback language-index-changed(int);
    callback proton-launch-args-changed(string);
    callback proton-version-index-changed(int);
    callback desktop-entry-changed(bool);
    callback telemetry-opt-out-changed(bool);

    private property <int> focus-release: 0;
    private property <length> content-max-width: 1000px;

    // SEARCH
    pure callback search-filter([SearchEntry], string) -> [SearchEntry];
    private property <string> search-query: "";
    private property <bool> searching: root.search-query != "";
    private property <[SearchEntry]> search-hits: root.searching ? root.search-filter(root.search-index, root.search-query) : [];
    private property <[SearchEntry]> search-index: [
        { title: Tr.values[TrKey.settings-theme-title], subtitle: root.theme-name, tab: 0, enabled: true },
        { title: Tr.values[TrKey.settings-icon-pack-title], subtitle: root.icon-pack-name, tab: 0, enabled: true },
        { title: Tr.values[TrKey.settings-language-title], subtitle: Tr.values[TrKey.settings-language-subtitle], tab: 0, enabled: true },
        { title: Tr.values[TrKey.settings-interface-minimization-title], subtitle: Tr.values[TrKey.settings-interface-minimization-subtitle], tab: 0, enabled: true },
        { title: Tr.values[TrKey.settings-remember-window-size-title], subtitle: Tr.values[TrKey.settings-remember-window-size-subtitle], tab: 0, enabled: true },
        { title: Tr.values[TrKey.settings-reset-window-size-title], subtitle: Tr.values[TrKey.settings-reset-window-size-subtitle], tab: 0, enabled: true },
        { title: Tr.values[TrKey.settings-discord-rpc-title], subtitle: Tr.values[TrKey.settings-discord-rpc-subtitle], tab: 0, enabled: true },
        { title: Tr.values[TrKey.settings-game-directory-title], subtitle: root.game-directory, tab: 1, enabled: true },
        { title: Tr.values[TrKey.settings-engine-method-title], subtitle: Tr.values[TrKey.settings-engine-method-subtitle], tab: 1, enabled: root.engine-settings },
        { title: Tr.values[TrKey.settings-start-method-title], subtitle: Tr.values[TrKey.settings-start-method-subtitle], tab: 1, enabled: root.start-method-choice },
        { title: Tr.values[TrKey.settings-ignore-checksum-title], subtitle: Tr.values[TrKey.settings-ignore-checksum-subtitle], tab: 1, enabled: root.engine-settings },
        { title: Tr.values[TrKey.settings-launch-args-title], subtitle: Tr.values[TrKey.settings-launch-args-subtitle], tab: 1, enabled: root.engine-settings },
        { title: Tr.values[TrKey.settings-engine-scale-title], subtitle: Tr.values[TrKey.settings-engine-scale-subtitle], tab: 1, enabled: root.engine-settings && root.show-engine-scale },
        { title: Tr.values[TrKey.settings-linux-args-title], subtitle: Tr.values[TrKey.settings-linux-args-subtitle], tab: 3, enabled: root.is-linux },
        { title: Tr.values[TrKey.settings-proton-version-title], subtitle: Tr.values[TrKey.settings-proton-version-subtitle], tab: 3, enabled: root.is-linux },
        { title: Tr.values[TrKey.settings-desktop-entry-title], subtitle: Tr.values[TrKey.settings-desktop-entry-subtitle], tab: 3, enabled: root.is-linux },
        { title: Tr.values[TrKey.settings-developer-mode-title], subtitle: Tr.values[TrKey.settings-developer-mode-subtitle], tab: 2, enabled: true },
        { title: Tr.values[TrKey.settings-export-telemetry-title], subtitle: Tr.values[TrKey.settings-export-telemetry-subtitle], tab: 2, enabled: true },
        { title: Tr.values[TrKey.settings-telemetry-opt-out-title], subtitle: Tr.values[TrKey.settings-telemetry-opt-out-subtitle], tab: 4, enabled: true },
        { title: Tr.values[TrKey.settings-about-version-title], subtitle: root.app-version, tab: 5, enabled: true },
        { title: Tr.values[TrKey.settings-about-contributors-title], subtitle: Tr.values[TrKey.settings-about-contributors-subtitle], tab: 5, enabled: true },
        { title: Tr.values[TrKey.settings-about-website-title], subtitle: "getaurora.moe", tab: 5, enabled: true },
        { title: Tr.values[TrKey.settings-about-discord-title], subtitle: "discord.gg/565jfeYsbp", tab: 5, enabled: true },
        { title: Tr.values[TrKey.settings-about-github-title], subtitle: "github.com/Daturaxoxo/Aurora", tab: 5, enabled: true },
        { title: Tr.values[TrKey.settings-about-docs-title], subtitle: "docs.getaurora.moe", tab: 5, enabled: true },
        { title: Tr.values[TrKey.settings-about-license-title], subtitle: Tr.values[TrKey.settings-about-license-subtitle], tab: 5, enabled: true },
        { title: Tr.values[TrKey.settings-about-terms-title], subtitle: Tr.values[TrKey.settings-about-terms-subtitle], tab: 5, enabled: true },
    ];

    pure function tab-name(tab: int) -> string {
        tab == 0 ? Tr.values[TrKey.settings-tab-general] :
            tab == 1 ? Tr.values[TrKey.settings-tab-launcher] :
            tab == 3 ? Tr.values[TrKey.settings-tab-linux] :
            tab == 4 ? Tr.values[TrKey.settings-tab-privacy] :
            tab == 5 ? Tr.values[TrKey.settings-tab-about] : Tr.values[TrKey.settings-tab-developer]
    }

    function release-focus() {
        root.focus-release += 1;
        key-scope.focus();
    }

    function select-tab(tab: int) {
        root.release-focus();
        root.search-query = "";
        root.active-tab = tab;
    }

    background: Palette.panel-background;
    border-radius: 16px;
    border-width: 1px;
    border-color: Palette.glass-border;
    drop-shadow-color: Palette.shadow-color;
    drop-shadow-blur: 25px;
    drop-shadow-offset-y: 10px;

    init => { key-scope.focus(); }

    key-scope := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                if (root.searching) {
                    root.search-query = "";
                } else if (root.theme-pending-delete != "") {
                    root.theme-pending-delete = "";
                } else if (root.theme-picker-open) {
                    root.theme-picker-open = false;
                } else if (root.icon-pack-picker-open) {
                    root.icon-pack-picker-open = false;
                } else {
                    root.close-settings();
                }
                return accept;
            }
            reject
        }
    }

    TouchArea {
        clicked => { root.release-focus(); }
    }

    HorizontalLayout {
        padding: 1px;
        spacing: 0px;

        // LEFT COLUMN: SIDEBAR NAVIGATION
        Rectangle {
            width: 256px;
            background: Palette.shade-33;
            border-top-left-radius: 15px;
            border-bottom-left-radius: 15px;

            VerticalLayout {
                padding: 20px;
                padding-top: 21px;
                spacing: 4px;

                HorizontalLayout {
                    height: 32px;
                    padding-left: 10px;
                    vertical-stretch: 0;

                    Text {
                        text: Tr.values[TrKey.settings-panel-title];
                        color: Palette.text-primary;
                        font-size: 24px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    height: 12px;
                    vertical-stretch: 0;
                }

                Rectangle {
                    height: 38px;
                    vertical-stretch: 0;
                    border-radius: 9px;
                    background: search-input.input-focused ? Palette.fg-0c : Palette.fg-08;
                    border-width: 1px;
                    border-color: search-input.input-focused ? Palette.fg-30 : Palette.fg-12;

                    animate background { duration: 100ms; }
                    animate border-color { duration: 100ms; }

                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 8px;
                        spacing: 10px;

                        VerticalLayout {
                            alignment: center;
                            Image {
                                source: Icons.search;
                                width: 16px;
                                height: 16px;
                                image-rendering: smooth;
                                image-fit: contain;
                                opacity: search-input.input-focused ? 0.9 : 0.55;
                            }
                        }

                        search-input := ScrollingTextInput {
                            horizontal-stretch: 1;
                            text-padding: 0px;
                            font-size: 14px;
                            text <=> root.search-query;
                            placeholder: Tr.values[TrKey.settings-search-placeholder];
                        }

                        if root.search-query != "": VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 20px;
                                height: 20px;
                                border-radius: 5px;
                                background: clear-ta.has-hover ? Palette.fg-14 : transparent;

                                Image {
                                    source: Icons.close;
                                    width: 10px;
                                    height: 10px;
                                    image-rendering: smooth;
                                    opacity: clear-ta.has-hover ? 1.0 : 0.6;
                                }

                                clear-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.search-query = ""; }
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    height: 10px;
                    vertical-stretch: 0;
                }

                TabButton {
                    text: Tr.values[TrKey.settings-tab-general];
                    icon: Icons.settings-general;
                    active: !root.searching && root.active-tab == 0;
                    clicked => { root.select-tab(0); }
                }

                TabButton {
                    text: Tr.values[TrKey.settings-tab-launcher];
                    icon: Icons.settings-launcher;
                    active: !root.searching && root.active-tab == 1;
                    clicked => { root.select-tab(1); }
                }

                if root.is-linux: TabButton {
                    text: Tr.values[TrKey.settings-tab-linux];
                    icon: Icons.settings-linux;
                    active: !root.searching && root.active-tab == 3;
                    clicked => { root.select-tab(3); }
                }

                TabButton {
                    text: Tr.values[TrKey.settings-tab-developer];
                    icon: Icons.settings-developer;
                    active: !root.searching && root.active-tab == 2;
                    clicked => { root.select-tab(2); }
                }

                Rectangle {
                    vertical-stretch: 1;
                }

                TabButton {
                    text: Tr.values[TrKey.settings-tab-privacy];
                    icon: Icons.settings-privacy;
                    active: !root.searching && root.active-tab == 4;
                    clicked => { root.select-tab(4); }
                }

                TabButton {
                    text: Tr.values[TrKey.settings-tab-about];
                    icon: Icons.settings-about;
                    active: !root.searching && root.active-tab == 5;
                    clicked => { root.select-tab(5); }
                }

                Rectangle {
                    height: 8px;
                    vertical-stretch: 0;
                }

                Rectangle {
                    vertical-stretch: 0;
                    height: app-card.preferred-height;
                    border-radius: 10px;
                    background: Palette.fg-06;
                    border-width: 1px;
                    border-color: Palette.fg-0e;

                    app-card := VerticalLayout {
                        padding: 10px;
                        spacing: 10px;

                        HorizontalLayout {
                            spacing: 10px;
                            padding-left: 2px;

                            VerticalLayout {
                                alignment: center;
                                Image {
                                    source: Icons.logo;
                                    width: 26px;
                                    height: 26px;
                                    image-fit: contain;
                                    image-rendering: smooth;
                                }
                            }

                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 1px;

                                Text {
                                    text: "Aurora";
                                    color: Palette.text-primary;
                                    font-size: 13px;
                                    font-weight: 700;
                                }

                                Text {
                                    text: root.app-version;
                                    color: Palette.text-secondary;
                                    font-size: 11px;
                                    overflow: elide;
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 6px;

                            for link in [
                                { icon: Icons.settings-website, id: "website" },
                                { icon: Icons.settings-github, id: "github" },
                                { icon: Icons.settings-changelog, id: "changelog" },
                            ]: FooterIconButton {
                                icon: link.icon;
                                clicked => { root.open-link(link.id); }
                            }
                        }
                    }
                }
            }

            Rectangle {
                x: parent.width - self.width;
                width: 1px;
                height: parent.height;
                background: Palette.fg-0e;
            }
        }

        Rectangle {
            content-column := VerticalLayout {
                x: 27px;
                y: 21px;
                width: min(parent.width - 46px, root.content-max-width + 16px);
                height: parent.height - 40px;
                spacing: 18px;

                HorizontalLayout {
                    height: 32px;
                    padding-right: 16px;
                    padding-left: 2px;

                    Text {
                        horizontal-stretch: 1;
                        text: root.searching ? Tr.values[TrKey.settings-search-title] : root.tab-name(root.active-tab);
                        color: Palette.text-primary;
                        font-size: 22px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                    TabPage {
                        active: root.searching;

                        PageScroll {
                            content-min-height: search-layout.min-height;
                            search-layout := VerticalLayout {
                                spacing: 24px;
                                alignment: start;
                                padding-right: 16px;

                                if root.search-hits.length > 0: SectionBox {
                                    for hit[i] in root.search-hits: VerticalLayout {
                                        if i > 0: RowDivider { }

                                        SettingRow {
                                            title: hit.title;
                                            subtitle: hit.subtitle;
                                            clickable: true;
                                            clicked => { root.select-tab(hit.tab); }

                                            Rectangle {
                                                height: 22px;
                                                width: hit-tab.preferred-width + 16px;
                                                border-radius: 6px;
                                                background: Palette.fg-0c;

                                                hit-tab := Text {
                                                    text: root.tab-name(hit.tab);
                                                    color: Palette.fg-cc;
                                                    font-size: 12px;
                                                    font-weight: 600;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }
                                }

                                if root.search-hits.length == 0: HorizontalLayout {
                                    padding-top: 40px;
                                    alignment: center;

                                    Text {
                                        text: Tr.values[TrKey.settings-search-empty];
                                        color: Palette.text-secondary;
                                        font-size: 13px;
                                    }
                                }

                                SettingRow {
                                    title: Tr.values[TrKey.settings-steam-shortcut-title];
                                    subtitle: Tr.values[TrKey.settings-steam-shortcut-subtitle];
                                    CardButton {
                                        text: Tr.values[TrKey.settings-steam-shortcut-button];
                                        clicked => { root.add-steam-shortcut(); }
                                    }
                                }
                            }
                        }
                    }

                    // TAB 0: GENERAL SETTINGS CONTENT
                    TabPage {
                        active: !root.searching && root.active-tab == 0;

                        PageScroll {
                            content-min-height: general-layout.min-height;
                            general-layout := VerticalLayout {
                                spacing: 24px;
                                alignment: start;
                                padding-right: 16px;

                                Section {
                                    label: Tr.values[TrKey.settings-section-appearance];

                                    SettingRow {
                                        title: Tr.values[TrKey.settings-theme-title];
                                        subtitle: root.theme-author == ""
                                            ? root.theme-name
                                            : "\{root.theme-name} · \{Tr.values[TrKey.global-label-by]} \{root.theme-author}";
                                        clickable: true;
                                        clicked => { root.release-focus(); root.theme-picker-open = true; }

                                        HorizontalLayout {
                                            spacing: 0px;
                                            for choice in root.theme-choices: HorizontalLayout {
                                                if choice.selected: ThemeThumb { choice: choice; }
                                            }
                                        }
                                    }

                                    RowDivider { }

                                    SettingRow {
                                        title: Tr.values[TrKey.settings-icon-pack-title];
                                        subtitle: root.icon-pack-name;
                                        clickable: true;
                                        clicked => { root.release-focus(); root.icon-pack-picker-open = true; }

                                        HorizontalLayout {
                                            spacing: 0px;
                                            for choice in root.icon-pack-choices: HorizontalLayout {
                                                if choice.selected: IconPackStrip { choice: choice; }
                                            }
                                        }
                                    }

                                    RowDivider { }

                                    SettingRow {
                                        title: Tr.values[TrKey.settings-language-title];
                                        subtitle: Tr.values[TrKey.settings-language-subtitle];
                                        Dropdown {
                                            options: Languages.names;
                                            selected-index <=> root.language-index;
                                            selection-changed(idx) => { root.language-index-changed(idx); }
                                        }
                                    }
                                }

                                Section {
                                    label: Tr.values[TrKey.settings-section-window];

                                    SettingRow {
                                        title: Tr.values[TrKey.settings-interface-minimization-title];
                                        subtitle: Tr.values[TrKey.settings-interface-minimization-subtitle];
                                        ToggleSwitch {
                                            checked <=> root.interface-minimization;
                                            toggled => { root.interface-minimization-changed(self.checked); }
                                        }
                                    }

                                    RowDivider { }

                                    SettingRow {
                                        title: Tr.values[TrKey.settings-remember-window-size-title];
                                        subtitle: Tr.values[TrKey.settings-remember-window-size-subtitle];
                                        ToggleSwitch {
                                            checked <=> root.remember-window-size;
                                            toggled => { root.remember-window-size-changed(self.checked); }
                                        }
                                    }

                                    RowDivider { }

                                    SettingRow {
                                        title: Tr.values[TrKey.settings-reset-window-size-title];
                                        subtitle: Tr.values[TrKey.settings-reset-window-size-subtitle];
                                        CardButton {
                                            text: Tr.values[TrKey.settings-reset-window-size-button];
                                            clicked => { root.reset-window-size(); }
                                        }
                                    }
                                }

                                Section {
                                    label: Tr.values[TrKey.settings-section-integration];

                                    SettingRow {
                                        title: Tr.values[TrKey.settings-discord-rpc-title];
                                        subtitle: Tr.values[TrKey.settings-discord-rpc-subtitle];
                                        ToggleSwitch {
                                            checked <=> root.discord-rpc;
                                            toggled => { root.discord-rpc-changed(self.checked); }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // TAB 1: LAUNCHER SETTINGS CONTENT
                    TabPage {
                        active: !root.searching && root.active-tab == 1;

                        PageScroll {
                            content-min-height: launcher-layout.min-height;
                            launcher-layout := VerticalLayout {
                                spacing: 24px;
                                alignment: start;
                                padding-right: 16px;

                                Section {
                                    label: Tr.values[TrKey.settings-section-game-directory];

                                    SettingRow {
                                        title: Tr.values[TrKey.settings-game-directory-title];
                                        subtitle: root.game-directory == "" ? Tr.values[TrKey.settings-game-directory-none] : root.game-directory;
                                        CardButton {
                                            text: Tr.values[TrKey.settings-game-directory-browse];
                                            clicked => { root.browse-game-directory(); }
                                        }
                                    }
                                }

                                if root.engine-settings || root.start-method-choice: Section {
                                    label: Tr.values[TrKey.settings-section-engine];

                                    if root.engine-settings: SettingRow {
                                        title: Tr.values[TrKey.settings-engine-method-title];
                                        subtitle: Tr.values[TrKey.settings-engine-method-subtitle];
                                        Dropdown {
                                            options: root.engine-method-options;
                                            selected-index <=> root.engine-method-index;
                                            selection-changed(idx) => { root.engine-method-index-changed(idx); }
                                        }
                                    }

                                    if root.engine-settings && root.start-method-choice: RowDivider { }

                                    if root.start-method-choice: SettingRow {
                                        title: Tr.values[TrKey.settings-start-method-title];
                                        subtitle: Tr.values[TrKey.settings-start-method-subtitle];
                                        Dropdown {
                                            options: root.start-method-options;
                                            selected-index <=> root.start-method-index;
                                            selection-changed(idx) => { root.start-method-index-changed(idx); }
                                        }
                                    }

                                    if root.engine-settings: RowDivider { }

                                    if root.engine-settings: SettingRow {
                                        title: Tr.values[TrKey.settings-ignore-checksum-title];
                                        subtitle: Tr.values[TrKey.settings-ignore-checksum-subtitle];
                                        ToggleSwitch {
                                            checked <=> root.ignore-checksum;
                                            toggled => { root.ignore-checksum-changed(self.checked); }
                                        }
                                    }
                                }

                                if root.engine-settings: Section {
                                    label: Tr.values[TrKey.settings-section-launch-arguments];

                                    SettingRow {
                                        title: Tr.values[TrKey.settings-launch-args-title];
                                        subtitle: Tr.values[TrKey.settings-launch-args-subtitle];

                                        CommitTextInput {
                                            value <=> root.launch-args;
                                            input-width: 260px;
                                            saved-text: Tr.values[TrKey.settings-launch-args-saved];
                                            release-token: root.focus-release;
                                            committed(text) => { root.launch-args-changed(text); }

                                            VerticalLayout {
                                                alignment: center;
                                                LinkButton {
                                                    text: Tr.values[TrKey.settings-launch-args-view-list];
                                                    clicked => { root.open-link("launch-arguments"); }
                                                }
                                            }
                                        }
                                    }

                                    if root.show-engine-scale: RowDivider { }

                                    if root.show-engine-scale: SettingRow {
                                        title: Tr.values[TrKey.settings-engine-scale-title];
                                        subtitle: Tr.values[TrKey.settings-engine-scale-subtitle];

                                        HorizontalLayout {
                                            spacing: 12px;
                                            alignment: end;

                                            VerticalLayout {
                                                alignment: center;
                                                Slider {
                                                    width: 160px;
                                                    minimum: 50;
                                                    maximum: 200;
                                                    step: 5;
                                                    value <=> root.engine-scale;
                                                    changed(value) => { root.engine-scale-changed(value); }
                                                }
                                            }

                                            VerticalLayout {
                                                alignment: center;
                                                Text {
                                                    width: 42px;
                                                    text: "\{root.engine-scale}%";
                                                    color: Palette.text-primary;
                                                    font-size: 13px;
                                                    font-weight: 600;
                                                    horizontal-alignment: right;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // TAB 3: LINUX SETTINGS CONTENT
                    if root.is-linux: TabPage {
                        active: !root.searching && root.active-tab == 3;

                        PageScroll {
                            content-min-height: linux-layout.min-height;
                            linux-layout := VerticalLayout {
                                spacing: 24px;
                                alignment: start;
                                padding-right: 16px;

                                Section {
                                    label: Tr.values[TrKey.settings-section-launch-options];

                                    SettingRow {
                                        title: Tr.values[TrKey.settings-linux-args-title];
                                        subtitle: Tr.values[TrKey.settings-linux-args-subtitle];

                                        CommitTextInput {
                                            value <=> root.proton-launch-args;
                                            placeholder: Tr.values[TrKey.settings-linux-args-placeholder];
                                            saved-text: Tr.values[TrKey.settings-linux-args-saved];
                                            release-token: root.focus-release;
                                            committed(text) => { root.proton-launch-args-changed(text); }
                                        }
                                    }

                                    RowDivider { }

                                    SettingRow {
                                        title: Tr.values[TrKey.settings-proton-version-title];
                                        subtitle: Tr.values[TrKey.settings-proton-version-subtitle];

                                        VerticalLayout {
                                            spacing: 6px;
                                            alignment: center;

                                            HorizontalLayout {
                                                spacing: 8px;
                                                alignment: end;

                                                Dropdown {
                                                    options: root.proton-versions;
                                                    selected-index <=> root.proton-version-index;
                                                    removable-from: root.proton-builtin-count;
                                                    selection-changed(idx) => { root.proton-version-index-changed(idx); }
                                                    remove-requested(idx) => { root.remove-proton-version(idx); }
                                                }

                                                CardButton {
                                                    text: Tr.values[TrKey.settings-proton-version-browse];
                                                    clicked => { root.browse-proton-directory(); }
                                                }
                                            }

                                            if root.proton-version-not-recommended: Text {
                                                text: Tr.values[TrKey.settings-proton-version-warning];
                                                color: Palette.warning;
                                                font-size: 12px;
                                                horizontal-alignment: right;
                                            }
                                        }
                                    }
                                }

                                Section {
                                    label: Tr.values[TrKey.settings-section-desktop-integration];

                                    SettingRow {
                                        title: Tr.values[TrKey.settings-desktop-entry-title];
                                        subtitle: Tr.values[TrKey.settings-desktop-entry-subtitle];
                                        ToggleSwitch {
                                            checked <=> root.desktop-entry;
                                            toggled => { root.desktop-entry-changed(self.checked); }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    TabPage {
                        active: !root.searching && root.active-tab == 2;

                        PageScroll {
                            content-min-height: dev-layout.min-height;
                            dev-layout := VerticalLayout {
                                spacing: 24px;
                                alignment: start;
                                padding-right: 16px;

                                Section {
                                    label: Tr.values[TrKey.settings-section-debug];

                                    SettingRow {
                                        title: Tr.values[TrKey.settings-developer-mode-title];
                                        subtitle: Tr.values[TrKey.settings-developer-mode-subtitle];
                                        ToggleSwitch {
                                            checked <=> root.developer-mode;
                                            toggled => { root.developer-mode-changed(self.checked); }
                                        }
                                    }

                                    RowDivider { }

                                    SettingRow {
                                        title: Tr.values[TrKey.settings-export-telemetry-title];
                                        subtitle: Tr.values[TrKey.settings-export-telemetry-subtitle];
                                        CardButton {
                                            text: Tr.values[TrKey.settings-export-telemetry-button];
                                            clicked => { root.export-telemetry(); }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    TabPage {
                        active: !root.searching && root.active-tab == 5;

                        PageScroll {
                            content-min-height: about-layout.min-height;
                            about-layout := VerticalLayout {
                                spacing: 24px;
                                alignment: start;
                                padding-right: 16px;

                                Section {
                                    label: Tr.values[TrKey.settings-section-software];

                                    SettingRow {
                                        title: Tr.values[TrKey.settings-about-version-title];
                                        subtitle: root.build-timestamp == ""
                                            ? Tr.values[TrKey.settings-about-build-unknown]
                                            : "\{Tr.values[TrKey.settings-about-build-deployed]} \{root.build-timestamp}";

                                        HorizontalLayout {
                                            spacing: 12px;
                                            alignment: end;

                                            VerticalLayout {
                                                alignment: center;
                                                Rectangle {
                                                    height: 22px;
                                                    width: version-text.preferred-width + 16px;
                                                    border-radius: 6px;
                                                    background: Palette.fg-0c;

                                                    version-text := Text {
                                                        text: root.app-version;
                                                        color: Palette.text-primary;
                                                        font-size: 12px;
                                                        font-weight: 600;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }

                                            CardButton {
                                                text: Tr.values[TrKey.settings-about-copy-button];
                                                clicked => { root.copy-build-info(); }
                                            }
                                        }
                                    }

                                    RowDivider { }

                                    SettingRow {
                                        title: "Daturaxoxo";
                                        subtitle: "\{Tr.values[TrKey.settings-about-role-app]} · \{Tr.values[TrKey.settings-about-role-engine]} · \{Tr.values[TrKey.settings-about-role-website]}";
                                    } // hi hi hi :3 thats me!!! thats mee!!!!!!!!!! -youknowwhoitis!

                                    RowDivider { }

                                    SettingRow {
                                        title: "Alawapr";
                                        subtitle: Tr.values[TrKey.settings-about-role-app];
                                    }

                                    RowDivider { }

                                    SettingRow {
                                        title: Tr.values[TrKey.settings-about-contributors-title];
                                        subtitle: Tr.values[TrKey.settings-about-contributors-subtitle];
                                        clickable: true;
                                        trailing-icon: Icons.link;
                                        trailing-rotation: 0deg;
                                        clicked => { root.open-link("contributors"); }
                                    }
                                }

                                // LINKS
                                Section {
                                    label: Tr.values[TrKey.settings-section-links];

                                    SettingRow {
                                        title: Tr.values[TrKey.settings-about-website-title];
                                        subtitle: "getaurora.moe";
                                        clickable: true;
                                        trailing-icon: Icons.link;
                                        trailing-rotation: 0deg;
                                        clicked => { root.open-link("website"); }
                                    }

                                    RowDivider { }

                                    SettingRow {
                                        title: Tr.values[TrKey.settings-about-discord-title];
                                        subtitle: "discord.gg/565jfeYsbp";
                                        clickable: true;
                                        trailing-icon: Icons.link;
                                        trailing-rotation: 0deg;
                                        clicked => { root.open-link("discord"); }
                                    }

                                    RowDivider { }

                                    SettingRow {
                                        title: Tr.values[TrKey.settings-about-github-title];
                                        subtitle: "github.com/Daturaxoxo/Aurora";
                                        clickable: true;
                                        trailing-icon: Icons.link;
                                        trailing-rotation: 0deg;
                                        clicked => { root.open-link("github"); }
                                    }

                                    RowDivider { }

                                    SettingRow {
                                        title: Tr.values[TrKey.settings-about-docs-title];
                                        subtitle: "docs.getaurora.moe";
                                        clickable: true;
                                        trailing-icon: Icons.link;
                                        trailing-rotation: 0deg;
                                        clicked => { root.open-link("docs"); }
                                    }
                                }

                                // LICENSE
                                Section {
                                    label: Tr.values[TrKey.settings-section-license];

                                    SettingRow {
                                        title: Tr.values[TrKey.settings-about-license-title];
                                        subtitle: Tr.values[TrKey.settings-about-license-subtitle];
                                        clickable: true;
                                        trailing-icon: Icons.link;
                                        trailing-rotation: 0deg;
                                        clicked => { root.open-link("license"); }
                                    }

                                    RowDivider { }

                                    SettingRow {
                                        title: Tr.values[TrKey.settings-about-terms-title];
                                        subtitle: Tr.values[TrKey.settings-about-terms-subtitle];
                                        clickable: true;
                                        trailing-icon: Icons.link;
                                        trailing-rotation: 0deg;
                                        clicked => { root.open-link("terms"); }
                                    }

                                    RowDivider { }

                                    HorizontalLayout {
                                        padding: 14px;
                                        Text {
                                            text: "© 2026 Aurora";
                                            color: Palette.text-secondary;
                                            font-size: 11px;
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // PRIVACY SETTINGS
                    TabPage {
                        active: !root.searching && root.active-tab == 4;

                        PageScroll {
                            content-min-height: privacy-layout.min-height;
                            privacy-layout := VerticalLayout {
                                spacing: 24px;
                                alignment: start;
                                padding-right: 16px;

                                Section {
                                    label: Tr.values[TrKey.settings-section-telemetry];

                                    SettingRow {
                                        title: Tr.values[TrKey.settings-telemetry-opt-out-title];
                                        subtitle: Tr.values[TrKey.settings-telemetry-opt-out-subtitle];
                                        ToggleSwitch {
                                            checked <=> root.telemetry-opt-out;
                                            toggled => { root.telemetry-opt-out-changed(self.checked); }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    Rectangle {
                        x: 0px;
                        y: parent.height - self.height;
                        width: parent.width - 16px;
                        height: 36px;
                        background: @linear-gradient(180deg, Palette.background-bottom.with-alpha(0) 0%, Palette.background-bottom.with-alpha(0.96) 100%);
                    }
                }
            }
        }
    }

    Rectangle {
        x: parent.width - self.width - 20px;
        y: 23px;
        width: 30px;
        height: 30px;
        border-radius: 8px;
        background: close-ta.has-hover ? Palette.fg-10 : transparent;

        animate background { duration: 100ms; }

        Image {
            source: Icons.close;
            width: 14px;
            height: 14px;
            image-rendering: smooth;
            opacity: close-ta.has-hover ? 1.0 : 0.6;
            animate opacity { duration: 100ms; }
        }

        close-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.release-focus(); root.close-settings(); }
        }
    }

    if root.theme-picker-open: Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 16px;
        background: Palette.shade-aa;

        TouchArea {
            clicked => { root.theme-picker-open = false; }
        }

        ScrollView {
            width: 100%;
            height: 100%;
            content-width: self.width;
            content-height: self.height + 1px;
        }

        Rectangle {
            property <length> chrome: 40px + 24px + 30px + 28px;

            width: min(720px, parent.width - 60px);
            height: min(parent.height - 60px, theme-grid.height + self.chrome);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Palette.surface;
            border-radius: 12px;
            border-width: 1px;
            border-color: Palette.glass-border;
            drop-shadow-color: Palette.shade-99;
            drop-shadow-blur: 30px;

            TouchArea { }

            VerticalLayout {
                padding: 20px;
                spacing: 14px;

                HorizontalLayout {
                    height: 24px;
                    spacing: 8px;

                    Text {
                        horizontal-stretch: 1;
                        text: Tr.values[TrKey.settings-theme-picker-title];
                        color: Palette.text-primary;
                        font-size: 15px;
                        font-weight: 700;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    Rectangle {
                        width: 24px;
                        height: 24px;
                        border-radius: 6px;
                        background: theme-close-ta.has-hover ? Palette.fg-14 : transparent;
                        animate background { duration: 100ms; }

                        Path {
                            x: 6px;
                            y: 6px;
                            width: 12px;
                            height: 12px;
                            viewbox-x: 0;
                            viewbox-y: 0;
                            viewbox-width: 14;
                            viewbox-height: 14;
                            commands: "M1 1 L13 13 M13 1 L1 13";
                            stroke: theme-close-ta.has-hover ? Palette.fg-dd : Palette.fg-66;
                            stroke-width: 1.8px;
                            fill: transparent;
                            animate stroke { duration: 100ms; }
                        }

                        theme-close-ta := TouchArea {
                            clicked => { root.theme-picker-open = false; }
                        }
                    }
                }

                theme-scroll := ScrollView {
                    vertical-stretch: 1;
                    content-width: self.width;
                    content-height: theme-grid.height;

                    property <length> gap: 12px;
                    property <int> cols: max(1, Math.floor((self.width + self.gap) / (200px + self.gap)));
                    property <length> cell: (self.width - (self.cols - 1) * self.gap) / self.cols;

                    theme-grid := Rectangle {
                        x: 0px;
                        y: 0px;
                        width: theme-scroll.width;
                        height: Math.ceil(root.theme-choices.length / theme-scroll.cols)
                            * (148px + theme-scroll.gap) - theme-scroll.gap;

                        for choice[i] in root.theme-choices: ThemeCard {
                            x: Math.mod(i, theme-scroll.cols) * (theme-scroll.cell + theme-scroll.gap);
                            y: Math.floor(i / theme-scroll.cols) * (148px + theme-scroll.gap);
                            width: theme-scroll.cell;
                            choice: choice;

                            clicked => {
                                root.theme-pending-delete = "";
                                root.theme-selected(choice.id);
                            }
                            delete-requested => { root.theme-pending-delete = choice.id; }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;

                    ChipButton {
                        text: Tr.values[TrKey.settings-theme-import];
                        clicked => {
                            root.theme-picker-open = false;
                            root.theme-import();
                        }
                    }

                    ChipButton {
                        text: Tr.values[TrKey.settings-theme-open-folder];
                        clicked => { root.theme-open-folder(); }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                    }

                    ChipButton {
                        text: Tr.values[TrKey.global-popup-cancel-button];
                        clicked => { root.theme-picker-open = false; }
                    }
                }
            }
        }
    }

    if root.icon-pack-picker-open: Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 16px;
        background: Palette.shade-aa;

        TouchArea {
            clicked => { root.icon-pack-picker-open = false; }
        }

        ScrollView {
            width: 100%;
            height: 100%;
            content-width: self.width;
            content-height: self.height + 1px;
        }

        Rectangle {
            property <length> chrome: 40px + 24px + 30px + 28px;

            width: min(720px, parent.width - 60px);
            height: min(parent.height - 60px, pack-grid.height + self.chrome);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Palette.surface;
            border-radius: 12px;
            border-width: 1px;
            border-color: Palette.glass-border;
            drop-shadow-color: Palette.shade-99;
            drop-shadow-blur: 30px;

            TouchArea { }

            VerticalLayout {
                padding: 20px;
                spacing: 14px;

                HorizontalLayout {
                    height: 24px;
                    spacing: 8px;

                    Text {
                        horizontal-stretch: 1;
                        text: Tr.values[TrKey.settings-icon-pack-picker-title];
                        color: Palette.text-primary;
                        font-size: 15px;
                        font-weight: 700;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    Rectangle {
                        width: 24px;
                        height: 24px;
                        border-radius: 6px;
                        background: pack-close-ta.has-hover ? Palette.fg-14 : transparent;
                        animate background { duration: 100ms; }

                        Path {
                            x: 6px;
                            y: 6px;
                            width: 12px;
                            height: 12px;
                            viewbox-x: 0;
                            viewbox-y: 0;
                            viewbox-width: 14;
                            viewbox-height: 14;
                            commands: "M1 1 L13 13 M13 1 L1 13";
                            stroke: pack-close-ta.has-hover ? Palette.fg-dd : Palette.fg-66;
                            stroke-width: 1.8px;
                            fill: transparent;
                            animate stroke { duration: 100ms; }
                        }

                        pack-close-ta := TouchArea {
                            clicked => { root.icon-pack-picker-open = false; }
                        }
                    }
                }

                pack-scroll := ScrollView {
                    vertical-stretch: 1;
                    content-width: self.width;
                    content-height: pack-grid.height;

                    property <length> gap: 12px;
                    property <int> cols: max(1, Math.floor((self.width + self.gap) / (200px + self.gap)));
                    property <length> cell: (self.width - (self.cols - 1) * self.gap) / self.cols;

                    pack-grid := Rectangle {
                        x: 0px;
                        y: 0px;
                        width: pack-scroll.width;
                        height: Math.ceil(root.icon-pack-choices.length / pack-scroll.cols)
                            * (112px + pack-scroll.gap) - pack-scroll.gap;

                        for choice[i] in root.icon-pack-choices: IconPackCard {
                            x: Math.mod(i, pack-scroll.cols) * (pack-scroll.cell + pack-scroll.gap);
                            y: Math.floor(i / pack-scroll.cols) * (112px + pack-scroll.gap);
                            width: pack-scroll.cell;
                            choice: choice;

                            clicked => { root.icon-pack-selected(choice.id); }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;

                    Rectangle {
                        horizontal-stretch: 1;
                    }

                    ChipButton {
                        text: Tr.values[TrKey.global-popup-cancel-button];
                        clicked => { root.icon-pack-picker-open = false; }
                    }
                }
            }
        }
    }

    if root.theme-pending-delete != "": Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 16px;
        background: Palette.shade-aa;

        TouchArea {
            clicked => { root.theme-pending-delete = ""; }
        }

        Rectangle {
            width: min(360px, parent.width - 60px);
            height: confirm-box.preferred-height;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Palette.surface;
            border-radius: 12px;
            border-width: 1px;
            border-color: Palette.glass-border;
            drop-shadow-color: Palette.shade-99;
            drop-shadow-blur: 30px;

            TouchArea { }

            confirm-box := VerticalLayout {
                padding: 20px;
                spacing: 14px;

                Text {
                    text: Tr.values[TrKey.settings-theme-delete-title];
                    color: Palette.text-primary;
                    font-size: 15px;
                    font-weight: 700;
                }

                Text {
                    text: Tr.values[TrKey.settings-theme-delete-message];
                    color: Palette.fg-cc;
                    font-size: 12px;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;

                    ChipButton {
                        text: Tr.values[TrKey.global-popup-cancel-button];
                        clicked => { root.theme-pending-delete = ""; }
                    }

                    ChipButton {
                        text: Tr.values[TrKey.global-button-delete];
                        danger: true;
                        clicked => {
                            root.theme-delete(root.theme-pending-delete);
                            root.theme-pending-delete = "";
                        }
                    }
                }
            }
        }
    }
}
