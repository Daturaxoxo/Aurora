import { Palette } from "../../global.slint";
import { ScrollView } from "std-widgets.slint";
import { Languages } from "../../languages.slint";
import { Tr, TrKey } from "../../translations.slint";
import { ScrollingTextInput } from "../textfield.slint";
import { Slider } from "../slider.slint";

// TOGGLE COMPONENT
component ToggleSwitch inherits Rectangle {
    in-out property <bool> checked;
    callback toggled();

    width: 44px;
    height: 24px;
    border-radius: 12px;
    background: root.checked ? #10b981 : #3f3f46;

    animate background { duration: 150ms; }

    Rectangle {
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: #ffffff;
        x: root.checked ? parent.width - self.width - 4px : 4px;

        animate x {
            duration: 150ms;
            easing: ease-out;
        }
    }

    TouchArea {
        clicked => {
            root.checked = !root.checked;
            root.toggled();
        }
    }
}

// DROPDOWN COMPONENT
export component Dropdown inherits Rectangle {
    in property <[string]> options: [];
    in-out property <int> selected-index: 0;
    out property <bool> opened: popup.is-open;

    callback selection-changed(int);

    width: 140px;
    height: 32px;
    background: @linear-gradient(180deg, #15151aed 0%, #17171beb 100%);
    border-radius: 6px;
    border-width: 1px;
    border-color: Palette.glass-border;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        alignment: space-between;

        Text {
            text: root.options[root.selected-index];
            color: Palette.text-primary;
            font-size: 13px;
            vertical-alignment: center;
        }

        VerticalLayout {
            alignment: center;
            Image {
                source: @image-url("../../../production/icons/down.png");
                width: 16px;
                height: 16px;
                image-rendering: smooth;
                image-fit: contain;
                opacity: 0.7;
            }
        }
    }

    TouchArea {
        clicked => { popup.show(); }
    }

    popup := PopupWindow {
        x: 0px;
        y: parent.height + 4px;
        width: parent.width;

        Rectangle {
            background: #1e1e24;
            border-radius: 6px;
            border-width: 1px;
            border-color: #3f3f46;

            VerticalLayout {
                padding: 4px;
                spacing: 2px;
                for option[index] in root.options: Rectangle {
                    height: 28px;
                    border-radius: 4px;
                    background: item-ta.has-hover ? #ffffff10 : transparent;

                    Text {
                        text: option;
                        x: 8px;
                        color: Palette.text-primary;
                        font-size: 13px;
                        vertical-alignment: center;
                    }

                    item-ta := TouchArea {
                        clicked => {
                            root.selected-index = index;
                            root.selection-changed(index);
                        }
                    }
                }
            }
        }
    }
}

// TAB BUTTON COMPONENT
component TabButton inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked();

    height: 38px;
    border-radius: 8px;
    background: root.active ? #ffffff0c : (ta.has-hover ? #ffffff04 : transparent);

    animate background { duration: 120ms; }

    ta := TouchArea {
        clicked => { root.clicked(); }
    }

    Text {
        text: root.text;
        x: 16px;
        color: root.active ? Palette.text-primary : (ta.has-hover ? Palette.text-primary : Palette.text-secondary);
        font-size: 14px;
        font-weight: root.active ? 600 : 400;
        vertical-alignment: center;

        animate color { duration: 120ms; }
    }
}

// SETTING CARD
component SettingCard inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;

    background: @linear-gradient(180deg, #15151aed 0%, #17171beb 100%);
    border-radius: 12px;
    border-width: 1px;
    border-color: Palette.glass-border;

    HorizontalLayout {
        padding: 16px;
        padding-right: 20px;
        alignment: space-between;

        VerticalLayout {
            spacing: 4px;
            alignment: center;

            Text {
                text: root.title;
                color: Palette.text-primary;
                font-size: 14px;
                font-weight: 600;
            }

            Text {
                text: root.subtitle;
                color: #cbd5e1;
                font-size: 12px;
                wrap: word-wrap;
            }
        }

        VerticalLayout {
            alignment: center;
            @children
        }
    }
}

component TabPage inherits Rectangle {
    in property <bool> active;

    width: 100%;
    height: 100%;
    visible: root.opacity > 0.01;

    states [
        active-state when root.active: {
            opacity: 1.0;
            y: 0px;
            in {
                animate opacity {
                    duration: 200ms;
                    easing: ease-in-out;
                    delay: 5ms;
                }
                animate y {
                    duration: 200ms;
                    easing: ease-in-out;
                    delay: 5ms;
                }
            }
        }
        inactive-state when !root.active: {
            opacity: 0.0;
            y: 6px;
            in {
                animate opacity {
                    duration: 100ms;
                    easing: ease-in-out;
                }
                animate y {
                    duration: 100ms;
                    easing: ease-in-out;
                }
            }
        }
    ]

    @children
}

// MAIN
export component SettingsPage inherits Rectangle {
    callback close-settings();
    in-out property <int> active-tab: 0;

    // GENERAL
    in-out property <int> language-index: 0;           // 0=English 1=Türkçe 2=简体中文 3=Español, ...
    in-out property <bool> interface-minimization: false;
    in-out property <bool> discord-rpc: true;

    // LAUNCHER
    callback browse-game-directory();
    in-out property <string> game-directory: "C:\\Program Files\\Neverness To Everness";
    in-out property <int> engine-method-index: 0;      // 0=Default 1=Alternate
    in-out property <int> engine-scale: 100;           // ApplicationScale, in percent
    // TODO: change this if we ever do scale for Linux
    in property <bool> show-engine-scale: !root.is-linux;
    in-out property <bool> ignore-checksum: false;

    // LINUX
    in property <bool> is-linux: false;
    in-out property <string> proton-launch-args: "";
    in-out property <bool> desktop-entry: false;
    in property <[string]> proton-versions: [];
    in-out property <int> proton-version-index: 0;     // 0=Automatic

    // DEVELOPER
    in-out property <bool> developer-mode: false;
    in-out property <bool> extensive-logging: false;
    callback export-telemetry();

    // PRIVACY
    in-out property <bool> telemetry-opt-out: false;

    // [CALLBACKS]
    callback interface-minimization-changed(bool);
    callback discord-rpc-changed(bool);
    callback engine-method-index-changed(int);
    callback engine-scale-changed(int);
    callback ignore-checksum-changed(bool);
    callback developer-mode-changed(bool);
    callback extensive-logging-changed(bool);
    callback language-index-changed(int);
    callback proton-launch-args-changed(string);
    callback proton-version-index-changed(int);
    callback desktop-entry-changed(bool);
    callback telemetry-opt-out-changed(bool);

    background: @linear-gradient(180deg, #111115ef 0%, #16161aeb 100%);
    border-radius: 16px;
    border-width: 1px;
    border-color: Palette.glass-border;
    drop-shadow-color: Palette.shadow-color;
    drop-shadow-blur: 25px;
    drop-shadow-offset-y: 10px;

    HorizontalLayout {
        padding: 24px;
        spacing: 32px;

        // LEFT COLUMN: SIDEBAR NAVIGATION
        VerticalLayout {
            width: 180px;
            spacing: 8px;

            VerticalLayout {
                // Without this the header would soak up the free space that is
                // meant to push the Privacy tab to the bottom.
                vertical-stretch: 0;
                padding-left: 8px;
                padding-bottom: 12px;
                Text {
                    text: Tr.values[TrKey.settings-panel-title];
                    color: Palette.text-secondary;
                    font-size: 11px;
                    font-weight: 700;
                }
            }

            TabButton {
                text: Tr.values[TrKey.settings-tab-general];
                active: root.active-tab == 0;
                clicked => { root.active-tab = 0; }
            }

            TabButton {
                text: Tr.values[TrKey.settings-tab-launcher];
                active: root.active-tab == 1;
                clicked => { root.active-tab = 1; }
            }

            if root.is-linux: TabButton {
                text: Tr.values[TrKey.settings-tab-linux];
                active: root.active-tab == 3;
                clicked => { root.active-tab = 3; }
            }

            TabButton {
                text: Tr.values[TrKey.settings-tab-developer];
                active: root.active-tab == 2;
                clicked => { root.active-tab = 2; }
            }

            // Pushes Privacy down to the bottom of the sidebar
            Rectangle {
                vertical-stretch: 1;
            }

            TabButton {
                text: Tr.values[TrKey.settings-tab-privacy];
                active: root.active-tab == 4;
                clicked => { root.active-tab = 4; }
            }
        }

        // RIGHT COLUMN: PAGES VIEWS CONTENT
        VerticalLayout {
            spacing: 16px;

            HorizontalLayout {
                alignment: space-between;
                padding-bottom: 4px;

                Text {
                    text: root.active-tab == 0 ? Tr.values[TrKey.settings-tab-general] :
                        root.active-tab == 1 ? Tr.values[TrKey.settings-tab-launcher] :
                        root.active-tab == 3 ? Tr.values[TrKey.settings-tab-linux] :
                        root.active-tab == 4 ? Tr.values[TrKey.settings-tab-privacy] : Tr.values[TrKey.settings-tab-developer];
                    color: Palette.text-primary;
                    font-size: 22px;
                    font-weight: 700;
                }

                Rectangle {
                    width: 28px;
                    height: 28px;
                    border-radius: 6px;
                    background: ta.has-hover ? #ffffff10 : transparent;

                    animate background { duration: 100ms; }

                    Image {
                        source: @image-url("../../../production/icons/processed/close.png");
                        width: 14px;
                        height: 14px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        opacity: ta.has-hover ? 1.0 : 0.7;
                        animate opacity { duration: 100ms; }
                    }

                    ta := TouchArea {
                        clicked => { root.close-settings(); }
                    }
                }
            }

            // LAYER STACKING BOX FOR INTERACTIVE CROSSFADE TRANSITIONS
            Rectangle {
                vertical-stretch: 1;

                // TAB 0: GENERAL SETTINGS CONTENT
                TabPage {
                    active: root.active-tab == 0;

                    ScrollView {
                        viewport-height: general-layout.min-height;
                        general-layout := VerticalLayout {
                            spacing: 24px;
                            alignment: start;

                            VerticalLayout {
                                spacing: 10px;
                                Text {
                                    text: Tr.values[TrKey.settings-section-appearance];
                                    color: Palette.text-secondary;
                                    font-size: 11px;
                                    font-weight: 700;
                                }

                                SettingCard {
                                    title: Tr.values[TrKey.settings-language-title];
                                    subtitle: Tr.values[TrKey.settings-language-subtitle];
                                    Dropdown {
                                        options: Languages.names;
                                        selected-index <=> root.language-index;
                                        selection-changed(idx) => { root.language-index-changed(idx); }
                                    }
                                }

                                SettingCard {
                                    title: Tr.values[TrKey.settings-interface-minimization-title];
                                    subtitle: Tr.values[TrKey.settings-interface-minimization-subtitle];
                                    ToggleSwitch {
                                        checked <=> root.interface-minimization;
                                        toggled => { root.interface-minimization-changed(self.checked); }
                                    }
                                }
                            }

                            VerticalLayout {
                                spacing: 10px;
                                Text {
                                    text: Tr.values[TrKey.settings-section-integration];
                                    color: Palette.text-secondary;
                                    font-size: 11px;
                                    font-weight: 700;
                                }

                                SettingCard {
                                    title: Tr.values[TrKey.settings-discord-rpc-title];
                                    subtitle: Tr.values[TrKey.settings-discord-rpc-subtitle];
                                    ToggleSwitch {
                                        checked <=> root.discord-rpc;
                                        toggled => { root.discord-rpc-changed(self.checked); }
                                    }
                                }
                            }
                        }
                    }
                }

                // TAB 1: LAUNCHER SETTINGS CONTENT
                TabPage {
                    active: root.active-tab == 1;

                    ScrollView {
                        viewport-height: launcher-layout.min-height;
                        launcher-layout := VerticalLayout {
                            spacing: 24px;
                            alignment: start;

                            VerticalLayout {
                                spacing: 10px;
                                Text {
                                    text: Tr.values[TrKey.settings-section-game-directory];
                                    color: Palette.text-secondary;
                                    font-size: 11px;
                                    font-weight: 700;
                                }

                                SettingCard {
                                    title: Tr.values[TrKey.settings-game-directory-title];
                                    subtitle: root.game-directory == "" ? Tr.values[TrKey.settings-game-directory-none] : root.game-directory;

                                    Rectangle {
                                        width: 76px;
                                        height: 32px;
                                        background: browse-ta.has-hover ? #ffffff14 : #ffffff08;
                                        border-radius: 6px;
                                        border-width: 1px;
                                        border-color: #ffffff18;

                                        animate background { duration: 100ms; }

                                        Text {
                                            text: Tr.values[TrKey.settings-game-directory-browse];
                                            color: Palette.text-primary;
                                            font-size: 13px;

                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }

                                        browse-ta := TouchArea {
                                            clicked => { root.browse-game-directory(); }
                                        }
                                    }
                                }
                            }

                            VerticalLayout {
                                spacing: 10px;
                                Text {
                                    text: Tr.values[TrKey.settings-section-engine];
                                    color: Palette.text-secondary;
                                    font-size: 11px;
                                    font-weight: 700;
                                }

                                if root.show-engine-scale: SettingCard {
                                    title: Tr.values[TrKey.settings-engine-scale-title];
                                    subtitle: Tr.values[TrKey.settings-engine-scale-subtitle];

                                    HorizontalLayout {
                                        spacing: 12px;
                                        alignment: end;

                                        VerticalLayout {
                                            alignment: center;
                                            Slider {
                                                width: 160px;
                                                minimum: 50;
                                                maximum: 200;
                                                step: 5;
                                                value <=> root.engine-scale;
                                                changed(value) => { root.engine-scale-changed(value); }
                                            }
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            Text {
                                                width: 42px;
                                                text: "\{root.engine-scale}%";
                                                color: Palette.text-primary;
                                                font-size: 13px;
                                                horizontal-alignment: right;
                                            }
                                        }
                                    }
                                }

                                SettingCard {
                                    title: Tr.values[TrKey.settings-engine-method-title];
                                    subtitle: Tr.values[TrKey.settings-engine-method-subtitle];
                                    Dropdown {
                                        options: [
                                            Tr.values[TrKey.settings-engine-method-default],
                                            Tr.values[TrKey.settings-engine-method-alternate]
                                        ];
                                        selected-index <=> root.engine-method-index;
                                        selection-changed(idx) => { root.engine-method-index-changed(idx); }
                                    }
                                }

                                SettingCard {
                                    title: Tr.values[TrKey.settings-ignore-checksum-title];
                                    subtitle: Tr.values[TrKey.settings-ignore-checksum-subtitle];
                                    ToggleSwitch {
                                        checked <=> root.ignore-checksum;
                                        toggled => { root.ignore-checksum-changed(self.checked); }
                                    }
                                }
                            }
                        }
                    }
                }

                // TAB 3: LINUX SETTINGS CONTENT (LINUX ONLY)
                if root.is-linux: TabPage {
                    active: root.active-tab == 3;

                    ScrollView {
                        viewport-height: linux-layout.min-height;
                        linux-layout := VerticalLayout {
                            spacing: 24px;
                            alignment: start;

                            VerticalLayout {
                                spacing: 10px;
                                Text {
                                    text: Tr.values[TrKey.settings-section-launch-options];
                                    color: Palette.text-secondary;
                                    font-size: 11px;
                                    font-weight: 700;
                                }

                                SettingCard {
                                    title: Tr.values[TrKey.settings-linux-args-title];
                                    subtitle: Tr.values[TrKey.settings-linux-args-subtitle];
                                    property <bool> show-saved: false;

                                    function commit-args() {
                                        debounce-timer.stop();
                                        if (args-input.text != root.proton-launch-args) {
                                            root.proton-launch-args = args-input.text;
                                            root.proton-launch-args-changed(args-input.text);
                                            self.show-saved = true;
                                            saved-timer.stop();
                                            saved-timer.start();
                                        }
                                    }

                                    debounce-timer := Timer {
                                        interval: 850ms;
                                        running: false;
                                        triggered => { commit-args(); }
                                    }

                                    saved-timer := Timer {
                                        interval: 1500ms;
                                        running: false;
                                        triggered => {
                                            self.stop();
                                            show-saved = false;
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 10px;
                                        alignment: end;

                                        VerticalLayout {
                                            alignment: center;
                                            Text {
                                                text: Tr.values[TrKey.settings-linux-args-saved];
                                                color: #10b981;
                                                font-size: 12px;
                                                opacity: show-saved ? 1.0 : 0.0;
                                                animate opacity { duration: 200ms; }
                                            }
                                        }

                                        Rectangle {
                                            width: 290px;
                                            height: 32px;
                                            border-radius: 6px;
                                            background: #ffffff08;
                                            border-width: 1px;
                                            border-color: args-input.input-focused ? #6db3f2 : #ffffff18;

                                            animate border-color { duration: 100ms; }

                                            args-input := ScrollingTextInput {
                                                width: 100%;
                                                height: 100%;
                                                text-padding: 10px;
                                                font-size: 13px;
                                                text: root.proton-launch-args;
                                                placeholder: Tr.values[TrKey.settings-linux-args-placeholder];

                                                edited(text) => {
                                                    debounce-timer.stop();
                                                    debounce-timer.start();
                                                }
                                                accepted(text) => { commit-args(); }
                                                focus-changed(focused) => {
                                                    if (!focused) { commit-args(); }
                                                }
                                            }
                                        }
                                    }
                                }

                                SettingCard {
                                    title: Tr.values[TrKey.settings-proton-version-title];
                                    subtitle: Tr.values[TrKey.settings-proton-version-subtitle];
                                    Dropdown {
                                        options: root.proton-versions;
                                        selected-index <=> root.proton-version-index;
                                        selection-changed(idx) => { root.proton-version-index-changed(idx); }
                                    }
                                }
                            }

                            VerticalLayout {
                                spacing: 10px;
                                Text {
                                    text: Tr.values[TrKey.settings-section-desktop-integration];
                                    color: Palette.text-secondary;
                                    font-size: 11px;
                                    font-weight: 700;
                                }

                                SettingCard {
                                    title: Tr.values[TrKey.settings-desktop-entry-title];
                                    subtitle: Tr.values[TrKey.settings-desktop-entry-subtitle];
                                    ToggleSwitch {
                                        checked <=> root.desktop-entry;
                                        toggled => { root.desktop-entry-changed(self.checked); }
                                    }
                                }
                            }
                        }
                    }
                }

                // TAB 2: DEVELOPER ENGINE BLOCK
                TabPage {
                    active: root.active-tab == 2;

                    ScrollView {
                        viewport-height: dev-layout.min-height;
                        dev-layout := VerticalLayout {
                            spacing: 24px;
                            alignment: start;

                            VerticalLayout {
                                spacing: 10px;
                                Text {
                                    text: Tr.values[TrKey.settings-section-debug];
                                    color: Palette.text-secondary;
                                    font-size: 11px;
                                    font-weight: 700;
                                }

                                SettingCard {
                                    title: Tr.values[TrKey.settings-developer-mode-title];
                                    subtitle: Tr.values[TrKey.settings-developer-mode-subtitle];
                                    ToggleSwitch {
                                        checked <=> root.developer-mode;
                                        toggled => { root.developer-mode-changed(self.checked); }
                                    }
                                }

                                SettingCard {
                                    title: Tr.values[TrKey.settings-export-telemetry-title];
                                    subtitle: Tr.values[TrKey.settings-export-telemetry-subtitle];

                                    Rectangle {
                                        width: 76px;
                                        height: 32px;
                                        background: export-ta.has-hover ? #ffffff14 : #ffffff08;
                                        border-radius: 6px;
                                        border-width: 1px;
                                        border-color: #ffffff18;

                                        animate background { duration: 100ms; }

                                        Text {
                                            text: Tr.values[TrKey.settings-export-telemetry-button];
                                            color: Palette.text-primary;
                                            font-size: 13px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }

                                        export-ta := TouchArea {
                                            clicked => { root.export-telemetry(); }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // TAB 4: PRIVACY SETTINGS CONTENT
                TabPage {
                    active: root.active-tab == 4;

                    ScrollView {
                        viewport-height: privacy-layout.min-height;
                        privacy-layout := VerticalLayout {
                            spacing: 24px;
                            alignment: start;

                            VerticalLayout {
                                spacing: 10px;
                                Text {
                                    text: Tr.values[TrKey.settings-section-telemetry];
                                    color: Palette.text-secondary;
                                    font-size: 11px;
                                    font-weight: 700;
                                }

                                SettingCard {
                                    title: Tr.values[TrKey.settings-telemetry-opt-out-title];
                                    subtitle: Tr.values[TrKey.settings-telemetry-opt-out-subtitle];
                                    ToggleSwitch {
                                        checked <=> root.telemetry-opt-out;
                                        toggled => { root.telemetry-opt-out-changed(self.checked); }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
