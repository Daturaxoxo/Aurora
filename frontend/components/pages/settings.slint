                                            text: Tr.values[TrKey.settings-proton-version-warning];
                                            color: Palette.warning;
                                            font-size: 12px;
                                            horizontal-alignment: right;
                                        }
                                    }
                                }
                            }

                            VerticalLayout {
                                spacing: 10px;
                                Text {
                                    text: Tr.values[TrKey.settings-section-desktop-integration];
                                    color: Palette.text-secondary;
                                    font-size: 11px;
                                    font-weight: 700;
