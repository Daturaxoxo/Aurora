import { Palette } from "../../global.slint";
import { ScrollView } from "std-widgets.slint";
import { Languages } from "../../languages.slint";
import { Tr, TrKey } from "../../translations.slint";
import { ScrollingTextInput } from "../textfield.slint";
import { Slider } from "../slider.slint";

component ToggleSwitch inherits Rectangle {
    in-out property <bool> checked;
    callback toggled();

    width: 44px;
    height: 24px;
    border-radius: 12px;
    background: root.checked ? #10b981 : #3f3f46;

    animate background { duration: 150ms; }

    Rectangle {
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: #ffffff;
        x: root.checked ? parent.width - self.width - 4px : 4px;

        animate x {
            duration: 150ms;
            easing: ease-out;
        }
    }

    TouchArea {
        clicked => {
            root.checked = !root.checked;
            root.toggled();
        }
    }
}

export component Dropdown inherits Rectangle {
    in property <[string]> options: [];
    in-out property <int> selected-index: 0;
    out property <bool> opened: popup.is-open;
    // Rows from this index on get a remove button; -1 hides them all.
    in property <int> removable-from: -1;

    callback selection-changed(int);
    callback remove-requested(int);

    width: 140px;
    height: 32px;
    background: @linear-gradient(180deg, #15151aed 0%, #17171beb 100%);
    border-radius: 6px;
    border-width: 1px;
    border-color: Palette.glass-border;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        alignment: space-between;

        Text {
            text: root.options[root.selected-index];
            color: Palette.text-primary;
            font-size: 13px;
            vertical-alignment: center;
        }

        VerticalLayout {
            alignment: center;
            Image {
                source: @image-url("../../../production/icons/down.png");
                width: 16px;
                height: 16px;
                image-rendering: smooth;
                image-fit: contain;
                opacity: 0.7;
            }
        }
    }

    TouchArea {
        clicked => { popup.show(); }
    }

    popup := PopupWindow {
        x: 0px;
        y: parent.height + 4px;
        width: parent.width;

        Rectangle {
            background: #1e1e24;
            border-radius: 6px;
            border-width: 1px;
            border-color: #3f3f46;

            VerticalLayout {
                padding: 4px;
                spacing: 2px;
                for option[index] in root.options: Rectangle {
                    height: 28px;
                    border-radius: 4px;
                    background: item-ta.has-hover ? #ffffff10 : transparent;

                    Text {
                        text: option;
                        x: 8px;
                        color: Palette.text-primary;
                        font-size: 13px;
                        vertical-alignment: center;
                    }

                    item-ta := TouchArea {
                        clicked => {
                            root.selected-index = index;
                            root.selection-changed(index);
                        }
                    }

                    if root.removable-from >= 0 && index >= root.removable-from: Rectangle {
                        x: parent.width - self.width - 4px;
                        width: 20px;
                        height: 20px;
                        border-radius: 4px;
                        background: remove-ta.has-hover ? #ffffff18 : transparent;

                        Text {
                            text: "×";
                            color: remove-ta.has-hover ? Palette.text-primary : Palette.text-secondary;
                            font-size: 14px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        remove-ta := TouchArea {
                            clicked => { root.remove-requested(index); }
                        }
                    }
                }
            }
        }
    }
}

component TabButton inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked();

    height: 38px;
    border-radius: 8px;
    background: root.active ? #ffffff0c : (ta.has-hover ? #ffffff04 : transparent);

    border-width: 1px;
    border-color: root.active
        ? Palette.glass-border
        : (ta.has-hover
            ? @linear-gradient(135deg, #ffffff1b 0%, #ffffff09 100%)
            : @linear-gradient(135deg, #ffffff12 0%, #ffffff06 100%));

    animate background { duration: 120ms; }
    animate border-color { duration: 120ms; }

    ta := TouchArea {
        clicked => { root.clicked(); }
    }

    Text {
        text: root.text;
        x: 16px;
        color: root.active ? Palette.text-primary : (ta.has-hover ? Palette.text-primary : Palette.text-secondary);
        font-size: 14px;
        font-weight: root.active ? 600 : 400;
        vertical-alignment: center;

        animate color { duration: 120ms; }
    }
}

component SettingCard inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;

    background: @linear-gradient(180deg, #15151aed 0%, #17171beb 100%);
    border-radius: 12px;
    border-width: 1px;
    border-color: Palette.glass-border;

    HorizontalLayout {
        padding: 16px;
        padding-right: 20px;
        alignment: space-between;

        VerticalLayout {
            spacing: 4px;
            alignment: center;

            Text {
                text: root.title;
                color: Palette.text-primary;
                font-size: 14px;
                font-weight: 600;
            }

            Text {
                text: root.subtitle;
                color: #cbd5e1;
                font-size: 12px;
                wrap: word-wrap;
            }
        }

        VerticalLayout {
            alignment: center;
            @children
        }
    }
}

component LinkButton inherits Rectangle {
    in property <string> text;
    callback clicked();

    height: 24px;
    border-radius: 4px;
    background: link-ta.has-hover ? #ffffff0c : transparent;

    animate background { duration: 100ms; }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;

        Text {
            text: root.text;
            color: link-ta.has-hover ? Palette.text-primary : Palette.text-secondary;
            font-size: 13px;
            vertical-alignment: center;

            animate color { duration: 100ms; }
        }
    }

    link-ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component CommitTextInput inherits Rectangle {
    in property <string> placeholder;
    in property <string> saved-text;
    in property <length> input-width: 290px;
    in property <int> release-token;
    in-out property <string> value;
    callback committed(string);

    private property <bool> show-saved: false;
    changed release-token => { input.clear-focus-input(); }

    function commit() {
        debounce-timer.stop();
        if (input.text != root.value) {
            root.value = input.text;
            root.committed(input.text);
            root.show-saved = true;
            saved-timer.stop();
            saved-timer.start();
        }
    }

    debounce-timer := Timer {
        interval: 850ms;
        running: false;
        triggered => { commit(); }
    }

    saved-timer := Timer {
        interval: 1500ms;
        running: false;
        triggered => {
            self.stop();
            root.show-saved = false;
        }
    }

    HorizontalLayout {
        spacing: 6px;
        alignment: end;

        VerticalLayout {
            alignment: center;
            Text {
                text: root.saved-text;
                color: #10b981;
                font-size: 12px;
                opacity: root.show-saved ? 1.0 : 0.0;
                animate opacity { duration: 200ms; }
            }
        }

        @children

        Rectangle {
            width: root.input-width;
            height: 32px;
            border-radius: 6px;
            background: #ffffff08;
            border-width: 1px;
            border-color: input.input-focused ? #6db3f2 : #ffffff18;

            animate border-color { duration: 100ms; }

            input := ScrollingTextInput {
                width: 100%;
                height: 100%;
                text-padding: 10px;
                font-size: 13px;
                text: root.value;
                placeholder: root.placeholder;

                edited(text) => {
                    debounce-timer.stop();
                    debounce-timer.start();
                }
                accepted(text) => { commit(); }
                focus-changed(focused) => {
                    if (!focused) { commit(); }
                }
            }
        }
    }
}

component CardButton inherits Rectangle {
    in property <string> text;
    callback clicked();
    min-width: 76px;
    height: 32px;
    background: card-btn-ta.has-hover ? #ffffff14 : #ffffff08;
    border-radius: 6px;
    border-width: 1px;
    border-color: #ffffff18;

    animate background { duration: 100ms; }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        alignment: center;

        Text {
            text: root.text;
            color: Palette.text-primary;
            font-size: 13px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    card-btn-ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

component SectionBox inherits Rectangle {
    background: @linear-gradient(180deg, #15151aed 0%, #17171beb 100%);
    border-radius: 12px;
    border-width: 1px;
    border-color: Palette.glass-border;

    VerticalLayout {
        padding: 6px;
        spacing: 0px;
        @children
    }
}

component RowDivider inherits Rectangle {
    height: 1px;
    background: #ffffff0e;
}

component InfoRow inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <bool> clickable: false;
    callback clicked();

    border-radius: 8px;
    background: (root.clickable && row-ta.has-hover) ? #ffffff0a : transparent;

    animate background { duration: 100ms; }

    row-ta := TouchArea {
        enabled: root.clickable;
        mouse-cursor: root.clickable ? MouseCursor.pointer : MouseCursor.default;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 13px;
        padding-bottom: 13px;
        spacing: 16px;
        alignment: space-between;

        VerticalLayout {
            spacing: 4px;
            alignment: center;

            Text {
                text: root.title;
                color: Palette.text-primary;
                font-size: 14px;
                font-weight: 600;
            }

            if root.subtitle != "": Text {
                text: root.subtitle;
                color: #cbd5e1;
                font-size: 12px;
                wrap: word-wrap;
            }
        }

        HorizontalLayout {
            spacing: 12px;
            alignment: end;

            VerticalLayout {
                alignment: center;
                @children
            }

            if root.clickable: VerticalLayout {
                alignment: center;
                Image {
                    source: @image-url("../../../production/icons/processed/link.png");
                    width: 14px;
                    height: 14px;
                    image-rendering: smooth;
                    image-fit: contain;
                    opacity: row-ta.has-hover ? 1.0 : 0.45;
                    animate opacity { duration: 100ms; }
                }
            }
        }
    }
}

component TabPage inherits Rectangle {
    in property <bool> active;

    width: 100%;
    height: 100%;
    visible: root.opacity > 0.01;

    states [
        active-state when root.active: {
            opacity: 1.0;
            y: 0px;
            in {
                animate opacity {
                    duration: 200ms;
                    easing: ease-in-out;
                    delay: 5ms;
                }
                animate y {
                    duration: 200ms;
                    easing: ease-in-out;
                    delay: 5ms;
                }
            }
        }
        inactive-state when !root.active: {
            opacity: 0.0;
            y: 6px;
            in {
                animate opacity {
                    duration: 100ms;
                    easing: ease-in-out;
                }
                animate y {
                    duration: 100ms;
                    easing: ease-in-out;
                }
            }
        }
    ]

    @children
}

// MAIN
export component SettingsPage inherits Rectangle {
    callback close-settings();
    in-out property <int> active-tab: 0;

    // GENERAL
    in-out property <int> language-index: 0;           // 0=English 1=Türkçe 2=简体中文 3=Español, ...
    in-out property <bool> interface-minimization: false;
    in-out property <bool> discord-rpc: true;

    // LAUNCHER
    callback browse-game-directory();
    in-out property <string> game-directory: "C:\\Program Files\\Neverness To Everness";
    in-out property <int> engine-method-index: 0;      // 0=Default 1=Alternate
    in-out property <int> start-method-index: 0;       // 0=Direct (/autoplay) 1=Manual
    in-out property <int> engine-scale: 100;           // ApplicationScale, in percent
    in property <bool> show-engine-scale: false;
    in-out property <bool> ignore-checksum: false;
    in-out property <string> launch-args: "";

    // LINUX
    in property <bool> is-linux: false;
    in-out property <string> proton-launch-args: "";
    in-out property <bool> desktop-entry: false;
    in property <[string]> proton-versions: [];
    in-out property <int> proton-version-index: 0;     // 0=Automatic
    in property <bool> proton-version-not-recommended: false;
    in property <int> proton-builtin-count: 1;         // Automatic + installed builds
    callback browse-proton-directory();
    callback remove-proton-version(int);

    // DEVELOPER
    in-out property <bool> developer-mode: false;
    in-out property <bool> extensive-logging: false;
    callback export-telemetry();

    // ABOUT
    in property <string> app-version: "";
    in property <string> build-timestamp: "";
    callback open-link(string);
    callback copy-build-info();

    // PRIVACY
    in-out property <bool> telemetry-opt-out: false;

    // [CALLBACKS]
    callback interface-minimization-changed(bool);
    callback discord-rpc-changed(bool);
    callback engine-method-index-changed(int);
    callback start-method-index-changed(int);
    callback engine-scale-changed(int);
    callback ignore-checksum-changed(bool);
    callback launch-args-changed(string);
    callback developer-mode-changed(bool);
    callback extensive-logging-changed(bool);
    callback language-index-changed(int);
    callback proton-launch-args-changed(string);
    callback proton-version-index-changed(int);
    callback desktop-entry-changed(bool);
    callback telemetry-opt-out-changed(bool);

    private property <int> focus-release: 0;

    function release-focus() {
        root.focus-release += 1;
    }

    background: @linear-gradient(180deg, #111115f8 0%, #16161af5 100%);
    border-radius: 16px;
    border-width: 1px;
    border-color: Palette.glass-border;
    drop-shadow-color: Palette.shadow-color;
    drop-shadow-blur: 25px;
    drop-shadow-offset-y: 10px;

    TouchArea {
        clicked => { root.release-focus(); }
    }

    HorizontalLayout {
        padding: 24px;
        spacing: 32px;

        // LEFT COLUMN: SIDEBAR NAVIGATION
        Rectangle {
            width: 180px;

            VerticalLayout {
                spacing: 8px;

                VerticalLayout {
                    vertical-stretch: 0;
                    padding-left: 8px;
                    padding-bottom: 12px;
                    Text {
                        text: Tr.values[TrKey.settings-panel-title];
                        color: Palette.text-secondary;
                        font-size: 11px;
                        font-weight: 700;
                    }
                }

                TabButton {
                    text: Tr.values[TrKey.settings-tab-general];
                    active: root.active-tab == 0;
                    clicked => { root.release-focus(); root.active-tab = 0; }
                }

                TabButton {
                    text: Tr.values[TrKey.settings-tab-launcher];
                    active: root.active-tab == 1;
                    clicked => { root.release-focus(); root.active-tab = 1; }
                }

                if root.is-linux: TabButton {
                    text: Tr.values[TrKey.settings-tab-linux];
                    active: root.active-tab == 3;
                    clicked => { root.release-focus(); root.active-tab = 3; }
                }

                TabButton {
                    text: Tr.values[TrKey.settings-tab-developer];
                    active: root.active-tab == 2;
                    clicked => { root.release-focus(); root.active-tab = 2; }
                }

                // Pushes About and Privacy down to the bottom of the sidebar
                Rectangle {
                    vertical-stretch: 1;
                }

                TabButton {
                    text: Tr.values[TrKey.settings-tab-privacy];
                    active: root.active-tab == 4;
                    clicked => { root.release-focus(); root.active-tab = 4; }
                }

                TabButton {
                    text: Tr.values[TrKey.settings-tab-about];
                    active: root.active-tab == 5;
                    clicked => { root.release-focus(); root.active-tab = 5; }
                }
            }

            // Separator
            Rectangle {
                x: parent.width + 15px;
                width: 1px;
                height: 100%;
                background: Palette.glass-border;
            }
        }

        // RIGHT COLUMN: PAGES VIEWS CONTENT
        VerticalLayout {
            spacing: 16px;

            HorizontalLayout {
                alignment: space-between;
                padding-bottom: 4px;

                Text {
                    text: root.active-tab == 0 ? Tr.values[TrKey.settings-tab-general] :
                        root.active-tab == 1 ? Tr.values[TrKey.settings-tab-launcher] :
                        root.active-tab == 3 ? Tr.values[TrKey.settings-tab-linux] :
                        root.active-tab == 4 ? Tr.values[TrKey.settings-tab-privacy] :
                        root.active-tab == 5 ? Tr.values[TrKey.settings-tab-about] : Tr.values[TrKey.settings-tab-developer];
                    color: Palette.text-primary;
                    font-size: 22px;
                    font-weight: 700;
                }

                Rectangle {
                    width: 28px;
                    height: 28px;
                    border-radius: 6px;
                    background: ta.has-hover ? #ffffff10 : transparent;

                    animate background { duration: 100ms; }

                    Image {
                        source: @image-url("../../../production/icons/processed/close.png");
                        width: 14px;
                        height: 14px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        opacity: ta.has-hover ? 1.0 : 0.7;
                        animate opacity { duration: 100ms; }
                    }

                    ta := TouchArea {
                        clicked => { root.release-focus(); root.close-settings(); }
                    }
                }
            }

            // LAYER STACKING BOX FOR INTERACTIVE CROSSFADE TRANSITIONS
            Rectangle {
                vertical-stretch: 1;

                // TAB 0: GENERAL SETTINGS CONTENT
                TabPage {
                    active: root.active-tab == 0;

                    ScrollView {
                        viewport-height: general-layout.min-height;
                        general-layout := VerticalLayout {
                            spacing: 24px;
                            alignment: start;

                            VerticalLayout {
                                spacing: 10px;
                                Text {
                                    text: Tr.values[TrKey.settings-section-appearance];
                                    color: Palette.text-secondary;
                                    font-size: 11px;
                                    font-weight: 700;
                                }

                                SettingCard {
                                    title: Tr.values[TrKey.settings-language-title];
                                    subtitle: Tr.values[TrKey.settings-language-subtitle];
                                    Dropdown {
                                        options: Languages.names;
                                        selected-index <=> root.language-index;
                                        selection-changed(idx) => { root.language-index-changed(idx); }
                                    }
                                }

                                SettingCard {
                                    title: Tr.values[TrKey.settings-interface-minimization-title];
                                    subtitle: Tr.values[TrKey.settings-interface-minimization-subtitle];
                                    ToggleSwitch {
                                        checked <=> root.interface-minimization;
                                        toggled => { root.interface-minimization-changed(self.checked); }
                                    }
                                }
                            }

                            VerticalLayout {
                                spacing: 10px;
                                Text {
                                    text: Tr.values[TrKey.settings-section-integration];
                                    color: Palette.text-secondary;
                                    font-size: 11px;
                                    font-weight: 700;
                                }

                                SettingCard {
                                    title: Tr.values[TrKey.settings-discord-rpc-title];
                                    subtitle: Tr.values[TrKey.settings-discord-rpc-subtitle];
                                    ToggleSwitch {
                                        checked <=> root.discord-rpc;
                                        toggled => { root.discord-rpc-changed(self.checked); }
                                    }
                                }
                            }
                        }
                    }
                }

                // TAB 1: LAUNCHER SETTINGS CONTENT
                TabPage {
                    active: root.active-tab == 1;

                    ScrollView {
                        viewport-height: launcher-layout.min-height;
                        launcher-layout := VerticalLayout {
                            spacing: 24px;
                            alignment: start;

                            VerticalLayout {
                                spacing: 10px;
                                Text {
                                    text: Tr.values[TrKey.settings-section-game-directory];
                                    color: Palette.text-secondary;
                                    font-size: 11px;
                                    font-weight: 700;
                                }

                                SettingCard {
                                    title: Tr.values[TrKey.settings-game-directory-title];
                                    subtitle: root.game-directory == "" ? Tr.values[TrKey.settings-game-directory-none] : root.game-directory;

                                    Rectangle {
                                        width: 76px;
                                        height: 32px;
                                        background: browse-ta.has-hover ? #ffffff14 : #ffffff08;
                                        border-radius: 6px;
                                        border-width: 1px;
                                        border-color: #ffffff18;

                                        animate background { duration: 100ms; }

                                        Text {
                                            text: Tr.values[TrKey.settings-game-directory-browse];
                                            color: Palette.text-primary;
                                            font-size: 13px;

                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }

                                        browse-ta := TouchArea {
                                            clicked => { root.browse-game-directory(); }
                                        }
                                    }
                                }
                            }

                            VerticalLayout {
                                spacing: 10px;
                                Text {
                                    text: Tr.values[TrKey.settings-section-engine];
                                    color: Palette.text-secondary;
                                    font-size: 11px;
                                    font-weight: 700;
                                }

                                SettingCard {
                                    title: Tr.values[TrKey.settings-engine-method-title];
                                    subtitle: Tr.values[TrKey.settings-engine-method-subtitle];
                                    Dropdown {
                                        options: [
                                            Tr.values[TrKey.settings-engine-method-default],
                                            Tr.values[TrKey.settings-engine-method-alternate]
                                        ];
                                        selected-index <=> root.engine-method-index;
                                        selection-changed(idx) => { root.engine-method-index-changed(idx); }
                                    }
                                }

                                SettingCard {
                                    title: Tr.values[TrKey.settings-start-method-title];
                                    subtitle: Tr.values[TrKey.settings-start-method-subtitle];
                                    Dropdown {
                                        options: [
                                            Tr.values[TrKey.settings-start-method-direct],
                                            Tr.values[TrKey.settings-start-method-manual]
                                        ];
                                        selected-index <=> root.start-method-index;
                                        selection-changed(idx) => { root.start-method-index-changed(idx); }
                                    }
                                }

                                SettingCard {
                                    title: Tr.values[TrKey.settings-ignore-checksum-title];
                                    subtitle: Tr.values[TrKey.settings-ignore-checksum-subtitle];
                                    ToggleSwitch {
                                        checked <=> root.ignore-checksum;
                                        toggled => { root.ignore-checksum-changed(self.checked); }
                                    }
                                }
                            }

                            VerticalLayout {
                                spacing: 10px;
                                Text {
                                    text: Tr.values[TrKey.settings-section-launch-arguments];
                                    color: Palette.text-secondary;
                                    font-size: 11px;
                                    font-weight: 700;
                                }

                                SettingCard {
                                    title: Tr.values[TrKey.settings-launch-args-title];
                                    subtitle: Tr.values[TrKey.settings-launch-args-subtitle];

                                    CommitTextInput {
                                        value <=> root.launch-args;
                                        saved-text: Tr.values[TrKey.settings-launch-args-saved];
                                        release-token: root.focus-release;
                                        committed(text) => { root.launch-args-changed(text); }

                                        VerticalLayout {
                                            alignment: center;
                                            LinkButton {
                                                text: Tr.values[TrKey.settings-launch-args-view-list];
                                                clicked => { root.open-link("launch-arguments"); }
                                            }
                                        }
                                    }
                                }

                                if root.show-engine-scale: SettingCard {
                                    title: Tr.values[TrKey.settings-engine-scale-title];
                                    subtitle: Tr.values[TrKey.settings-engine-scale-subtitle];

                                    HorizontalLayout {
                                        spacing: 12px;
                                        alignment: end;

                                        VerticalLayout {
                                            alignment: center;
                                            Slider {
                                                width: 160px;
                                                minimum: 50;
                                                maximum: 200;
                                                step: 5;
                                                value <=> root.engine-scale;
                                                changed(value) => { root.engine-scale-changed(value); }
                                            }
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            Text {
                                                width: 42px;
                                                text: "\{root.engine-scale}%";
                                                color: Palette.text-primary;
                                                font-size: 13px;
                                                horizontal-alignment: right;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // TAB 3: LINUX SETTINGS CONTENT (LINUX ONLY)
                if root.is-linux: TabPage {
                    active: root.active-tab == 3;

                    ScrollView {
                        viewport-height: linux-layout.min-height;
                        linux-layout := VerticalLayout {
                            spacing: 24px;
                            alignment: start;

                            VerticalLayout {
                                spacing: 10px;
                                Text {
                                    text: Tr.values[TrKey.settings-section-launch-options];
                                    color: Palette.text-secondary;
                                    font-size: 11px;
                                    font-weight: 700;
                                }

                                SettingCard {
                                    title: Tr.values[TrKey.settings-linux-args-title];
                                    subtitle: Tr.values[TrKey.settings-linux-args-subtitle];

                                    CommitTextInput {
                                        value <=> root.proton-launch-args;
                                        placeholder: Tr.values[TrKey.settings-linux-args-placeholder];
                                        saved-text: Tr.values[TrKey.settings-linux-args-saved];
                                        release-token: root.focus-release;
                                        committed(text) => { root.proton-launch-args-changed(text); }
                                    }
                                }

                                SettingCard {
                                    title: Tr.values[TrKey.settings-proton-version-title];
                                    subtitle: Tr.values[TrKey.settings-proton-version-subtitle];

                                    VerticalLayout {
                                        spacing: 6px;
                                        alignment: center;

                                        HorizontalLayout {
                                            spacing: 8px;
                                            alignment: end;

                                            Dropdown {
                                                width: 140px;
                                                options: root.proton-versions;
                                                selected-index <=> root.proton-version-index;
                                                removable-from: root.proton-builtin-count;
                                                selection-changed(idx) => { root.proton-version-index-changed(idx); }
                                                remove-requested(idx) => { root.remove-proton-version(idx); }
                                            }

                                            CardButton {
                                                text: Tr.values[TrKey.settings-proton-version-browse];
                                                clicked => { root.browse-proton-directory(); }
                                            }
                                        }

                                        if root.proton-version-not-recommended: Text {
                                            text: Tr.values[TrKey.settings-proton-version-warning];
                                            color: #f59e0b;
                                            font-size: 12px;
                                            horizontal-alignment: right;
                                        }
                                    }
                                }
                            }

                            VerticalLayout {
                                spacing: 10px;
                                Text {
                                    text: Tr.values[TrKey.settings-section-desktop-integration];
                                    color: Palette.text-secondary;
                                    font-size: 11px;
                                    font-weight: 700;
                                }

                                SettingCard {
                                    title: Tr.values[TrKey.settings-desktop-entry-title];
                                    subtitle: Tr.values[TrKey.settings-desktop-entry-subtitle];
                                    ToggleSwitch {
                                        checked <=> root.desktop-entry;
                                        toggled => { root.desktop-entry-changed(self.checked); }
                                    }
                                }
                            }
                        }
                    }
                }

                // TAB 2: DEVELOPER ENGINE BLOCK
                TabPage {
                    active: root.active-tab == 2;

                    ScrollView {
                        viewport-height: dev-layout.min-height;
                        dev-layout := VerticalLayout {
                            spacing: 24px;
                            alignment: start;

                            VerticalLayout {
                                spacing: 10px;
                                Text {
                                    text: Tr.values[TrKey.settings-section-debug];
                                    color: Palette.text-secondary;
                                    font-size: 11px;
                                    font-weight: 700;
                                }

                                SettingCard {
                                    title: Tr.values[TrKey.settings-developer-mode-title];
                                    subtitle: Tr.values[TrKey.settings-developer-mode-subtitle];
                                    ToggleSwitch {
                                        checked <=> root.developer-mode;
                                        toggled => { root.developer-mode-changed(self.checked); }
                                    }
                                }

                                SettingCard {
                                    title: Tr.values[TrKey.settings-export-telemetry-title];
                                    subtitle: Tr.values[TrKey.settings-export-telemetry-subtitle];

                                    Rectangle {
                                        width: 76px;
                                        height: 32px;
                                        background: export-ta.has-hover ? #ffffff14 : #ffffff08;
                                        border-radius: 6px;
                                        border-width: 1px;
                                        border-color: #ffffff18;

                                        animate background { duration: 100ms; }

                                        Text {
                                            text: Tr.values[TrKey.settings-export-telemetry-button];
                                            color: Palette.text-primary;
                                            font-size: 13px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }

                                        export-ta := TouchArea {
                                            clicked => { root.export-telemetry(); }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                TabPage {
                    active: root.active-tab == 5;
                    ScrollView {
                        viewport-height: about-layout.min-height;
                        about-layout := VerticalLayout {
                            spacing: 24px;
                            alignment: start;
                            padding-right: 16px;

                            // APP + AUTHORS
                            VerticalLayout {
                                spacing: 10px;
                                Text {
                                    text: Tr.values[TrKey.settings-section-software];
                                    color: Palette.text-secondary;
                                    font-size: 11px;
                                    font-weight: 700;
                                }

                                SectionBox {
                                    InfoRow {
                                        title: Tr.values[TrKey.settings-about-version-title];
                                        subtitle: root.build-timestamp == ""
                                            ? Tr.values[TrKey.settings-about-build-unknown]
                                            : "\{Tr.values[TrKey.settings-about-build-deployed]} \{root.build-timestamp}";

                                        HorizontalLayout {
                                            spacing: 12px;
                                            alignment: end;

                                            VerticalLayout {
                                                alignment: center;
                                                Text {
                                                    text: root.app-version;
                                                    color: Palette.text-primary;
                                                    font-size: 13px;
                                                    font-weight: 600;
                                                    horizontal-alignment: right;
                                                }
                                            }

                                            CardButton {
                                                text: Tr.values[TrKey.settings-about-copy-button];
                                                clicked => { root.copy-build-info(); }
                                            }
                                        }
                                    }

                                    RowDivider { }

                                    InfoRow {
                                        title: "Daturaxoxo";
                                        subtitle: "\{Tr.values[TrKey.settings-about-role-app]} · \{Tr.values[TrKey.settings-about-role-engine]} · \{Tr.values[TrKey.settings-about-role-website]}";
                                    } // hi hi hi :3 thats me!!! thats mee!!!!!!!!!! -youknowwhoitis!

                                    RowDivider { }

                                    InfoRow {
                                        title: "Alawapr";
                                        subtitle: Tr.values[TrKey.settings-about-role-app];
                                    }

                                    RowDivider { }

                                    InfoRow {
                                        title: Tr.values[TrKey.settings-about-contributors-title];
                                        subtitle: Tr.values[TrKey.settings-about-contributors-subtitle];
                                        clickable: true;
                                        clicked => { root.open-link("contributors"); }
                                    }
                                }
                            }

                            // LINKS
                            VerticalLayout {
                                spacing: 10px;
                                Text {
                                    text: Tr.values[TrKey.settings-section-links];
                                    color: Palette.text-secondary;
                                    font-size: 11px;
                                    font-weight: 700;
                                }

                                SectionBox {
                                    InfoRow {
                                        title: Tr.values[TrKey.settings-about-website-title];
                                        subtitle: "getaurora.moe";
                                        clickable: true;
                                        clicked => { root.open-link("website"); }
                                    }

                                    RowDivider { }

                                    InfoRow {
                                        title: Tr.values[TrKey.settings-about-discord-title];
                                        subtitle: "discord.gg/565jfeYsbp";
                                        clickable: true;
                                        clicked => { root.open-link("discord"); }
                                    }

                                    RowDivider { }

                                    InfoRow {
                                        title: Tr.values[TrKey.settings-about-github-title];
                                        subtitle: "github.com/Daturaxoxo/Aurora";
                                        clickable: true;
                                        clicked => { root.open-link("github"); }
                                    }

                                    RowDivider { }

                                    InfoRow {
                                        title: Tr.values[TrKey.settings-about-docs-title];
                                        subtitle: "docs.getaurora.moe";
                                        clickable: true;
                                        clicked => { root.open-link("docs"); }
                                    }
                                }
                            }

                            // LICENSE
                            VerticalLayout {
                                spacing: 10px;
                                Text {
                                    text: Tr.values[TrKey.settings-section-license];
                                    color: Palette.text-secondary;
                                    font-size: 11px;
                                    font-weight: 700;
                                }

                                SectionBox {
                                    InfoRow {
                                        title: Tr.values[TrKey.settings-about-license-title];
                                        subtitle: Tr.values[TrKey.settings-about-license-subtitle];
                                        clickable: true;
                                        clicked => { root.open-link("license"); }
                                    }

                                    RowDivider { }

                                    InfoRow {
                                        title: Tr.values[TrKey.settings-about-terms-title];
                                        subtitle: Tr.values[TrKey.settings-about-terms-subtitle];
                                        clickable: true;
                                        clicked => { root.open-link("terms"); }
                                    }

                                    RowDivider { }

                                    HorizontalLayout {
                                        padding: 14px;
                                        Text {
                                            text: "© 2026 Aurora";
                                            color: Palette.text-secondary;
                                            font-size: 11px;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // PRIVACY SETTINGS
                TabPage {
                    active: root.active-tab == 4;

                    ScrollView {
                        viewport-height: privacy-layout.min-height;
                        privacy-layout := VerticalLayout {
                            spacing: 24px;
                            alignment: start;

                            VerticalLayout {
                                spacing: 10px;
                                Text {
                                    text: Tr.values[TrKey.settings-section-telemetry];
                                    color: Palette.text-secondary;
                                    font-size: 11px;
                                    font-weight: 700;
                                }

                                SettingCard {
                                    title: Tr.values[TrKey.settings-telemetry-opt-out-title];
                                    subtitle: Tr.values[TrKey.settings-telemetry-opt-out-subtitle];
                                    ToggleSwitch {
                                        checked <=> root.telemetry-opt-out;
                                        toggled => { root.telemetry-opt-out-changed(self.checked); }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}