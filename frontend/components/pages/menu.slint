import { Palette } from "../../global.slint";
import { Tr, TrKey } from "../../translations.slint";

struct MenuItem {
    id: int,
    name: string,
    icon: image,
    disabled: bool,
}

export component MenuPage inherits Rectangle {
    callback close-menu();
    callback menu-item-clicked(int);

    in property <[MenuItem]> items: [
        {
            id: 0,
            name: Tr.values[TrKey.menu-item-screenshots],
            icon: @image-url("../../../production/icons/menu/camera.png")
        },
        {
            id: 2,
            name: Tr.values[TrKey.menu-item-lua],
            icon: @image-url("../../../production/icons/menu/lua.png")
        },
        {
            id: 3,
            name: Tr.values[TrKey.menu-item-modules],
            icon: @image-url("../../../production/icons/menu/modules.png")
        },
        {
            id: 4,
            name: Tr.values[TrKey.menu-item-addons],
            icon: @image-url("../../../production/icons/menu/addons.png")
        },
    ];
    background: #00000066;

    TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.close-menu(); }
    }

    panel := Rectangle {
        width: 480px;
        height: panel-layout.preferred-height;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Palette.glass-background;
        border-radius: 16px;
        border-width: 1px;
        border-color: Palette.glass-border;
        drop-shadow-color: #00000099;
        drop-shadow-blur: 40px;
        drop-shadow-offset-y: 12px;

        TouchArea {
            width: 100%;
            height: 100%;
        }

        panel-layout := VerticalLayout {
            x: 0px;
            y: 0px;
            width: parent.width;
            padding: 24px;
            spacing: 20px;

            // Header
            HorizontalLayout {
                alignment: space-between;

                VerticalLayout {
                    alignment: center;
                    Text {
                        text: Tr.values[TrKey.menu-title];
                        color: #ffffff;
                        font-size: 17px;
                        font-weight: 700;
                    }
                }

                close-btn := Rectangle {
                    width: 30px;
                    height: 30px;
                    border-radius: 6px;
                    background: close-ta.has-hover ? #ffffff16 : transparent;
                    animate background { duration: 120ms; }

                    Image {
                        source: @image-url("../../../production/icons/close.png");
                        width: 18px;
                        height: 18px;
                        image-rendering: smooth;
                        image-fit: contain;
                        opacity: close-ta.has-hover ? 1.0 : 0.6;
                        animate opacity { duration: 120ms; }
                    }

                    close-ta := TouchArea {
                        clicked => { root.close-menu(); }
                    }
                }
            }

            // Divider
            Rectangle {
                height: 1px;
                background: Palette.glass-border;
            }

            // Grid
            HorizontalLayout {
                spacing: 12px;

                VerticalLayout {
                    min-width: 0px;
                    preferred-width: 0px;
                    horizontal-stretch: 1;
                    spacing: 12px;
                    for i in [0, 2]: Rectangle {
                        height: 100px;
                        visible: i < root.items.length;
                        background: root.items[i].disabled ? #ffffff05 : (ta-left.has-hover ? #ffffff12 : #ffffff08);
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: !root.items[i].disabled && ta-left.has-hover ? #ffffff28 : Palette.glass-border;
                        animate background { duration: 120ms; }
                        animate border-color { duration: 120ms; }

                        ta-left := TouchArea {
                            enabled: i < root.items.length && !root.items[i].disabled;
                            clicked => { root.menu-item-clicked(root.items[i].id); }
                        }

                        VerticalLayout {
                            alignment: center;
                            spacing: 8px;
                            padding: 16px;

                            HorizontalLayout {
                                alignment: center;
                                Image {
                                    source: root.items[i].icon;
                                    width: 32px;
                                    height: 32px;
                                    image-rendering: smooth;
                                    image-fit: contain;
                                    opacity: root.items[i].disabled ? 0.35 : (ta-left.has-hover ? 1.0 : 0.8);
                                    animate opacity { duration: 120ms; }
                                }
                            }

                            Text {
                                text: root.items[i].name;
                                color: root.items[i].disabled ? #ffffff66 : #ffffffdd;
                                font-size: 13px;
                                font-weight: 600;
                                horizontal-alignment: center;
                            }

                            if root.items[i].disabled: Text {
                                text: "Coming Soon";
                                color: #ffffff55;
                                font-size: 10px;
                                font-weight: 600;
                                letter-spacing: 0.5px;
                                horizontal-alignment: center;
                            }
                        }
                    }
                }

                VerticalLayout {
                    min-width: 0px;
                    preferred-width: 0px;
                    horizontal-stretch: 1;
                    spacing: 12px;
                    for i in [1, 3]: Rectangle {
                        height: 100px;
                        visible: i < root.items.length;
                        background: root.items[i].disabled ? #ffffff05 : (ta-right.has-hover ? #ffffff12 : #ffffff08);
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: !root.items[i].disabled && ta-right.has-hover ? #ffffff28 : Palette.glass-border;
                        animate background { duration: 120ms; }
                        animate border-color { duration: 120ms; }

                        ta-right := TouchArea {
                            enabled: i < root.items.length && !root.items[i].disabled;
                            clicked => { root.menu-item-clicked(root.items[i].id); }
                        }

                        VerticalLayout {
                            alignment: center;
                            spacing: 8px;
                            padding: 16px;

                            HorizontalLayout {
                                alignment: center;
                                Image {
                                    source: root.items[i].icon;
                                    width: 32px;
                                    height: 32px;
                                    image-rendering: smooth;
                                    image-fit: contain;
                                    opacity: root.items[i].disabled ? 0.35 : (ta-right.has-hover ? 1.0 : 0.8);
                                    animate opacity { duration: 120ms; }
                                }
                            }

                            Text {
                                text: root.items[i].name;
                                color: root.items[i].disabled ? #ffffff66 : #ffffffdd;
                                font-size: 13px;
                                font-weight: 600;
                                horizontal-alignment: center;
                            }

                            if root.items[i].disabled: Text {
                                text: "Coming Soon";
                                color: #ffffff55;
                                font-size: 10px;
                                font-weight: 600;
                                letter-spacing: 0.5px;
                                horizontal-alignment: center;
                            }
                        }
                    }
                }
            }
        }
    }
}
