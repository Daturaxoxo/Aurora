import { Palette } from "../../../global.slint";
import { ScrollView, TextEdit } from "std-widgets.slint";
import { Tr, TrKey } from "../../../translations.slint";

export struct LuaScriptItem {
    id: string,
    name: string,
    enabled: bool,
    is-editing: bool,
    code: string,
}

// Holds Lua-script state and callbacks in a global singleton rather than as
// local properties on LuaScriptsPage. Globals are reachable from Rust via
// `window.global::<LuaScriptsAdapter>()` no matter where LuaScriptsPage ends
// up nested in the tree, so we don't need to thread properties/callbacks
// through whatever parent component instantiates it.
export global LuaScriptsAdapter {
    in-out property <[LuaScriptItem]> scripts: [];

    // Whether `\Bin\ue4ss` was found on disk. Set by Rust on startup.
    in-out property <bool> ue4ss-installed: false;

    // Whether the UE4SS debug console is enabled. Mirrors
    // GuiConsoleEnabled/GuiConsoleVisible in UE4SS-settings.ini.
    in-out property <bool> debug-enabled: false;

    // Driven by Rust while the download/extract is in progress.
    in-out property <bool> installing: false;
    in-out property <int> install-progress: 0; // 0-100
    in-out property <string> install-status: "";
    in-out property <string> install-error: "";

    callback create-script();
    callback toggle-script(string);
    callback rename-script(string, string);
    callback delete-script(string);
    callback save-script-code(string /* id */, string /* code */);
    callback install-ue4ss();
    callback refresh();
    callback toggle-debug();

    // Set by Rust (e.g. when a rename to a reserved name is rejected) to
    // surface a transient toast in the UI. Cleared automatically after a
    // few seconds by a Timer in LuaScriptsPage.
    in-out property <string> toast-message: "";
}

export component LuaScriptsPage inherits Rectangle {
    callback close-lua-scripts();

    // Id/index of the script currently open in the editor overlay ("" / -1 = none open).
    property <string> editing-script-id: "";
    property <int> editing-index: -1;
    property <string> editor-draft: "";

    // Id of the script whose name is currently being renamed inline ("" = none).
    property <string> renaming-script-id: "";
    property <string> rename-draft: "";

    function open-editor(id: string, idx: int) {
        root.editing-script-id = id;
        root.editing-index = idx;
        root.editor-draft = LuaScriptsAdapter.scripts[idx].code;
    }

    function close-editor() {
        root.editing-script-id = "";
        root.editing-index = -1;
        root.editor-draft = "";
    }

    function start-rename(id: string, current-name: string) {
        root.renaming-script-id = id;
        root.rename-draft = current-name;
    }

    function commit-rename() {
        if (root.rename-draft != "") {
            LuaScriptsAdapter.rename-script(root.renaming-script-id, root.rename-draft);
        }
        root.renaming-script-id = "";
        root.rename-draft = "";
    }

    function cancel-rename() {
        root.renaming-script-id = "";
        root.rename-draft = "";
    }

    background: #00000066;

    TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.close-lua-scripts(); }
    }

    panel := Rectangle {
        width: min(parent.width - 80px, 900px);
        height: parent.height - 60px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Palette.glass-background;
        border-radius: 16px;
        border-width: 1px;
        border-color: Palette.glass-border;
        drop-shadow-color: #00000099;
        drop-shadow-blur: 40px;
        drop-shadow-offset-y: 12px;
        clip: true;

        TouchArea {
            width: 100%;
            height: 100%;
        }

        VerticalLayout {
            padding: 24px;
            spacing: 16px;

            HorizontalLayout {
                alignment: space-between;
                height: 32px;

                VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;

                        Image {
                            source: @image-url("../../../../production/icons/menu/lua.png");
                            width: 20px;
                            height: 20px;
                            image-rendering: smooth;
                            image-fit: contain;
                            colorize: Palette.text-primary;
                        }

                        Text {
                            text: Tr.values[TrKey.menu-item-lua];
                            color: Palette.text-primary;
                            font-size: 17px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;

                    refresh-rect := Rectangle {
                        width: 30px;
                        height: 30px;
                        border-radius: 6px;
                        background: refresh-ta.has-hover ? #ffffff16 : transparent;
                        animate background { duration: 120ms; }

                        Image {
                            source: @image-url("../../../../production/icons/refresh.png");
                            width: 16px;
                            height: 16px;
                            image-rendering: smooth;
                            image-fit: contain;
                            colorize: Palette.text-primary;
                            opacity: refresh-ta.has-hover ? 1.0 : 0.6;
                            animate opacity { duration: 120ms; }
                        }

                        refresh-ta := TouchArea {
                            clicked => { LuaScriptsAdapter.refresh(); }
                        }
                    }

                    close-btn := Rectangle {
                        width: 30px;
                        height: 30px;
                        border-radius: 6px;
                        background: close-ta.has-hover ? #ffffff16 : transparent;
                        animate background { duration: 120ms; }

                        Image {
                            source: @image-url("../../../../production/icons/close.png");
                            width: 22px;
                            height: 22px;
                            image-rendering: smooth;
                            image-fit: contain;
                            opacity: close-ta.has-hover ? 1.0 : 0.6;
                            animate opacity { duration: 120ms; }
                        }

                        close-ta := TouchArea {
                            clicked => { root.close-lua-scripts(); }
                        }
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: Palette.glass-border;
            }

            Rectangle {
                vertical-stretch: 1;
                background: transparent;

                // ---------------------------------------------------------
                // {A} Pre-install screen — shown when UE4SS is not detected
                // ---------------------------------------------------------
                if !LuaScriptsAdapter.ue4ss-installed: VerticalLayout {
                    alignment: center;
                    spacing: 20px;
                    padding: 24px;

                    HorizontalLayout {
                        alignment: center;

                        Rectangle {
                            width: 64px;
                            height: 64px;
                            border-radius: 32px;
                            background: Palette.glass-border;

                            Image {
                                source: @image-url("../../../../production/icons/menu/lua.png");
                                width: 30px;
                                height: 30px;
                                image-rendering: smooth;
                                image-fit: contain;
                                colorize: Palette.text-primary;
                            }
                        }
                    }

                    Text {
                        text: Tr.values[TrKey.lua-install-title];
                        color: Palette.text-primary;
                        font-size: 16px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        width: 100%;
                    }

                    HorizontalLayout {
                        alignment: center;

                        Text {
                            text: Tr.values[TrKey.lua-install-description];
                            color: Palette.text-secondary;
                            font-size: 13px;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                            width: 420px;
                        }
                    }

                    HorizontalLayout {
                        alignment: center;

                        Rectangle {
                            width: 320px;
                            height: 68px;
                            border-radius: 10px;
                            background: #ffffff0d;
                            border-width: 1px;
                            border-color: Palette.glass-border;

                            HorizontalLayout {
                                padding: 14px;
                                spacing: 20px;

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 2px;
                                    Text {
                                        text: Tr.values[TrKey.lua-install-download-size];
                                        color: Palette.text-secondary;
                                        font-size: 11px;
                                    }
                                    Text {
                                        text: "~16.0 MB";
                                        color: Palette.text-primary;
                                        font-size: 14px;
                                        font-weight: 600;
                                    }
                                }

                                Rectangle { width: 1px; background: Palette.glass-border; }

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 2px;
                                    Text {
                                        text: Tr.values[TrKey.lua-install-location];
                                        color: Palette.text-secondary;
                                        font-size: 11px;
                                    }
                                    Text {
                                        text: "\\Aurora\\Bin";
                                        color: Palette.text-primary;
                                        font-size: 14px;
                                        font-weight: 600;
                                    }
                                }
                            }
                        }
                    }

                    if LuaScriptsAdapter.install-error != "": HorizontalLayout {
                        alignment: center;
                        Text {
                            text: LuaScriptsAdapter.install-error;
                            color: #ee4937;
                            font-size: 12px;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                            width: 380px;
                        }
                    }

                    if LuaScriptsAdapter.installing: VerticalLayout {
                        spacing: 8px;

                        HorizontalLayout {
                            alignment: center;
                            Text {
                                text: LuaScriptsAdapter.install-status + " (" + LuaScriptsAdapter.install-progress + "%)";
                                color: Palette.text-secondary;
                                font-size: 12px;
                            }
                        }

                        HorizontalLayout {
                            alignment: center;
                            Rectangle {
                                width: 320px;
                                height: 6px;
                                border-radius: 3px;
                                background: #ffffff16;
                                clip: true;

                                Rectangle {
                                    x: 0;
                                    width: parent.width * LuaScriptsAdapter.install-progress / 100;
                                    height: 100%;
                                    border-radius: 3px;
                                    background: #3b82f6;
                                    animate width { duration: 150ms; }
                                }
                            }
                        }
                    }

                    if !LuaScriptsAdapter.installing: HorizontalLayout {
                        alignment: center;
                        spacing: 12px;
                        height: 40px;

                        cancel-btn := Rectangle {
                            width: 120px;
                            border-radius: 8px;
                            background: cancel-ta.has-hover ? #ffffff16 : #ffffff0d;
                            border-width: 1px;
                            border-color: Palette.glass-border;
                            animate background { duration: 120ms; }

                            Text {
                                text: Tr.values[TrKey.global-popup-cancel-button];
                                color: Palette.text-primary;
                                font-size: 13px;
                                font-weight: 600;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            cancel-ta := TouchArea {
                                clicked => { root.close-lua-scripts(); }
                            }
                        }

                        install-btn := Rectangle {
                            width: 120px;
                            border-radius: 8px;
                            background: install-ta.has-hover ? #3b82f6dd : #3b82f6;
                            animate background { duration: 120ms; }

                            Text {
                                text: Tr.values[TrKey.global-button-install];
                                color: #ffffff;
                                font-size: 13px;
                                font-weight: 600;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            install-ta := TouchArea {
                                clicked => {
                                    LuaScriptsAdapter.install-error = "";
                                    LuaScriptsAdapter.install-ue4ss();
                                }
                            }
                        }
                    }
                }

                // ---------------------------------------------------------
                // {B} Main Lua Scripts page — script list + code editor
                // ---------------------------------------------------------
                if LuaScriptsAdapter.ue4ss-installed: VerticalLayout {
                    spacing: 14px;

                    // Toolbar
                    HorizontalLayout {
                        height: 28px;
                        spacing: 8px;

                        new-script-pill := Rectangle {
                            height: 28px;
                            width: new-script-row.preferred-width + 24px;
                            border-radius: 7px;
                            border-width: 1px;
                            border-color: new-script-ta.has-hover ? #ffffff28 : #ffffff16;
                            background: new-script-ta.has-hover ? #ffffff12 : #ffffff08;
                            animate background { duration: 100ms; }
                            animate border-color { duration: 100ms; }

                            new-script-ta := TouchArea {
                                clicked => { LuaScriptsAdapter.create-script(); }
                            }

                            new-script-row := HorizontalLayout {
                                x: 12px;
                                y: 0px;
                                height: parent.height;
                                width: self.preferred-width;
                                spacing: 7px;
                                alignment: center;

                                VerticalLayout {
                                    alignment: center;
                                    Path {
                                        width: 12px;
                                        height: 12px;
                                        viewbox-x: 0;
                                        viewbox-y: 0;
                                        viewbox-width: 12;
                                        viewbox-height: 12;
                                        commands: "M6 1 L6 11 M1 6 L11 6";
                                        stroke: #ffffffbb;
                                        stroke-width: 1.6px;
                                        fill: transparent;
                                    }
                                }

                                Text {
                                    text: Tr.values[TrKey.lua-new-script];
                                    color: #ffffffcc;
                                    font-size: 12px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        Rectangle { horizontal-stretch: 1; }

                        // Debug console toggle
                        HorizontalLayout {
                            horizontal-stretch: 0;
                            spacing: 6px;

                            VerticalLayout {
                                horizontal-stretch: 0;
                                alignment: center;
                                Text {
                                    text: Tr.values[TrKey.lua-debugging];
                                    color: Palette.text-secondary;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                }
                            }

                            VerticalLayout {
                                horizontal-stretch: 0;
                                alignment: center;
                                Rectangle {
                                    width: 30px;
                                    height: 17px;
                                    border-radius: 8.5px;
                                    background: LuaScriptsAdapter.debug-enabled ? #3b82f6 : #ffffff22;
                                    animate background { duration: 120ms; }

                                    Rectangle {
                                        x: LuaScriptsAdapter.debug-enabled ? parent.width - self.width - 2px : 2px;
                                        y: 2px;
                                        width: 13px;
                                        height: 13px;
                                        border-radius: 6.5px;
                                        background: #ffffff;
                                        animate x { duration: 120ms; }
                                    }

                                    debug-toggle-ta := TouchArea {
                                        clicked => { LuaScriptsAdapter.toggle-debug(); }
                                    }
                                }
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: LuaScriptsAdapter.scripts.length + " "
                                    + (LuaScriptsAdapter.scripts.length == 1
                                    ? Tr.values[TrKey.lua-script-count-singular]
                                    : Tr.values[TrKey.lua-script-count-plural]);
                                color: Palette.text-secondary;
                                font-size: 12px;
                            }
                        }
                    }

                    // Script list
                    Rectangle {
                        vertical-stretch: 1;

                        if LuaScriptsAdapter.scripts.length == 0: VerticalLayout {
                            alignment: center;
                            Text {
                                text: Tr.values[TrKey.lua-empty];
                                color: Palette.text-secondary;
                                font-size: 13px;
                                horizontal-alignment: center;
                            }
                        }

                        if LuaScriptsAdapter.scripts.length > 0: ScrollView {
                            VerticalLayout {
                                spacing: 8px;

                                for script[idx] in LuaScriptsAdapter.scripts: Rectangle {
                                    height: 44px;
                                    border-radius: 8px;
                                    border-width: 1px;
                                    border-color: row-hovered ? #ffffff38 : #ffffff24;
                                    background: row-hovered
                                        ? @linear-gradient(180deg, #ffffff1e 0%, #ffffff10 100%)
                                        : @linear-gradient(180deg, #ffffff16 0%, #ffffff0a 100%);
                                    animate border-color { duration: 120ms; }

                                    property <bool> row-hovered: row-ta.has-hover || rename-ta.has-hover
                                        || edit-ta.has-hover || delete-ta.has-hover;

                                    row-ta := TouchArea {
                                        clicked => { root.open-editor(script.id, idx); }
                                    }

                                    HorizontalLayout {
                                        padding-left: 14px;
                                        padding-right: 14px;
                                        spacing: 10px;

                                        VerticalLayout {
                                            alignment: center;
                                            Image {
                                                source: @image-url("../../../../production/icons/menu/lua.png");
                                                width: 16px;
                                                height: 16px;
                                                image-rendering: smooth;
                                                image-fit: contain;
                                                colorize: Palette.text-secondary;
                                            }
                                        }

                                        if root.renaming-script-id != script.id: Text {
                                            text: script.name;
                                            color: Palette.text-primary;
                                            font-size: 13px;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }

                                        if root.renaming-script-id == script.id: VerticalLayout {
                                            alignment: center;
                                            Rectangle {
                                                width: 160px;
                                                height: 24px;
                                                border-radius: 5px;
                                                background: #ffffff12;
                                                border-width: 1px;
                                                border-color: #3b82f6;

                                                rename-input := TextInput {
                                                    x: 6px;
                                                    width: parent.width - 12px;
                                                    height: parent.height;
                                                    text <=> root.rename-draft;
                                                    color: Palette.text-primary;
                                                    font-size: 13px;
                                                    font-weight: 700;
                                                    vertical-alignment: center;
                                                    init => { self.focus(); }
                                                    accepted => { root.commit-rename(); }
                                                    changed has-focus => {
                                                        if (!self.has-focus) {
                                                            root.commit-rename();
                                                        }
                                                    }
                                                }
                                            }
                                        }

                                        // Rename button
                                        VerticalLayout {
                                            alignment: center;
                                            Rectangle {
                                                width: 26px;
                                                height: 26px;
                                                border-radius: 6px;
                                                background: rename-ta.has-hover ? #ffffff16 : transparent;
                                                animate background { duration: 100ms; }

                                                Path {
                                                    x: 6.5px;
                                                    y: 6.5px;
                                                    width: 13px;
                                                    height: 13px;
                                                    viewbox-x: 0;
                                                    viewbox-y: 0;
                                                    viewbox-width: 12;
                                                    viewbox-height: 12;
                                                    commands: "M1 11 L1 8 L8 1 L11 4 L4 11 Z M7 2 L10 5";
                                                    stroke: rename-ta.has-hover ? #ffffffdd : #ffffff66;
                                                    stroke-width: 1.3px;
                                                    fill: transparent;
                                                    animate stroke { duration: 100ms; }
                                                }

                                                rename-ta := TouchArea {
                                                    clicked => { root.start-rename(script.id, script.name); }
                                                }
                                            }
                                        }

                                        Rectangle { horizontal-stretch: 1; }

                                        // Edit button
                                        VerticalLayout {
                                            alignment: center;
                                            Rectangle {
                                                width: 26px;
                                                height: 26px;
                                                border-radius: 6px;
                                                background: edit-ta.has-hover ? #ffffff16 : transparent;
                                                animate background { duration: 100ms; }

                                                Image {
                                                    source: @image-url("../../../../production/icons/edit.png");
                                                    width: 13px;
                                                    height: 13px;
                                                    image-rendering: smooth;
                                                    image-fit: contain;
                                                    colorize: edit-ta.has-hover ? #ffffffdd : #ffffff66;
                                                    animate colorize { duration: 100ms; }
                                                }

                                                edit-ta := TouchArea {
                                                    clicked => { root.open-editor(script.id, idx); }
                                                }
                                            }
                                        }

                                        // Delete button
                                        VerticalLayout {
                                            alignment: center;
                                            Rectangle {
                                                width: 26px;
                                                height: 26px;
                                                border-radius: 6px;
                                                background: delete-ta.has-hover ? #ee493722 : transparent;
                                                animate background { duration: 100ms; }

                                                Image {
                                                    source: @image-url("../../../../production/icons/delete.png");
                                                    width: 13px;
                                                    height: 13px;
                                                    image-rendering: smooth;
                                                    image-fit: contain;
                                                    colorize: delete-ta.has-hover ? #ee4937 : #ffffff66;
                                                    animate colorize { duration: 100ms; }
                                                }

                                                delete-ta := TouchArea {
                                                    clicked => { LuaScriptsAdapter.delete-script(script.id); }
                                                }
                                            }
                                        }

                                        // Enable/disable toggle
                                        VerticalLayout {
                                            alignment: center;
                                            Rectangle {
                                                width: 34px;
                                                height: 20px;
                                                border-radius: 10px;
                                                background: script.enabled ? #3b82f6 : #ffffff22;
                                                animate background { duration: 120ms; }

                                                Rectangle {
                                                    x: script.enabled ? parent.width - self.width - 2px : 2px;
                                                    y: 2px;
                                                    width: 16px;
                                                    height: 16px;
                                                    border-radius: 8px;
                                                    background: #ffffff;
                                                    animate x { duration: 120ms; }
                                                }

                                                toggle-ta := TouchArea {
                                                    clicked => { LuaScriptsAdapter.toggle-script(script.id); }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // ---------------------------------------------------------
                // {B} Code editor overlay — shown when a script is open
                // ---------------------------------------------------------
                if LuaScriptsAdapter.ue4ss-installed && root.editing-script-id != "": Rectangle {
                    background: #101014f2;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: Palette.glass-border;
                    drop-shadow-color: #00000099;
                    drop-shadow-blur: 24px;

                    TouchArea {
                        width: 100%;
                        height: 100%;
                    }

                    VerticalLayout {
                        padding: 16px;
                        spacing: 12px;

                        HorizontalLayout {
                            height: 24px;
                            spacing: 8px;

                            Text {
                                text: root.editing-index >= 0
                                    ? LuaScriptsAdapter.scripts[root.editing-index].name
                                    : "";
                                color: Palette.text-primary;
                                font-size: 14px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }

                            Rectangle { horizontal-stretch: 1; }

                            close-editor-btn := Rectangle {
                                width: 24px;
                                height: 24px;
                                border-radius: 6px;
                                background: close-editor-ta.has-hover ? #ffffff16 : transparent;
                                animate background { duration: 120ms; }

                                Image {
                                    source: @image-url("../../../../production/icons/close.png");
                                    width: 16px;
                                    height: 16px;
                                    image-rendering: smooth;
                                    image-fit: contain;
                                    opacity: close-editor-ta.has-hover ? 1.0 : 0.6;
                                    animate opacity { duration: 120ms; }
                                }

                                close-editor-ta := TouchArea {
                                    clicked => { root.close-editor(); }
                                }
                            }
                        }

                        Rectangle {
                            vertical-stretch: 1;
                            border-radius: 8px;
                            background: #00000040;
                            border-width: 1px;
                            border-color: Palette.glass-border;
                            clip: true;

                            code-editor := TextEdit {
                                width: 100%;
                                height: 100%;
                                font-size: 13px;
                                wrap: no-wrap;
                                init => {
                                    self.text = root.editor-draft;
                                }
                                edited => {
                                    root.editor-draft = self.text;
                                }
                            }
                        }

                        HorizontalLayout {
                            alignment: end;
                            spacing: 10px;
                            height: 36px;

                            cancel-edit-btn := Rectangle {
                                width: 110px;
                                border-radius: 8px;
                                background: cancel-edit-ta.has-hover ? #ffffff16 : #ffffff0d;
                                border-width: 1px;
                                border-color: Palette.glass-border;
                                animate background { duration: 120ms; }

                                Text {
                                    text: Tr.values[TrKey.global-popup-cancel-button];
                                    color: Palette.text-primary;
                                    font-size: 13px;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                cancel-edit-ta := TouchArea {
                                    clicked => { root.close-editor(); }
                                }
                            }

                            save-edit-btn := Rectangle {
                                width: 110px;
                                border-radius: 8px;
                                background: save-edit-ta.has-hover ? #3b82f6dd : #3b82f6;
                                animate background { duration: 120ms; }

                                Text {
                                    text: Tr.values[TrKey.global-button-save];
                                    color: #ffffff;
                                    font-size: 13px;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                save-edit-ta := TouchArea {
                                    clicked => {
                                        LuaScriptsAdapter.save-script-code(root.editing-script-id, root.editor-draft);
                                        root.close-editor();
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        Timer {
            interval: 3000ms;
            running: LuaScriptsAdapter.toast-message != "";
            triggered => { LuaScriptsAdapter.toast-message = ""; }
        }

        if LuaScriptsAdapter.toast-message != "": Rectangle {
            x: (panel.width - self.width) / 2;
            y: panel.height - self.height - 24px;
            height: 40px;
            width: toast-text.preferred-width + 32px;
            border-radius: 8px;
            background: #1a1a1eee;
            border-width: 1px;
            border-color: #ee4937;
            drop-shadow-color: #00000099;
            drop-shadow-blur: 16px;

            toast-text := Text {
                text: LuaScriptsAdapter.toast-message;
                color: Palette.text-primary;
                font-size: 12px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}
