import { Palette } from "../../../global.slint";
import { LineEdit, ScrollView } from "std-widgets.slint";
import { Dropdown } from "../settings.slint";
import { ChipButton } from "../../chipbutton.slint";
import { Tr, TrKey } from "../../../translations.slint";

export struct ScreenshotItem {
    file_name: string,
    date: string,
    image: image,
    favorite: bool,
    selected: bool,
}

// Button overlaid on thumbnails / the preview
component OverlayButton inherits Rectangle {
    in property <image> icon;
    in property <length> icon-size: 15px;
    in property <color> hover-color: #ffffff;
    out property <bool> hovering: ta.has-hover;
    callback clicked();

    width: 30px;
    height: 30px;
    border-radius: 8px;
    background: ta.has-hover ? #000000dd : #00000099;
    border-width: 1px;
    border-color: #ffffff20;
    animate background { duration: 120ms; }

    Image {
        source: root.icon;
        width: root.icon-size;
        height: root.icon-size;
        image-rendering: smooth;
        image-fit: contain;
        colorize: ta.has-hover ? root.hover-color : #ffffffcc;
        animate colorize { duration: 120ms; }
    }

    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

component CopyButton inherits Rectangle {
    in property <int> state: 0; // 0 = idle, 1 = copying, 2 = copied, 3 = failed
    out property <bool> hovering: ta.has-hover;
    callback clicked();

    property <bool> busy: root.state == 1;
    property <bool> done: root.state == 2;
    property <bool> failed: root.state == 3;

    width: 30px;
    height: 30px;
    border-radius: 8px;
    background: root.done ? #22c55edd
        : root.failed ? #ef4444dd
        : (ta.pressed ? #000000ff : (ta.has-hover ? #000000dd : #00000099));
    border-width: 1px;
    border-color: root.done ? #22c55e : (root.failed ? #ef4444 : #ffffff20);
    animate background, border-color { duration: 140ms; }

    property <bool> pulse: false;
    Timer {
        interval: 350ms;
        running: root.busy;
        triggered => { root.pulse = !root.pulse; }
    }

    property <bool> pop: false;
    property <bool> arm-pop: false;

    changed state => {
        root.pop = false;
        root.arm-pop = root.state >= 2;
    }

    Timer {
        interval: 16ms;
        running: root.arm-pop;
        triggered => {
            root.arm-pop = false;
            root.pop = true;
        }
    }

    // Clipboard (idle / copying)
    if root.state <= 1: Path {
        width: 15px;
        height: 15px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M9 3 L21 3 L21 15 L15 15 M3 9 L15 9 L15 21 L3 21 Z";
        stroke: ta.has-hover ? #ffffff : #ffffffcc;
        stroke-width: 2px;
        fill: transparent;
        opacity: (root.busy && root.pulse) ? 0.3 : 1.0;
        animate opacity { duration: 350ms; easing: ease-in-out; }
    }

    // Checkmark (copied)
    if root.done: Path {
        width: root.pop ? 15px : 3px;
        height: self.width * 12 / 15;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 15;
        viewbox-height: 12;
        commands: "M1 6 L5.5 10.5 L14 1.5";
        stroke: #ffffff;
        stroke-width: 2px;
        fill: transparent;
        animate width { duration: 260ms; easing: ease-out-back; }
    }

    // Cross (failed)
    if root.failed: Path {
        width: root.pop ? 13px : 3px;
        height: self.width;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 14;
        viewbox-height: 14;
        commands: "M2 2 L12 12 M12 2 L2 12";
        stroke: #ffffff;
        stroke-width: 2px;
        fill: transparent;
        animate width { duration: 260ms; easing: ease-out-back; }
    }

    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

// Star button
component FavoriteButton inherits Rectangle {
    in property <bool> favorite;
    out property <bool> hovering: ta.has-hover;
    callback clicked();

    width: 30px;
    height: 30px;
    border-radius: 8px;
    background: ta.has-hover ? #000000dd : #00000099;
    border-width: 1px;
    border-color: #ffffff20;
    animate background { duration: 120ms; }

    Path {
        width: 16px;
        height: 16px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M12 2 L15 9 L22 9.5 L16.5 14 L18.5 21.5 L12 17 L5.5 21.5 L7.5 14 L2 9.5 L9 9 Z";
        fill: root.favorite ? #ffd75e : transparent;
        stroke: root.favorite ? #ffd75e : (ta.has-hover ? #ffd75e : #ffffffcc);
        stroke-width: 1.6px;
    }

    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

// Text chip used in the toolbar (Select / Cancel / Delete / Favorites)
component ScreenshotCard inherits Rectangle {
    in property <ScreenshotItem> item;
    in property <int> index;
    in property <bool> select-mode: false;
    // 0 = idle, 1 = copying, 2 = copied, 3 = failed
    in property <int> copy-state: 0;

    callback toggle-favorite(int);
    callback request-delete(int);
    callback request-rename(int);
    callback request-copy(int);
    callback open-preview(int);
    callback toggle-select(int);

    property <bool> hovered: card-ta.has-hover
        || fav-btn.hovering || copy-btn.hovering || rename-btn.hovering || del-btn.hovering;

    border-radius: 12px;
    border-width: root.item.selected ? 2px : 1px;
    border-color: root.item.selected ? #E8A020 : (root.hovered ? #ffffff30 : Palette.glass-border);
    background: #ffffff08;
    clip: true;
    animate border-color { duration: 120ms; }

    // Thumbnail
    Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height - 44px;
        background: #000000;
        clip: true;

        Image {
            width: 100%;
            height: 100%;
            source: root.item.image;
            image-fit: cover;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        Rectangle {
            width: 100%;
            height: 40px;
            y: parent.height - 40px;
            background: @linear-gradient(180deg, #00000000 0%, #00000066 100%);
        }

        if root.item.selected: Rectangle {
            width: 100%;
            height: 100%;
            background: #E8A02022;
        }

        card-ta := TouchArea {
            clicked => {
                if (root.select-mode) {
                    root.toggle-select(root.index);
                } else {
                    root.open-preview(root.index);
                }
            }
        }

        // Selection checkbox (select mode only)
        if root.select-mode: Rectangle {
            x: 8px;
            y: 8px;
            width: 22px;
            height: 22px;
            border-radius: 11px;
            background: root.item.selected ? #E8A020 : #00000099;
            border-width: 1px;
            border-color: root.item.selected ? #E8A020 : #ffffff60;

            if root.item.selected: Path {
                width: 12px;
                height: 10px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                viewbox-x: 0;
                viewbox-y: 0;
                viewbox-width: 14;
                viewbox-height: 12;
                commands: "M1 6 L5 10 L13 1";
                stroke: #111111;
                stroke-width: 2px;
                fill: transparent;
            }
        }

        // Favorite badge on thumbnails
        if root.item.favorite: Path {
            x: 10px;
            y: parent.height - self.height - 8px;
            width: 14px;
            height: 14px;
            viewbox-x: 0;
            viewbox-y: 0;
            viewbox-width: 24;
            viewbox-height: 24;
            commands: "M12 2 L15 9 L22 9.5 L16.5 14 L18.5 21.5 L12 17 L5.5 21.5 L7.5 14 L2 9.5 L9 9 Z";
            fill: #ffd75e;
        }

        // Hover actions (hidden in select mode)
        HorizontalLayout {
            x: parent.width - self.preferred-width - 8px;
            y: 8px;
            spacing: 6px;
            opacity: ((root.hovered || root.copy-state != 0) && !root.select-mode) ? 1.0 : 0.0;
            animate opacity { duration: 120ms; }

            fav-btn := FavoriteButton {
                favorite: root.item.favorite;
                clicked => { root.toggle-favorite(root.index); }
            }

            copy-btn := CopyButton {
                state: root.copy-state;
                clicked => { root.request-copy(root.index); }
            }

            rename-btn := OverlayButton {
                icon: @image-url("../../../../production/icons/edit.png");
                clicked => { root.request-rename(root.index); }
            }

            del-btn := OverlayButton {
                icon: @image-url("../../../../production/icons/delete.png");
                hover-color: #ee4937;
                clicked => { root.request-delete(root.index); }
            }
        }
    }

    // Footer: filename + date
    Rectangle {
        x: 0;
        y: root.height - 44px;
        width: root.width;
        height: 44px;

        HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            spacing: 8px;
            alignment: space-between;

            VerticalLayout {
                alignment: center;
                Text {
                    text: root.item.file_name;
                    color: Palette.text-primary;
                    font-size: 12px;
                    font-weight: 600;
                    overflow: elide;
                }
            }

            VerticalLayout {
                alignment: center;
                Text {
                    text: root.item.date;
                    color: Palette.text-secondary;
                    font-size: 11px;
                    font-weight: 500;
                }
            }
        }
    }
}

global ScreenshotState {
    in-out property <int> sort-index: 0;
    in-out property <bool> favorites-only: false;
    in-out property <bool> select-mode: false;
}

export component ScreenshotsPage inherits Rectangle {
    callback close-screenshots();
    callback screenshot-favorite(int);
    callback screenshot-delete(int);
    callback screenshot-open(int);
    callback screenshot-copy(int);
    callback screenshot-rename(int, string);
    callback screenshot-toggle-select(int);
    callback screenshot-delete-selected();
    callback screenshot-selection-cleared();
    callback screenshot-sort-changed(int);
    callback screenshot-favorites-filter-changed(bool);
    callback screenshot-preview-requested(int);
    callback screenshots-refresh();
    callback open-screenshots-folder();

    in property <[ScreenshotItem]> screenshots: [];
    in property <int> selected-count: 0;
    in property <image> preview-image;

    in-out property <int> sort-index <=> ScreenshotState.sort-index; // 0 = newest, 1 = oldest, 2 = name
    in-out property <bool> favorites-only <=> ScreenshotState.favorites-only;
    in-out property <bool> select-mode <=> ScreenshotState.select-mode;

    // -1 = no preview open
    in-out property <int> preview-index: -1;
    property <bool> preview-open: root.preview-index >= 0 && root.preview-index < root.screenshots.length;

    // -1 = rename dialog closed
    in-out property <int> renaming-index: -1;

    // 0 = idle, 1 = copying, 2 = copied, 3 = failed
    in-out property <int> copy-state: 0;
    in-out property <int> copy-index: -1;

    init => {
        root.copy-state = 0;
        root.copy-index = -1;
    }

    function start-copy(index: int) {
        root.copy-index = index;
        root.copy-state = 1;
        root.screenshot-copy(index);
    }

    Timer {
        interval: root.copy-state == 3 ? 3000ms : 1200ms;
        running: root.copy-state >= 2;
        triggered => {
            root.copy-state = 0;
            root.copy-index = -1;
        }
    }

    property <int> columns: 3;
    property <length> gap: 16px;

    background: @linear-gradient(180deg, #111115ef 0%, #16161aeb 100%);
    border-radius: 16px;
    border-width: 1px;
    border-color: Palette.glass-border;
    drop-shadow-color: Palette.shadow-color;
    drop-shadow-blur: 25px;
    drop-shadow-offset-y: 10px;
    clip: true;

    function open-preview-at(index: int) {
        root.preview-index = index;
        root.screenshot-preview-requested(index);
    }

    function close-preview() {
        root.preview-index = -1;
    }

    function preview-prev() {
        if (root.preview-index > 0) {
            root.preview-index -= 1;
            root.screenshot-preview-requested(root.preview-index);
        }
    }

    function preview-next() {
        if (root.preview-index < root.screenshots.length - 1) {
            root.preview-index += 1;
            root.screenshot-preview-requested(root.preview-index);
        }
    }

    function exit-select-mode() {
        root.select-mode = false;
        root.screenshot-selection-cleared();
    }

    VerticalLayout {
        padding: 24px;
        spacing: 16px;

        // Header
        HorizontalLayout {
            alignment: space-between;
            height: 32px;

            VerticalLayout {
                alignment: center;
                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;

                    Image {
                        source: @image-url("../../../../production/icons/menu/camera.png");
                        width: 20px;
                        height: 20px;
                        image-rendering: smooth;
                        image-fit: contain;
                        colorize: Palette.text-primary;
                    }

                    Text {
                        text: Tr.values[TrKey.menu-item-screenshots];
                        color: Palette.text-primary;
                        font-size: 17px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        width: count-text.preferred-width + 14px;
                        height: 22px;
                        border-radius: 5px;
                        background: #ffffff14;
                        border-width: 1px;
                        border-color: Palette.glass-border;

                        count-text := Text {
                            x: 7px;
                            y: (parent.height - self.preferred-height) / 2;
                            text: root.screenshots.length + " " + Tr.values[TrKey.screenshots-count-suffix];
                            color: Palette.text-primary;
                            font-size: 11px;
                            font-weight: 600;
                        }
                    }
                }
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: end;

                refresh-btn := Rectangle {
                    width: 30px;
                    height: 30px;
                    border-radius: 6px;
                    background: refresh-ta.has-hover ? #ffffff14 : #ffffff08;
                    border-width: 1px;
                    border-color: #ffffff18;
                    animate background { duration: 120ms; }

                    Image {
                        source: @image-url("../../../../production/icons/refresh.png");
                        width: 15px;
                        height: 15px;
                        image-rendering: smooth;
                        image-fit: contain;
                        colorize: Palette.text-primary;
                        opacity: refresh-ta.has-hover ? 1.0 : 0.8;
                        animate opacity { duration: 120ms; }
                    }

                    refresh-ta := TouchArea {
                        clicked => { root.screenshots-refresh(); }
                    }
                }

                folder-btn := Rectangle {
                    width: folder-inner.preferred-width + 24px;
                    height: 30px;
                    border-radius: 6px;
                    background: folder-ta.has-hover ? #ffffff14 : #ffffff08;
                    border-width: 1px;
                    border-color: #ffffff18;
                    animate background { duration: 120ms; }

                    folder-inner := HorizontalLayout {
                        x: 12px;
                        y: 0;
                        width: self.preferred-width;
                        height: parent.height;
                        spacing: 8px;
                        alignment: start;

                        VerticalLayout {
                            alignment: center;
                            Image {
                                source: @image-url("../../../../production/icons/folder.png");
                                width: 14px;
                                height: 14px;
                                image-rendering: smooth;
                                image-fit: contain;
                                colorize: Palette.text-primary;
                                opacity: 0.9;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: Tr.values[TrKey.screenshots-open-folder];
                                color: Palette.text-primary;
                                font-size: 12px;
                                font-weight: 600;
                            }
                        }
                    }

                    folder-ta := TouchArea {
                        clicked => { root.open-screenshots-folder(); }
                    }
                }

                close-btn := Rectangle {
                    width: 30px;
                    height: 30px;
                    border-radius: 6px;
                    background: close-ta.has-hover ? #ffffff16 : transparent;
                    animate background { duration: 120ms; }

                    Image {
                        source: @image-url("../../../../production/icons/close.png");
                        width: 22px;
                        height: 22px;
                        image-rendering: smooth;
                        image-fit: contain;
                        opacity: close-ta.has-hover ? 1.0 : 0.6;
                        animate opacity { duration: 120ms; }
                    }

                    close-ta := TouchArea {
                        clicked => { root.close-screenshots(); }
                    }
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Palette.glass-border;
        }

        // Toolbar: sort + filter on the left, selection on the right
        HorizontalLayout {
            height: 32px;
            alignment: space-between;

            HorizontalLayout {
                spacing: 8px;
                alignment: start;

                VerticalLayout {
                    alignment: center;
                    Dropdown {
                        options: [
                            Tr.values[TrKey.screenshots-sort-newest],
                            Tr.values[TrKey.screenshots-sort-oldest],
                            Tr.values[TrKey.screenshots-sort-name]
                        ];
                        selected-index <=> root.sort-index;
                        selection-changed(idx) => { root.screenshot-sort-changed(idx); }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    ChipButton {
                        text: "★ " + Tr.values[TrKey.screenshots-favorites];
                        active: root.favorites-only;
                        clicked => {
                            root.favorites-only = !root.favorites-only;
                            root.screenshot-favorites-filter-changed(root.favorites-only);
                        }
                    }
                }
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: end;

                if !root.select-mode: VerticalLayout {
                    alignment: center;
                    ChipButton {
                        text: Tr.values[TrKey.screenshots-select];
                        clicked => { root.select-mode = true; }
                    }
                }

                if root.select-mode: VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        spacing: 8px;
                        ChipButton {
                            text: Tr.values[TrKey.global-button-delete] + " (" + root.selected-count + ")";
                            danger: true;
                            enabled: root.selected-count > 0;
                            clicked => { root.screenshot-delete-selected(); }
                        }

                        ChipButton {
                            text: Tr.values[TrKey.global-popup-cancel-button];
                            clicked => { root.exit-select-mode(); }
                        }
                    }
                }
            }
        }

        // Grid
        grid-area := Rectangle {
            vertical-stretch: 1;
            clip: true;

            if root.screenshots.length == 0: VerticalLayout {
                alignment: center;
                spacing: 12px;
                width: 100%;
                height: 100%;

                Text {
                    text: root.favorites-only
                        ? Tr.values[TrKey.screenshots-empty-favorites-title]
                        : Tr.values[TrKey.screenshots-empty-title];
                    color: Palette.text-primary;
                    font-size: 15px;
                    font-weight: 600;
                    horizontal-alignment: center;
                }

                Text {
                    text: root.favorites-only
                        ? Tr.values[TrKey.screenshots-empty-favorites-subtitle]
                        : Tr.values[TrKey.screenshots-empty-subtitle];
                    color: Palette.text-secondary;
                    font-size: 12px;
                    font-weight: 400;
                    horizontal-alignment: center;
                }
            }

            if root.screenshots.length > 0: grid-scroll := ScrollView {
                width: 100%;
                height: 100%;

                property <length> gutter: 12px;
                property <length> cell-w: Math.floor(((self.width - self.gutter - root.gap * (root.columns - 1)) / root.columns) / 1px) * 1px;
                property <length> cell-h: Math.round((self.cell-w * 9 / 16) / 1px) * 1px + 44px;

                viewport-width: self.width;
                viewport-height: Math.ceil(root.screenshots.length / root.columns) * (self.cell-h + root.gap) - root.gap + 8px;

                for item[i] in root.screenshots: ScreenshotCard {
                    x: Math.mod(i, root.columns) * (grid-scroll.cell-w + root.gap);
                    y: Math.floor(i / root.columns) * (grid-scroll.cell-h + root.gap);
                    width: grid-scroll.cell-w;
                    height: grid-scroll.cell-h;
                    item: item;
                    index: i;
                    select-mode: root.select-mode;
                    toggle-favorite(idx) => { root.screenshot-favorite(idx); }
                    request-delete(idx) => { root.screenshot-delete(idx); }
                    request-rename(idx) => { root.renaming-index = idx; }
                    copy-state: root.copy-index == i ? root.copy-state : 0;
                    request-copy(idx) => { root.start-copy(idx); }
                    toggle-select(idx) => { root.screenshot-toggle-select(idx); }
                    open-preview(idx) => { root.open-preview-at(idx); }
                }
            }
        }
    }

    // Fullscreen preview
    if root.preview-open: Rectangle {
        width: 100%;
        height: 100%;
        background: #000000e6;

        preview-focus := FocusScope {
            width: 100%;
            height: 100%;

            init => { self.focus(); }

            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.close-preview();
                    return accept;
                }
                if (event.text == Key.LeftArrow) {
                    root.preview-prev();
                    return accept;
                }
                if (event.text == Key.RightArrow) {
                    root.preview-next();
                    return accept;
                }
                reject
            }

            TouchArea {
                width: 100%;
                height: 100%;
                clicked => { root.close-preview(); }
            }

            // Image (clicks on it shouldn't close the preview)
            Rectangle {
                x: 60px;
                y: 56px;
                width: parent.width - 120px;
                height: parent.height - 132px;

                TouchArea { }

                Image {
                    width: 100%;
                    height: 100%;
                    source: root.preview-image;
                    image-fit: contain;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // Header: filename + close
            HorizontalLayout {
                x: 16px;
                y: 12px;
                width: parent.width - 32px;
                height: 32px;
                alignment: space-between;

                VerticalLayout {
                    alignment: center;
                    Text {
                        text: root.screenshots[root.preview-index].file_name
                            + "  ·  " + root.screenshots[root.preview-index].date;
                        color: Palette.text-primary;
                        font-size: 13px;
                        font-weight: 600;
                        overflow: elide;
                    }
                }

                OverlayButton {
                    icon: @image-url("../../../../production/icons/close.png");
                    icon-size: 18px;
                    clicked => { root.close-preview(); }
                }
            }

            // Prev / Next
            if root.preview-index > 0: prev-btn := Rectangle {
                x: 12px;
                y: (parent.height - self.height) / 2;
                width: 38px;
                height: 56px;
                border-radius: 8px;
                background: prev-ta.has-hover ? #000000dd : #00000099;
                border-width: 1px;
                border-color: #ffffff20;
                animate background { duration: 120ms; }

                Path {
                    width: 12px;
                    height: 20px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    viewbox-x: 0;
                    viewbox-y: 0;
                    viewbox-width: 12;
                    viewbox-height: 20;
                    commands: "M10 2 L2 10 L10 18";
                    stroke: #ffffffcc;
                    stroke-width: 2px;
                    fill: transparent;
                }

                prev-ta := TouchArea {
                    clicked => { root.preview-prev(); }
                }
            }

            if root.preview-index < root.screenshots.length - 1: next-btn := Rectangle {
                x: parent.width - self.width - 12px;
                y: (parent.height - self.height) / 2;
                width: 38px;
                height: 56px;
                border-radius: 8px;
                background: next-ta.has-hover ? #000000dd : #00000099;
                border-width: 1px;
                border-color: #ffffff20;
                animate background { duration: 120ms; }

                Path {
                    width: 12px;
                    height: 20px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    viewbox-x: 0;
                    viewbox-y: 0;
                    viewbox-width: 12;
                    viewbox-height: 20;
                    commands: "M2 2 L10 10 L2 18";
                    stroke: #ffffffcc;
                    stroke-width: 2px;
                    fill: transparent;
                }

                next-ta := TouchArea {
                    clicked => { root.preview-next(); }
                }
            }

            // Bottom action bar
            HorizontalLayout {
                x: (parent.width - self.preferred-width) / 2;
                y: parent.height - 52px;
                spacing: 8px;

                FavoriteButton {
                    favorite: root.screenshots[root.preview-index].favorite;
                    clicked => { root.screenshot-favorite(root.preview-index); }
                }

                CopyButton {
                    state: root.copy-index == root.preview-index ? root.copy-state : 0;
                    clicked => { root.start-copy(root.preview-index); }
                }

                OverlayButton {
                    icon: @image-url("../../../../production/icons/edit.png");
                    clicked => { root.renaming-index = root.preview-index; }
                }

                OverlayButton {
                    icon: @image-url("../../../../production/icons/link.png");
                    clicked => { root.screenshot-open(root.preview-index); }
                }

                OverlayButton {
                    icon: @image-url("../../../../production/icons/delete.png");
                    hover-color: #ee4937;
                    clicked => {
                        root.screenshot-delete(root.preview-index);
                        root.close-preview();
                    }
                }
            }
        }
    }

    // Rename dialog
    if root.renaming-index >= 0 && root.renaming-index < root.screenshots.length: Rectangle {
        width: 100%;
        height: 100%;
        background: #000000aa;

        TouchArea {
            clicked => { root.renaming-index = -1; }
        }

        Rectangle {
            width: 360px;
            height: rename-layout.preferred-height;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: #1e1e24;
            border-radius: 12px;
            border-width: 1px;
            border-color: Palette.glass-border;
            drop-shadow-color: #00000099;
            drop-shadow-blur: 30px;

            TouchArea { }

            rename-layout := VerticalLayout {
                padding: 20px;
                spacing: 14px;

                Text {
                    text: Tr.values[TrKey.screenshots-rename-title];
                    color: Palette.text-primary;
                    font-size: 15px;
                    font-weight: 700;
                }

                rename-input := LineEdit {
                    height: 34px;
                    font-size: 13px;
                    init => {
                        self.text = root.screenshots[root.renaming-index].file_name;
                        self.focus();
                    }
                    accepted => {
                        root.screenshot-rename(root.renaming-index, self.text);
                        root.renaming-index = -1;
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;

                    ChipButton {
                        text: Tr.values[TrKey.global-popup-cancel-button];
                        clicked => { root.renaming-index = -1; }
                    }

                    ChipButton {
                        text: Tr.values[TrKey.global-button-rename];
                        active: true;
                        clicked => {
                            root.screenshot-rename(root.renaming-index, rename-input.text);
                            root.renaming-index = -1;
                        }
                    }
                }
            }
        }
    }

    // Copy toast
    copy-toast := Rectangle {
        property <bool> shown: root.copy-state != 0;
        property <bool> blink: false;

        width: toast-row.preferred-width + 32px;
        height: 38px;
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height - (self.shown ? 24px : 4px);
        opacity: self.shown ? 1.0 : 0.0;
        visible: self.opacity > 0.001;

        border-radius: 19px;
        background: root.copy-state == 3 ? #ef4444ee : #1e1e24f2;
        border-width: 1px;
        border-color: root.copy-state == 2
            ? #22c55e66
            : (root.copy-state == 3 ? #ffffff44 : Palette.glass-border);
        drop-shadow-color: #00000099;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 6px;

        animate y { duration: 220ms; easing: ease-out-quad; }
        animate opacity { duration: 180ms; easing: ease-in-out; }
        animate background, border-color { duration: 160ms; }

        Timer {
            interval: 350ms;
            running: root.copy-state == 1;
            triggered => { copy-toast.blink = !copy-toast.blink; }
        }

        toast-row := HorizontalLayout {
            x: 16px;
            y: 0;
            width: self.preferred-width;
            height: parent.height;
            spacing: 9px;

            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 16px;
                    height: 16px;

                    if root.copy-state == 1: Rectangle {
                        width: 9px;
                        height: 9px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        border-radius: 4.5px;
                        background: #ffffff;
                        opacity: copy-toast.blink ? 0.25 : 1.0;
                        animate opacity { duration: 350ms; easing: ease-in-out; }
                    }

                    if root.copy-state == 2: Path {
                        width: 16px;
                        height: 13px;
                        y: (parent.height - self.height) / 2;
                        viewbox-x: 0;
                        viewbox-y: 0;
                        viewbox-width: 15;
                        viewbox-height: 12;
                        commands: "M1 6 L5.5 10.5 L14 1.5";
                        stroke: #22c55e;
                        stroke-width: 2px;
                        fill: transparent;
                    }

                    if root.copy-state == 3: Path {
                        width: 14px;
                        height: 14px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        viewbox-x: 0;
                        viewbox-y: 0;
                        viewbox-width: 14;
                        viewbox-height: 14;
                        commands: "M2 2 L12 12 M12 2 L2 12";
                        stroke: #ffffff;
                        stroke-width: 2px;
                        fill: transparent;
                    }
                }
            }

            VerticalLayout {
                alignment: center;
                Text {
                    text: root.copy-state == 1 ? Tr.values[TrKey.screenshots-copying]
                        : (root.copy-state == 3 ? Tr.values[TrKey.screenshots-copy-failed]
                        : Tr.values[TrKey.screenshots-copied]);
                    color: Palette.text-primary;
                    font-size: 12px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
            }
        }
    }
}
