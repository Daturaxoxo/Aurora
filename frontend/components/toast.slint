import { Icons } from "../icons.slint";
import { Palette } from "../global.slint";

export component WindowToast inherits Rectangle {
    in property <bool> active;
    in property <string> text;
    in property <string> kind: "success";
    in property <duration> timeout: 4000ms;
    private property <float> progress: 1.0;
    private property <bool> showing: false;
    private property <bool> arm-fade-in: false;
    callback close();

    opacity: 0.0;
    visible: self.opacity > 0.001;

    animate opacity {
        duration: 200ms;
        easing: ease-in-out;
    }

    states [
        visible when root.showing: {
            opacity: 1.0;
        }
    ]

    changed active => {
        if (root.active) {
            root.showing = false;
            root.progress = 1.0;
            root.arm-fade-in = true;
        } else {
            root.arm-fade-in = false;
            root.showing = false;
        }
    }

    Timer {
        interval: 16ms;
        running: root.arm-fade-in;
        triggered => {
            root.arm-fade-in = false;
            root.showing = true;
        }
    }

    Timer {
        interval: 16ms;
        running: root.active;
        triggered => {
            root.progress -= 0.016 / (root.timeout / 1000ms);
            if (root.progress <= 0.0) {
                root.progress = 0.0;
                root.close();
            }
        }
    }

    width: 340px;
    height: self.preferred-height;

    background: Palette.glass-background;
    border-color: Palette.glass-border;
    border-width: 1px;
    border-radius: 8px;
    clip: true;

    drop-shadow-color: Palette.shadow-color;
    drop-shadow-blur: 16px;
    drop-shadow-offset-y: 6px;

    property <color> drain-color:
        root.kind == "success" ? Palette.success :
        (root.kind == "error" ? Palette.danger :
        (root.kind == "warning" ? Palette.warning : Palette.accent-strong));
    property <image> status-icon:
        root.kind == "success" ? Icons.success :
        (root.kind == "error" || root.kind == "warning" ? Icons.error :
        Icons.info);
    property <brush> status-icon-tint: root.kind == "warning" ? Palette.warning : transparent;

    VerticalLayout {
        HorizontalLayout {
            padding: 14px;
            spacing: 14px;
            alignment: space-between;

            HorizontalLayout {
                spacing: 12px;
                horizontal-stretch: 1;

                VerticalLayout {
                    alignment: center;
                    Image {
                        source: root.status-icon;
                        colorize: root.status-icon-tint;
                        width: 22px;
                        height: 22px;
                        image-fit: contain;
                    }
                    // Removed the leftover red placeholder rectangle -datura
                }

                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;

                    Text {
                        text: root.text;
                        color: Palette.text-primary;
                        font-size: 13px;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                    }
                }
            }

            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 20px;
                    height: 20px;
                    border-radius: 4px;
                    background: ta.has-hover ? Palette.fg-14 : transparent;
                    animate background { duration: 100ms; }
                    Image {
                        source: Icons.close;
                        width: 16px;
                        height: 16px;
                        opacity: ta.has-hover ? 1.0 : 0.7;
                        animate opacity { duration: 100ms; }
                    }

                    ta := TouchArea {
                        clicked => { root.close(); }
                    }
                }
            }
        }

        Rectangle {
            height: 2px;
            background: Palette.fg-0d;

            Rectangle {
                x: 0px;
                y: 0px;
                width: parent.width * root.progress;
                height: 100%;
                background: root.drain-color;
            }
        }
    }
}
