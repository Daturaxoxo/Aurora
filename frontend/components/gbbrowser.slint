import { Palette } from "../global.slint";
import { ScrollView } from "std-widgets.slint";
import { ToggleSwitch } from "modcard.slint";
import { ImageLightbox } from "lightbox.slint";
import { Tr, TrKey } from "../translations.slint";

export struct GbModItem {
    id: int,
    name: string,
    author: string,
    thumbnail: image,
    has-thumbnail: bool,
    likes: int,
    views: int,
    downloads: string,
}

export struct GbFileItem {
    name: string,
    size: string,
    downloads: int,
}

export struct GbCharacter {
    name: string,
    icon: image,
}

component StatIcon inherits HorizontalLayout {
    in property <string> commands;
    in property <string> label;
    in property <bool> filled: false;

    spacing: 4px;
    alignment: start;

    VerticalLayout {
        alignment: center;
        Path {
            width: 11px;
            height: 11px;
            viewbox-x: 0;
            viewbox-y: 0;
            viewbox-width: 14;
            viewbox-height: 14;
            commands: root.commands;
            stroke: #ffffff66;
            stroke-width: 1.4px;
            fill: root.filled ? #ffffff66 : transparent;
        }
    }

    Text {
        text: root.label;
        color: #ffffff77;
        font-size: 10.5px;
        font-weight: 600;
        vertical-alignment: center;
    }
}

component GbModCard inherits Rectangle {
    in property <GbModItem> item;

    callback install(int /* id */);
    callback open-page(int /* id */);
    callback preview(int /* id */);

    border-radius: 10px;
    border-width: 1px;
    border-color: card-ta.has-hover ? #ffffff22 : #ffffff10;
    background: card-ta.has-hover ? #ffffff0a : #ffffff06;
    clip: true;
    animate background { duration: 120ms; }
    animate border-color { duration: 120ms; }

    card-ta := TouchArea { }

    VerticalLayout {
        spacing: 0px;

        thumb := Rectangle {
            vertical-stretch: 1;
            background: #00000044;
            clip: true;

            if root.item.has-thumbnail: Image {
                width: 100%;
                height: 100%;
                source: root.item.thumbnail;
                image-fit: cover;
                image-rendering: smooth;
            }

            if !root.item.has-thumbnail: Image {
                width: 32px;
                height: 32px;
                source: @image-url("../../production/icons/gamebanana.png");
                image-fit: contain;
                image-rendering: smooth;
                colorize: #ffffff22;
            }

            thumb-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.preview(root.item.id); }
            }

            if thumb-ta.has-hover: Rectangle {
                background: #ffffff0a;
            }
        }

        Rectangle {
            height: 100px;
            background: transparent;

            VerticalLayout {
                padding: 10px;
                padding-bottom: 14px;
                spacing: 4px;

                Text {
                    text: root.item.name;
                    color: Palette.text-primary;
                    font-size: 12.5px;
                    font-weight: 700;
                    overflow: elide;
                }

                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;

                    Text {
                        text: Tr.values[TrKey.global-label-by] + " " + root.item.author;
                        color: Palette.text-secondary;
                        font-size: 10.5px;
                        overflow: elide;
                    }
                }

                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;

                    // Likes
                    StatIcon {
                        commands: "M7 12 L2.5 7.5 Q0.5 5.5 2.5 3.5 Q4.5 1.5 6.5 3.5 L7 4 L7.5 3.5 Q9.5 1.5 11.5 3.5 Q13.5 5.5 11.5 7.5 Z";
                        label: root.item.likes;
                        filled: true;
                    }

                    // Views
                    StatIcon {
                        commands: "M1 7 Q7 1.5 13 7 Q7 12.5 1 7 Z M7 5 Q9 5 9 7 Q9 9 7 9 Q5 9 5 7 Q5 5 7 5 Z";
                        label: root.item.views;
                    }

                    // Downloads (hidden when browsing by category)
                    if root.item.downloads != "": StatIcon {
                        commands: "M7 1 L7 9 M3.5 5.5 L7 9 L10.5 5.5 M1.5 12.5 L12.5 12.5";
                        label: root.item.downloads;
                    }
                }

                HorizontalLayout {
                    spacing: 6px;

                    install-btn := Rectangle {
                        width: 92px;
                        height: 26px;
                        border-radius: 6px;
                        background: install-ta.has-hover ? #34d399 : #10b981;
                        animate background { duration: 100ms; }

                        Text {
                            text: Tr.values[TrKey.global-button-install];
                            color: #ffffff;
                            font-size: 11.5px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        install-ta := TouchArea {
                            clicked => { root.install(root.item.id); }
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                    }

                    page-btn := Rectangle {
                        width: 26px;
                        height: 26px;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: page-ta.has-hover ? #ffffff28 : #ffffff16;
                        background: page-ta.has-hover ? #ffffff12 : #ffffff08;
                        animate background { duration: 100ms; }
                        animate border-color { duration: 100ms; }

                        Image {
                            source: @image-url("../../production/icons/gamebanana.png");
                            width: 13px;
                            height: 13px;
                            image-rendering: smooth;
                            image-fit: contain;
                            colorize: page-ta.has-hover ? #ffffffdd : #ffffff88;
                            animate colorize { duration: 100ms; }
                        }

                        page-ta := TouchArea {
                            clicked => { root.open-page(root.item.id); }
                        }
                    }
                }
            }
        }
    }
}

component CharacterDropdown inherits Rectangle {
    in property <[GbCharacter]> characters: [];
    in-out property <int> selected: -1;

    callback selection-changed(int /* index, -1 = cleared */);

    width: 150px;
    height: 26px;
    border-radius: 6px;
    border-width: 1px;
    border-color: root.selected >= 0
        ? #E8A020
        : (trigger-ta.has-hover ? #ffffff28 : #ffffff16);
    background: root.selected >= 0
        ? #E8A02022
        : (trigger-ta.has-hover ? #ffffff12 : #ffffff08);
    animate background { duration: 100ms; }
    animate border-color { duration: 100ms; }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 6px;

        if root.selected >= 0: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 16px;
                height: 16px;
                border-radius: 8px;
                background: #00000044;
                clip: true;

                Image {
                    source: root.characters[root.selected].icon;
                    width: 100%;
                    height: 100%;
                    image-fit: contain;
                    image-rendering: smooth;
                }
            }
        }

        Text {
            horizontal-stretch: 1;
            text: root.selected >= 0
                ? root.characters[root.selected].name
                : Tr.values[TrKey.gb-all-characters];
            color: root.selected >= 0 ? #ffd280 : #ffffffcc;
            font-size: 11.5px;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
        }

        VerticalLayout {
            alignment: center;
            Path {
                width: 10px;
                height: 6px;
                viewbox-x: 0;
                viewbox-y: 0;
                viewbox-width: 10;
                viewbox-height: 6;
                commands: "M1 1 L5 5 L9 1";
                stroke: #ffffff88;
                stroke-width: 1.5px;
                fill: transparent;
            }
        }
    }

    trigger-ta := TouchArea {
        clicked => { popup.show(); }
    }

    popup := PopupWindow {
        x: 0px;
        y: parent.height + 6px;
        width: 160px;
        height: 280px;
        close-policy: close-on-click-outside;

        Rectangle {
            width: 100%;
            height: 100%;
            background: #1e1e24;
            border-radius: 8px;
            border-width: 1px;
            border-color: #3f3f46;

            list-scroll := ScrollView {
                x: 6px;
                y: 6px;
                width: parent.width - 12px;
                height: parent.height - 12px;
                viewport-height: list-col.preferred-height;

                list-col := VerticalLayout {
                    spacing: 2px;

                    // Clears the filter
                    Rectangle {
                        height: 30px;
                        border-radius: 4px;
                        background: all-ta.has-hover ? #ffffff10 : transparent;

                        all-ta := TouchArea {
                            clicked => {
                                root.selected = -1;
                                root.selection-changed(-1);
                                popup.close();
                            }
                        }

                        Text {
                            x: 8px;
                            text: Tr.values[TrKey.gb-all-characters];
                            color: Palette.text-primary;
                            font-size: 12px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }

                    for char[i] in root.characters: Rectangle {
                        height: 30px;
                        border-radius: 4px;
                        background: root.selected == i
                            ? #E8A02022
                            : (option-ta.has-hover ? #ffffff10 : transparent);

                        option-ta := TouchArea {
                            clicked => {
                                root.selected = i;
                                root.selection-changed(i);
                                popup.close();
                            }
                        }

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 8px;

                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 18px;
                                    height: 18px;
                                    border-radius: 9px;
                                    background: #00000044;
                                    clip: true;

                                    Image {
                                        source: char.icon;
                                        width: 100%;
                                        height: 100%;
                                        image-fit: contain;
                                        image-rendering: smooth;
                                    }
                                }
                            }

                            Text {
                                horizontal-stretch: 1;
                                text: char.name;
                                color: root.selected == i ? #ffd280 : Palette.text-primary;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }
    }
}

export component GameBananaBrowser inherits Rectangle {
    in property <[GbModItem]> mods: [];
    in property <bool> loading: false;
    in-out property <bool> show-nsfw: false;
    in-out property <int> selected-character: -1;
    in-out property <string> search-text: "";
    in property <[GbFileItem]> files: [];
    in-out property <bool> files-visible: false;
    in property <string> files-mod-name: "";
    in-out property <bool> preview-visible: false;
    in property <image> preview-image;
    in property <bool> preview-loading: false;
    in property <int> preview-index: 0;
    in property <int> preview-count: 0;
    in property <string> preview-name: "";

    callback close();
    callback search-changed(string);
    callback character-selected(int /* index, -1 = cleared */);
    callback nsfw-toggled(bool);
    callback clear-cache();
    callback load-more();
    callback install(int /* id */);
    callback open-page(int /* id */);
    callback file-chosen(int /* index */);
    callback preview-requested(int /* id */);
    callback preview-nav(int /* new index */);
    callback preview-closed();
    callback visible-range(int /* first index */, int /* last index */);

    // Built in gbbrowser.rs so the names and their icons stay in one place.
    in property <[GbCharacter]> characters: [];

    background: @linear-gradient(180deg, #111115ef 0%, #16161aeb 100%);
    border-radius: 16px;
    border-width: 1px;
    border-color: Palette.glass-border;
    drop-shadow-color: Palette.shadow-color;
    drop-shadow-blur: 25px;
    drop-shadow-offset-y: 10px;

    changed loading => {
        if (!self.loading) {
            grid-scroll.maybe-load-more();
        }
    }

    search-debounce := Timer {
        interval: 500ms;
        running: false;
        triggered => {
            self.running = false;
            root.search-changed(root.search-text);
        }
    }

    VerticalLayout {
        spacing: 0px;

        Rectangle {
            height: 60px;
            width: 100%;

            HorizontalLayout {
                x: 20px;
                y: 0px;
                width: parent.width - 40px;
                height: parent.height;
                spacing: 12px;

                VerticalLayout {
                    alignment: center;
                    width: self.preferred-width;
                    Image {
                        source: @image-url("../../production/icons/gamebanana.png");
                        width: 18px;
                        height: 18px;
                        image-rendering: smooth;
                        image-fit: contain;
                    }
                }

                VerticalLayout {
                    alignment: center;
                    width: self.preferred-width;
                    Text {
                        text: Tr.values[TrKey.gb-title];
                        color: Palette.text-primary;
                        font-size: 17px;
                        font-weight: 700;
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                }

                VerticalLayout {
                    alignment: center;
                    width: self.preferred-width;
                    Text {
                        text: Tr.values[TrKey.gb-nsfw];
                        color: #ffffff88;
                        font-size: 12px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }

                VerticalLayout {
                    alignment: center;
                    ToggleSwitch {
                        checked <=> root.show-nsfw;
                        toggled => { root.nsfw-toggled(root.show-nsfw); }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    width: self.preferred-width;
                    clear-cache-rect := Rectangle {
                        width: clear-cache-label.preferred-width + 20px;
                        height: 28px;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: clear-cache-ta.has-hover ? #ffffff28 : #ffffff16;
                        background: clear-cache-ta.has-hover ? #ffffff12 : #ffffff08;
                        animate background { duration: 100ms; }
                        animate border-color { duration: 100ms; }

                        clear-cache-label := Text {
                            text: Tr.values[TrKey.gb-clear-cache];
                            color: clear-cache-ta.has-hover ? #ffffffdd : #ffffffcc;
                            font-size: 11.5px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            animate color { duration: 100ms; }
                        }

                        clear-cache-ta := TouchArea {
                            clicked => { root.clear-cache(); }
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 1px;
                        height: 20px;
                        background: Palette.glass-border;
                    }
                }

                VerticalLayout {
                    alignment: center;
                    width: self.preferred-width;
                    close-rect := Rectangle {
                        width: 28px;
                        height: 28px;
                        border-radius: 6px;
                        background: close-ta.has-hover ? #ffffff14 : transparent;
                        animate background { duration: 100ms; }

                        Path {
                            x: 7px;
                            y: 7px;
                            width: 14px;
                            height: 14px;
                            viewbox-x: 0;
                            viewbox-y: 0;
                            viewbox-width: 14;
                            viewbox-height: 14;
                            commands: "M1 1 L13 13 M13 1 L1 13";
                            stroke: close-ta.has-hover ? #ffffffdd : #ffffff66;
                            stroke-width: 1.8px;
                            fill: transparent;
                            animate stroke { duration: 100ms; }
                        }

                        close-ta := TouchArea {
                            clicked => { root.close(); }
                        }
                    }
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Palette.glass-border;
        }

        Rectangle {
            height: 48px;
            width: 100%;
            background: #ffffff02;

            HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;

                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    search-container := Rectangle {
                        height: 32px;
                        background: #ffffff08;
                        border-radius: 7px;
                        border-width: 1px;
                        border-color: #ffffff16;

                        Image {
                            source: @image-url("../../production/icons/search.png");
                            x: 10px;
                            y: (parent.height - self.height) / 2;
                            width: 14px;
                            height: 14px;
                            image-rendering: smooth;
                            image-fit: contain;
                            colorize: #ffffff66;
                        }

                        TextInput {
                            x: 32px;
                            width: char-dd.x - 40px;
                            text <=> root.search-text;
                            font-size: 13px;
                            color: Palette.text-primary;
                            vertical-alignment: center;
                            single-line: true;
                            edited => {
                                root.selected-character = -1;
                                search-debounce.running = false;
                                search-debounce.running = true;
                            }
                        }

                        if (root.search-text == ""): Text {
                            x: 32px;
                            text: Tr.values[TrKey.global-search-mods-placeholder];
                            color: #ffffff44;
                            font-size: 13px;
                            vertical-alignment: center;
                        }

                        char-dd := CharacterDropdown {
                            x: parent.width - self.width - 3px;
                            y: (parent.height - self.height) / 2;
                            characters: root.characters;
                            selected <=> root.selected-character;
                            selection-changed(i) => {
                                root.search-text = "";
                                search-debounce.running = false;
                                root.character-selected(i);
                            }
                        }
                    }
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Palette.glass-border;
        }

        Rectangle {
            vertical-stretch: 1;
            background: transparent;

            grid-scroll := ScrollView {
                width: 100%;
                height: 100%;

                property <length> gap: 14px;
                property <int> columns: max(2, floor((self.width - 40px) / 250px));
                // Rounded to whole pixels so cards (and their text) don't
                // land on fractional positions and render blurry
                property <length> cell-w: Math.floor(((self.width - 40px - self.gap * (self.columns - 1)) / self.columns) / 1px) * 1px;
                property <length> cell-h: Math.round((self.cell-w * 9 / 16) / 1px) * 1px + 100px;

                viewport-width: self.width;
                viewport-height: Math.ceil(root.mods.length / self.columns)
                    * (self.cell-h + self.gap) - self.gap + 32px;

                // Fetch the next page when scrolled near the bottom, or when
                // the loaded mods don't fill the view at all
                function maybe-load-more() {
                    if (-self.viewport-y + self.height > self.viewport-height - 300px) {
                        root.load-more();
                    }
                }

                property <int> first-visible-row: max(0, Math.floor(
                    (-self.viewport-y - 16px) / (self.cell-h + self.gap)));
                property <int> last-visible-row: Math.floor(
                    (-self.viewport-y + self.height - 16px) / (self.cell-h + self.gap));

                function report-visible-range() {
                    if (root.mods.length == 0 || self.columns <= 0) {
                        return;
                    }
                    root.visible-range(
                        self.first-visible-row * self.columns,
                        min(self.last-visible-row * self.columns + self.columns - 1,
                            root.mods.length - 1)
                    );
                }

                changed viewport-y => { self.maybe-load-more(); self.report-visible-range(); }
                changed viewport-height => { self.maybe-load-more(); self.report-visible-range(); }

                for item[i] in root.mods: GbModCard {
                    x: 20px + Math.mod(i, grid-scroll.columns) * (grid-scroll.cell-w + grid-scroll.gap);
                    y: 16px + Math.floor(i / grid-scroll.columns) * (grid-scroll.cell-h + grid-scroll.gap);
                    width: grid-scroll.cell-w;
                    height: grid-scroll.cell-h;
                    item: item;
                    install(id) => { root.install(id); }
                    open-page(id) => { root.open-page(id); }
                    preview(id) => { root.preview-requested(id); }
                }
            }

            if root.mods.length == 0 && !root.loading: Text {
                text: Tr.values[TrKey.gb-no-mods];
                color: #ffffff44;
                font-size: 13px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            if root.loading: Rectangle {
                y: parent.height - 40px;
                width: 100%;
                height: 40px;
                background: transparent;

                Text {
                    text: Tr.values[TrKey.gb-loading];
                    color: #ffffff77;
                    font-size: 12px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }

    if root.files-visible: Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 16px;
        background: #000000aa;

        TouchArea { }

        // Absorbs mouse-wheel scrolls
        ScrollView {
            width: 100%;
            height: 100%;
            viewport-width: self.width;
            viewport-height: self.height + 1px;
        }

        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                alignment: center;

                Rectangle {
                    width: 460px;
                    background: Palette.glass-background;
                    border-color: Palette.glass-border;
                    border-width: 1px;
                    border-radius: 12px;
                    drop-shadow-color: Palette.shadow-color;
                    drop-shadow-blur: 24px;
                    drop-shadow-offset-y: 8px;

                    VerticalLayout {
                        padding: 24px;
                        spacing: 14px;

                        Text {
                            text: Tr.values[TrKey.gb-files-title];
                            font-size: 16px;
                            font-weight: 700;
                            color: Palette.text-primary;
                        }

                        Text {
                            text: root.files-mod-name;
                            font-size: 12.5px;
                            color: Palette.text-secondary;
                            overflow: elide;
                        }

                        VerticalLayout {
                            spacing: 6px;

                            for file[i] in root.files: Rectangle {
                                height: 48px;
                                border-radius: 8px;
                                border-width: 1px;
                                border-color: file-ta.has-hover ? #ffffff28 : #ffffff14;
                                background: file-ta.has-hover ? #ffffff10 : #ffffff06;
                                animate background { duration: 100ms; }
                                animate border-color { duration: 100ms; }

                                file-ta := TouchArea {
                                    clicked => { root.file-chosen(i); }
                                }

                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    spacing: 10px;

                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 2px;
                                        horizontal-stretch: 1;

                                        Text {
                                            text: file.name;
                                            color: Palette.text-primary;
                                            font-size: 12.5px;
                                            font-weight: 600;
                                            overflow: elide;
                                        }

                                        Text {
                                            text: file.size + "  •  " + file.downloads + " " + Tr.values[TrKey.gb-files-downloads-suffix];
                                            color: Palette.text-secondary;
                                            font-size: 10.5px;
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        width: self.preferred-width;
                                        Path {
                                            width: 13px;
                                            height: 13px;
                                            viewbox-x: 0;
                                            viewbox-y: 0;
                                            viewbox-width: 14;
                                            viewbox-height: 14;
                                            commands: "M7 1 L7 9 M3.5 5.5 L7 9 L10.5 5.5 M1.5 12.5 L12.5 12.5";
                                            stroke: file-ta.has-hover ? #ffffffdd : #ffffff66;
                                            stroke-width: 1.6px;
                                            fill: transparent;
                                        }
                                    }
                                }
                            }
                        }

                        HorizontalLayout {
                            alignment: end;

                            Rectangle {
                                width: 100px;
                                height: 34px;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: Palette.glass-border;
                                background: cancel-ta.has-hover ? #ffffff10 : transparent;
                                animate background { duration: 100ms; }

                                Text {
                                    text: Tr.values[TrKey.global-popup-cancel-button];
                                    color: Palette.text-secondary;
                                    font-size: 13px;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                cancel-ta := TouchArea {
                                    clicked => { root.files-visible = false; }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    if root.preview-visible: ImageLightbox {
        source: root.preview-image;
        caption: root.preview-name;
        sub-caption: root.preview-loading
            ? Tr.values[TrKey.gb-preview-loading]
            : (root.preview-count > 1
            ? (root.preview-index + 1) + " / " + root.preview-count
            : "");
        has-previous: root.preview-count > 1 && root.preview-index > 0;
        has-next: root.preview-count > 1 && root.preview-index < root.preview-count - 1;
        closed => { root.preview-visible = false; root.preview-closed(); }
        previous => { root.preview-nav(root.preview-index - 1); }
        next => { root.preview-nav(root.preview-index + 1); }
    }
}
