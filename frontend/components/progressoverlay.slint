import { Palette } from "../global.slint";

export component ProgressOverlay inherits Rectangle {
    in property <bool> active;
    in property <string> title;
    in property <float> progress;
    in property <string> status-text;
    in property <bool> cancellable: false;

    callback cancel();

    width: 100%;
    height: 100%;

    background: root.active ? #000000aa : transparent;
    animate background { duration: 150ms; }

    visible: root.active || card.opacity > 0.01;

    // Swallows every click/hover so nothing behind is interactable.
    TouchArea { }

    VerticalLayout {
        alignment: center;
        HorizontalLayout {
            alignment: center;

            card := Rectangle {
                width: 380px;
                background: Palette.glass-background;
                border-color: Palette.glass-border;
                border-width: 1px;
                border-radius: 12px;
                drop-shadow-color: Palette.shadow-color;
                drop-shadow-blur: 24px;
                drop-shadow-offset-y: 8px;

                opacity: root.active ? 1.0 : 0.0;
                animate opacity {
                    duration: 150ms;
                    easing: ease-in-out;
                }

                VerticalLayout {
                    padding: 24px;
                    spacing: 14px;

                    Text {
                        text: root.title;
                        font-size: 18px;
                        font-weight: 700;
                        color: Palette.text-primary;
                    }

                    Text {
                        text: root.status-text;
                        font-size: 13px;
                        color: Palette.text-secondary;
                        wrap: word-wrap;
                    }

                    // Progress bar
                    Rectangle {
                        height: 8px;
                        border-radius: 4px;
                        background: #ffffff14;
                        clip: true;

                        Rectangle {
                            x: 0;
                            width: parent.width * Math.clamp(root.progress, 0.0, 1.0);
                            height: parent.height;
                            border-radius: 4px;
                            background: #ffffff;
                            animate width { duration: 120ms; }
                        }
                    }

                    Text {
                        text: Math.round(Math.clamp(root.progress, 0.0, 1.0) * 100) + "%";
                        font-size: 12px;
                        color: Palette.text-secondary;
                        horizontal-alignment: right;
                    }

                    if root.cancellable: HorizontalLayout {
                        alignment: end;

                        Rectangle {
                            width: 100px;
                            height: 34px;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: Palette.glass-border;
                            background: cancel-ta.has-hover ? #ffffff10 : transparent;
                            animate background { duration: 100ms; }

                            Text {
                                text: "Cancel";
                                color: Palette.text-secondary;
                                font-size: 13px;
                                font-family: "Segoe UI";
                                font-weight: 600;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            cancel-ta := TouchArea {
                                clicked => { root.cancel(); }
                            }
                        }
                    }
                }
            }
        }
    }
}
